---
import type { ProductDetailModel, ProductPurchaseModel } from '../../features/storefront/models';
import ProductCard from './ProductCard.astro';
import ProductGallery from '../../features/storefront/controls/ProductGallery.astro';
import ProductPurchaseForm from '../../features/storefront/controls/ProductPurchaseForm.astro';

/**
 * STORE-OWNED. Edit freely — this file belongs to your store.
 *
 * Composition only. Every price, URL, availability flag, and image on `model`
 * is already resolved; the route owns the 404, the metadata, and the JSON-LD.
 *
 * Keep <ProductGallery> and <ProductPurchaseForm>. The gallery owns the anchors
 * the variant selector scrolls to and the LCP treatment on the first frame; the
 * purchase form owns the field names, the sold-out states, and `data-fullpage`,
 * without which Buy now is captured by the cart drawer instead of navigating.
 *
 * See CUSTOMIZING.md for the full contract.
 */
interface Props {
  model: ProductDetailModel;
  purchase: ProductPurchaseModel;
}

const { model, purchase } = Astro.props;
---

<a href={model.backHref} class="text-sm font-medium text-faint hover:text-brand">
  &larr; Volver al catálogo
</a>

{
  model.error && (
    <p class="mt-4 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
      {model.error}
    </p>
  )
}


<div class="mt-6 grid gap-10 md:grid-cols-2 md:gap-16">
  <ProductGallery
    images={model.images}
    hero={model.heroImage}
    soldOut={model.soldOut}
    class="reveal"
  />

  <div class="reveal flex flex-col" style="animation-delay:90ms">
    {
      model.categories.length > 0 && (
        <div class="mb-4 flex flex-wrap gap-2">
          {model.categories.map((category) => (
            <a href={category.href} class="etiqueta hover:bg-brand hover:text-on-brand">
              {category.text}
            </a>
          ))}
        </div>
      )
    }

    <h1 class="font-serif text-3xl font-bold leading-tight text-ink sm:text-4xl">{model.name}</h1>
    {model.digitalDelivery && <p class="mt-2 text-sm font-medium text-brand">Entrega digital · sin envíos</p>}
    <p
      class="mt-4 w-fit rounded-full bg-brand px-5 py-2 text-xl font-semibold tabular-nums text-on-brand"
      data-price-display
      data-base={model.priceCents}
      data-currency={model.currency}
    >
      {model.priceVaries && <span class="text-base font-medium opacity-80">desde </span>}
      {model.formattedPrice}
    </p>

    {/* Pruébalo antes de pagar: CTA principal. El pago directo queda como secundario. */}
    <div class="mt-6 rounded-2xl border-2 border-brand bg-brand/5 p-5" data-empieza-gratis>
      <p class="text-xs font-semibold uppercase tracking-widest text-brand">Sin tarjeta · sin compromiso</p>
      <p class="mt-1 text-lg font-bold text-ink">Pruébalo antes de pagar</p>
      <ol class="relative mt-4 space-y-3 border-l-2 border-dashed border-brand/30 pl-5 text-sm">
        {[
          ['1', 'Solicitas', 'Rellenas tus datos en 2-3 minutos. Sin tarjeta.'],
          ['2', 'Recibes la vista previa', 'Con tu información real, en 24-72 h laborables.'],
          ['3', 'Decides si pagas', 'Si te gusta, pagas y lo recibes funcionando. Si no, no pagas nada.'],
        ].map(([n, t, d]) => (
          <li class="relative">
            <span class="absolute -left-[31px] top-0 grid h-5 w-5 place-items-center rounded-full bg-brand text-[11px] font-bold text-on-brand">{n}</span>
            <span class="block font-semibold text-ink">{t}</span>
            <span class="block text-muted">{d}</span>
          </li>
        ))}
      </ol>
      <a
        href={model.startHref}
        class="mt-4 flex w-full items-center justify-center rounded-full bg-brand px-6 py-3.5 text-base font-semibold text-on-brand shadow-sm transition hover:bg-brand-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
      >
        Empieza gratis →
      </a>
      <p class="mt-3 text-center text-xs text-faint">Te atiende una persona: David Porto Díaz revisa cada solicitud y responde tus dudas.</p>
    </div>

    {/* Qué recibes / qué necesito / qué pasa después: decisión sin sorpresas. */}
    <dl class="mt-6 grid gap-3 sm:grid-cols-3" data-decision>
      {[
        ['Qué recibes', 'Exactamente lo que describe esta ficha, con tus datos y tu marca. Precio cerrado.', 'M5 12l5 5l10 -10'],
        ['Qué necesito de ti', 'Los datos del formulario: textos, contacto y, si quieres, fotos o logo.', 'M4 20h4l10.5 -10.5a2.8 2.8 0 1 0 -4 -4l-10.5 10.5v4'],
        ['Qué pasa después', 'Te escribimos con la vista previa. Ajustes incluidos antes de entregar.', 'M3 7l9 6l9 -6M3 7v10h18v-10'],
      ].map(([t, d, path]) => (
        <div class="rounded-xl border border-line bg-surface p-4">
          <dt class="flex items-center gap-2 text-sm font-semibold text-ink">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-brand" aria-hidden="true"><path d={path} /></svg>
            {t}
          </dt>
          <dd class="mt-1.5 text-xs leading-relaxed text-muted">{d}</dd>
        </div>
      ))}
    </dl>
    {
      /* data-low-stock is the contract, not the wording. Reword or restyle it
         freely; keep the marker so scarcity stays distinguishable from normal
         availability without pinning copy. */
      model.lowStock && (
        <p data-low-stock class="mt-2 text-sm text-amber-700">
          Últimas plazas
        </p>
      )
    }
    {
      model.descriptionHtml && (
        <div class="markdown-content mt-6 max-w-prose text-muted" set:html={model.descriptionHtml} />
      )
    }

    <details class="mt-8 rounded-xl border border-line p-4">
      <summary class="cursor-pointer text-sm font-semibold text-ink">¿Ya lo tienes claro? Compra directa</summary>
      <p class="mt-2 text-xs text-faint">Si prefieres saltarte la vista previa, puedes contratarlo ya. Te recomendamos empezar gratis: así ves el resultado antes de pagar.</p>
      <ProductPurchaseForm model={purchase} />
    </details>

    {/* Share — hidden until JS confirms the browser can share or copy. Uses the
        Web Share API (mobile/native sheet) with a clipboard-copy fallback. */}
    <button
      type="button"
      data-share
      data-share-title={model.name}
      class="mt-6 hidden w-fit items-center gap-2 text-xs uppercase tracking-widest text-faint transition hover:text-brand"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="18" cy="5" r="3" />
        <circle cx="6" cy="12" r="3" />
        <circle cx="18" cy="19" r="3" />
        <line x1="8.6" y1="13.5" x2="15.4" y2="17.5" />
        <line x1="15.4" y1="6.5" x2="8.6" y2="10.5" />
      </svg>
      <span data-share-label>Compartir</span>
    </button>
  </div>
</div>

{
  model.related.length > 0 && (
    <section class="mt-20 border-t border-line pt-12">
      <h2 class="mb-6 text-2xl font-bold text-ink">También te puede interesar</h2>
      <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {model.related.map((card, i) => (
          <ProductCard card={card} index={i} headingLevel="h3" />
        ))}
      </ul>
    </section>
  )
}
