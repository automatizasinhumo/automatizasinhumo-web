---
import type { CatalogPageModel } from '../../features/storefront/models';
import ProductCard from './ProductCard.astro';
import CatalogSort from '../../features/storefront/controls/CatalogSort.astro';
import CatalogPagination from '../../features/storefront/controls/CatalogPagination.astro';
import Icono from './IconoCat.astro';

/**
 * STORE-OWNED. Edit freely — this file belongs to your store.
 *
 * The catalog, rendered at both `/` and `/products`. It performs no queries and
 * parses no query parameters: every product, link, and URL on `model` is
 * already built and bounded.
 *
 * Keep <CatalogSort> and <CatalogPagination>. Their hrefs encode the query
 * semantics the catalog's canonical URLs and caching depend on, and their
 * landmarks and rel hints are what make a paginated series legible to crawlers.
 *
 * See CUSTOMIZING.md for the full contract.
 */
interface Props {
  model: CatalogPageModel;
  /** 'h2' when a hero above already holds the page's h1. */
  headingLevel?: 'h1' | 'h2';
}

const { model, headingLevel = 'h1' } = Astro.props;
// En la portada el h1 es el del hero; aquí el catálogo pasa a h2.
const H = headingLevel;
---

<div class="mb-8 flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
  <div>
    <p class="etiqueta">{model.eyebrow}</p>
    <H class="mt-3 font-serif text-4xl font-bold tracking-tight sm:text-5xl">{model.heading}</H>
    {model.total ? <p class="mt-2 text-muted">{model.total} servicios con precio cerrado y plazo de entrega.</p> : null}
  </div>
  <form method="GET" action="/search" role="search" class="flex w-full items-center gap-2 rounded-full border border-line bg-surface py-1.5 pl-4 pr-1.5 shadow-sm focus-within:border-brand md:w-80">
    <Icono name="search" class="h-4 w-4 shrink-0 text-muted" />
    <input type="search" name="q" placeholder="Busca: carta QR, reservas…" aria-label="Buscar en el catálogo" class="min-w-0 flex-1 border-0 bg-transparent py-1 text-sm focus:outline-none" />
    <button type="submit" class="rounded-full bg-brand px-4 py-1.5 text-xs font-semibold text-on-brand hover:bg-brand-hover">Buscar</button>
  </form>
</div>

{
  model.categories.length > 0 && (
    <nav aria-label="Categorías" class="-mx-4 mb-8 overflow-x-auto px-4 pb-1">
      <ul class="flex gap-2 text-sm md:flex-wrap">
        {model.categories.map((category) => {
          const slug = category.href.split('/').pop() ?? '';
          return (
            <li>
              <a href={category.href} class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-line bg-surface px-3.5 py-1.5 font-medium text-ink transition-colors hover:border-brand hover:bg-brand hover:text-on-brand">
                <Icono cat={slug} class="h-4 w-4" />{category.text}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  )
}

<CatalogSort model={model.sort} />

{
  /* role="status" is the contract, not the wording: an empty catalog must
     announce itself to assistive technology rather than rendering a blank
     grid. Reword it freely; keep the role and keep it non-empty. */
  model.products.length === 0 && (
    <p role="status" class="text-muted">
      Aún no hay servicios.
    </p>
  )
}

<ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {model.products.map((card, i) => <ProductCard card={card} index={i} />)}
</ul>

<CatalogPagination model={model.pagination} />
