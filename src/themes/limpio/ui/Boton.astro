---
/**
 * Botón del tema limpio: emite las clases globales del sistema (.boton…,
 * definidas una sola vez en src/styles/overrides.css). Dos variantes:
 * - `principal`: relleno de marca con un destello que recorre el borde (ShimmerButton
 *   de Magic UI, MIT, licencias/magicui.txt). Solo uno por pantalla: es la acción clave.
 * - `secundario`: contorno sobre superficie.
 * Dos tallas: `normal` (portada y secciones) y `compacta` (cabecera, barras).
 * El destello es una rotación (la compone la GPU) y se para con prefers-reduced-motion.
 */
interface Props {
  href: string;
  variante?: 'principal' | 'secundario';
  talla?: 'normal' | 'compacta';
  /** Destello del principal; se apaga cuando hay varios en pantalla (tarjetas de un catálogo). */
  destello?: boolean;
  class?: string;
}
const { href, variante = 'principal', talla = 'normal', destello = true, class: cls } = Astro.props;
---
<a
  href={href}
  class:list={[
    'boton',
    variante === 'principal' ? ['boton-principal', destello && 'boton-destello'] : 'boton-secundario',
    talla === 'compacta' && 'boton-compacto',
    cls,
  ]}><span><slot /></span></a>
