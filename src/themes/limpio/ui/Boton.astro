---
/**
 * Botón del tema limpio. Dos variantes para toda la web:
 * - `principal`: relleno de marca con un destello que recorre el borde (ShimmerButton
 *   de Magic UI, MIT, licencias/magicui.txt). Solo uno por pantalla: es la acción clave.
 * - `secundario`: contorno sobre superficie.
 * Dos tallas: `normal` (portada y secciones) y `compacta` (cabecera, barras).
 * El destello es una rotación (la compone la GPU) y se para con prefers-reduced-motion.
 */
interface Props {
  href: string;
  variante?: 'principal' | 'secundario';
  talla?: 'normal' | 'compacta';
  class?: string;
}
const { href, variante = 'principal', talla = 'normal', class: cls } = Astro.props;
---
<a href={href} class:list={['boton', variante, talla, cls]}><span><slot /></span></a>

<style>
  .boton {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--ds-hueco-2);
    overflow: hidden;
    border-radius: var(--ds-radio-pildora);
    padding: 0.9rem 1.6rem;
    font-weight: 600;
    transition: transform var(--ds-mov-normal) var(--ds-curva), box-shadow var(--ds-mov-normal), border-color var(--ds-mov-rapido);
  }
  .compacta { padding: 0.5rem 1rem; font-size: 0.875rem; }
  .boton:hover { transform: translateY(-2px); }
  .boton:focus-visible { outline: 3px solid var(--color-brand); outline-offset: 3px; }
  .principal {
    color: var(--color-on-brand);
    background: var(--color-brand);
    box-shadow: var(--ds-sombra-marca);
  }
  .principal::before {
    content: '';
    position: absolute;
    inset: -150% -10%;
    z-index: -2;
    background: conic-gradient(from 0deg, transparent 0 300deg, rgb(255 255 255 / 0.85) 360deg);
    animation: boton-giro 3s linear infinite;
    will-change: transform;
  }
  .principal::after {
    content: '';
    position: absolute;
    inset: 2px;
    z-index: -1;
    border-radius: inherit;
    background: linear-gradient(180deg, color-mix(in oklab, var(--color-brand) 85%, #fff), var(--color-brand));
  }
  .principal:hover { box-shadow: 0 14px 34px -10px color-mix(in oklab, var(--color-brand) 85%, transparent); }
  .secundario {
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    background: var(--color-surface);
    box-shadow: var(--ds-sombra-1);
  }
  .secundario:hover { border-color: var(--color-brand); }
  @keyframes boton-giro { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .principal::before { animation: none; }
    .boton { transition: none; }
    .boton:hover { transform: none; }
  }
</style>
