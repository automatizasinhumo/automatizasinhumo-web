---
/**
 * Pasos numerados unidos por una línea: «cómo funciona» y cualquier proceso corto.
 * En horizontal cuando cabe; en vertical en el móvil. Entran al aparecer en
 * pantalla con una animación ligada al scroll (animation-timeline: view(), solo
 * transform y opacity); sin soporte, se ven directamente.
 */
import Icono from '../IconoCat.astro';

interface Paso {
  titulo: string;
  texto: string;
  icono: string;
}
interface Props {
  pasos: readonly Paso[];
  /** Título accesible de la lista. */
  etiqueta: string;
}
const { pasos, etiqueta } = Astro.props;
---
<ol class="pasos" aria-label={etiqueta}>
  {pasos.map((p, i) => (
    <li style={`--i:${i}`}>
      <span class="num"><Icono name={p.icono} class="h-5 w-5" /></span>
      <div>
        <p class="titulo"><span class="orden">{String(i + 1).padStart(2, '0')}</span> {p.titulo}</p>
        <p class="texto">{p.texto}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .pasos {
    display: grid;
    gap: var(--ds-hueco-6);
    counter-reset: paso;
  }
  li {
    position: relative;
    display: flex;
    gap: var(--ds-hueco-4);
    align-items: flex-start;
  }
  .num {
    position: relative;
    z-index: 1;
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid color-mix(in oklab, var(--color-brand) 25%, var(--color-line));
    border-radius: 50%;
    color: var(--color-brand);
    background: var(--color-surface);
    box-shadow: var(--ds-sombra-1);
  }
  /* Línea que une los pasos: vertical en el móvil. */
  li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 2.75rem;
    bottom: calc(-1 * var(--ds-hueco-6));
    left: 1.375rem;
    width: 1px;
    background: linear-gradient(var(--color-line), transparent);
  }
  .titulo {
    font-family: var(--font-serif);
    font-size: var(--ds-texto-h3);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .orden {
    margin-right: 0.15rem;
    font-size: var(--ds-texto-etiqueta);
    letter-spacing: var(--ds-tracking-etiqueta);
    color: var(--color-accent);
    vertical-align: 0.2em;
  }
  .texto {
    margin-top: 0.2rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  @media (min-width: 48rem) {
    .pasos { grid-template-columns: repeat(var(--n, 3), 1fr); grid-auto-flow: column; gap: var(--ds-hueco-8); }
    li { flex-direction: column; }
    li:not(:last-child)::after {
      top: 1.375rem;
      bottom: auto;
      left: 3.5rem;
      right: calc(-1 * var(--ds-hueco-8) + 0.75rem);
      width: auto;
      height: 1px;
      background: linear-gradient(90deg, var(--color-line), transparent);
    }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      li {
        animation: paso-entra linear both;
        animation-timeline: view();
        animation-range: entry 10% entry 70%;
      }
    }
  }
  @keyframes paso-entra {
    from { opacity: 0; transform: translateY(1.25rem); }
    to { opacity: 1; transform: none; }
  }
</style>
