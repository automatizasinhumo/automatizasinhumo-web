---
/**
 * STORE-OWNED. Portada del tema «limpio»: una sola pantalla con el eslogan en forma
 * de pirámide invertida (cada línea más estrecha que la de arriba), dos botones y la
 * lista corta de servicios. El test vive en su propia página (/elige).
 *
 * Efectos adaptados a CSS de Magic UI (MIT, licencias/magicui.txt): rejilla de fondo
 * con casillas resaltadas (GridPattern), texto con degradado (AuroraText) y botón con
 * destello (ShimmerButton). En reposo solo se mueve el destello, que es una rotación
 * (la compone la GPU sin repintar). Medidas fluidas (clamp), sin ajustes por dispositivo.
 */
import Icono from './IconoCat.astro';

interface Opcion {
  id: string;
  href: string;
}

interface Props {
  /** Objetivos del selector, ya con su enlace al resultado. */
  objetivos: readonly Opcion[];
  /** Página del test «¿Qué estás buscando?». */
  testHref: string;
  /** Listado completo de servicios. */
  catalogHref: string;
}

const { objetivos, testHref, catalogHref } = Astro.props;

// Servicios que se nombran bajo los botones: nombre corto, icono y objetivo del test.
// Un objetivo que no exista se ignora.
const SERVICIOS: [string, string, string][] = [
  ['llamadas', 'world-www', 'Webs'],
  ['vender', 'shopping-bag', 'Tiendas online'],
  ['citas', 'calendar-check', 'Reservas'],
  ['automatizar', 'route', 'Automatizaciones'],
  ['trabajo', 'id-badge-2', 'CV'],
  ['evento', 'heart', 'Invitaciones'],
];
const servicios = SERVICIOS.flatMap(([id, icono, nombre]) => {
  const o = objetivos.find((x) => x.id === id);
  return o ? [{ href: o.href, icono, nombre }] : [];
});

// Casillas resaltadas de la rejilla (columna, fila), como las «squares» de GridPattern.
const CELDA = 48;
const CASILLAS: [number, number, 'brand' | 'accent'][] = [
  [2, 1, 'brand'], [5, 3, 'accent'], [9, 2, 'brand'], [14, 1, 'brand'], [18, 4, 'accent'],
  [22, 2, 'brand'], [26, 5, 'brand'], [3, 7, 'accent'], [11, 8, 'brand'], [24, 9, 'accent'],
  [30, 3, 'brand'], [34, 7, 'brand'], [1, 11, 'brand'], [16, 11, 'accent'], [29, 12, 'brand'],
];
---

<div class="fondo" aria-hidden="true">
  <svg class="rejilla">
    <defs>
      <pattern id="rejilla-celda" width={CELDA} height={CELDA} patternUnits="userSpaceOnUse" x="-1" y="-1">
        <path d={`M.5 ${CELDA}V.5H${CELDA}`} fill="none" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#rejilla-celda)" />
    {CASILLAS.map(([c, f, tono], i) => (
      <rect class={`casilla ${tono}`} opacity={[1, 0.45, 0.7][i % 3]} width={CELDA - 1} height={CELDA - 1} x={c * CELDA} y={f * CELDA} />
    ))}
  </svg>
</div>

<section class="piramide" aria-labelledby="portada-titulo">
  <h1 id="portada-titulo">
    <span class="fila fila-1">Tu negocio, tu evento,</span>
    <span class="fila fila-2">tu idea, <span class="aurora">en marcha</span></span>
    <span class="fila fila-3"><span class="aurora">sin complicaciones</span></span>
  </h1>
  <p class="subtitulo">Eliges, rellenas tus datos y lo tienes listo. Con precio cerrado desde el principio.</p>
  <div class="botones">
    <a href={testHref} class="destello"><span>Haz el test y te recomendamos</span></a>
    <a href={catalogHref} class="secundario">Ver todos los servicios</a>
  </div>
  {servicios.length > 0 && (
    <ul class="servicios" aria-label="Servicios">
      {servicios.map((s) => (
        <li><a href={s.href}><Icono name={s.icono} class="h-4 w-4" />{s.nombre}</a></li>
      ))}
    </ul>
  )}
  <p class="punta">Precio cerrado · 100 % automático</p>
</section>

<style>
  /* ── Fondo: rejilla difuminada + dos halos de color, fijo detrás de toda la página.
     Los halos son degradados radiales (sin filter: blur, que es caro en el móvil). ── */
  .fondo {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(circle at 0% 0%, color-mix(in oklab, var(--color-brand) 30%, transparent), transparent min(45vw, 30rem)),
      radial-gradient(circle at 100% 30%, color-mix(in oklab, var(--color-accent) 16%, transparent), transparent min(50vw, 32rem));
  }
  .rejilla {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    stroke: color-mix(in oklab, var(--color-brand) 16%, transparent);
    mask-image: radial-gradient(ellipse 75% 65% at 50% 35%, #000 25%, transparent 100%);
  }
  .casilla { stroke: none; }
  .casilla.brand { fill: color-mix(in oklab, var(--color-brand) 14%, transparent); }
  .casilla.accent { fill: color-mix(in oklab, var(--color-accent) 12%, transparent); }

  /* ── Pirámide invertida: cada bloque más estrecho que el anterior, pegada arriba ── */
  .piramide {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* La página ya deja 3rem bajo la cabecera: aquí solo un poco más en pantallas altas. */
    padding-block: clamp(0rem, 2.5vh, 1.5rem) clamp(2rem, 6vh, 4rem);
    text-align: center;
  }
  .piramide h1 {
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--color-ink);
  }
  /* Tres filas fijas, cada una con letra más pequeña: más estrecha que la de arriba en
     cualquier pantalla. El tamaño va con el ancho (vw), así que nunca hace falta partirlas. */
  .fila {
    display: block;
    white-space: nowrap;
  }
  .fila-1 { font-size: clamp(1.6rem, 7vw, 4.6rem); }
  .fila-2 { font-size: clamp(1.45rem, 6.3vw, 4.1rem); }
  .fila-3 { font-size: clamp(1.3rem, 5.6vw, 3.6rem); }
  .aurora {
    background: linear-gradient(120deg, var(--color-brand) 10%, #1f8a72 45%, var(--color-accent) 95%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .subtitulo {
    max-width: 42ch;
    margin-top: clamp(1.25rem, 3.5vh, 2.25rem);
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.5;
    color: var(--color-muted);
    text-wrap: balance;
  }
  .botones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 4.5vh, 2.75rem);
  }
  .botones a {
    border-radius: 999px;
    padding: 0.9rem 1.6rem;
    font-weight: 600;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .botones a:hover { transform: translateY(-2px); }
  /* ShimmerButton: una luz recorre el borde del botón principal. */
  .destello {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--color-on-brand);
    background: var(--color-brand);
    box-shadow: 0 10px 30px -10px color-mix(in oklab, var(--color-brand) 70%, transparent);
  }
  .destello::before {
    content: '';
    position: absolute;
    inset: -150% -10%;
    z-index: -2;
    background: conic-gradient(from 0deg, transparent 0 300deg, rgb(255 255 255 / 0.85) 360deg);
    animation: giro 3s linear infinite;
    will-change: transform;
  }
  .destello::after {
    content: '';
    position: absolute;
    inset: 2px;
    z-index: -1;
    border-radius: inherit;
    background: linear-gradient(180deg, color-mix(in oklab, var(--color-brand) 85%, #fff), var(--color-brand));
  }
  .destello:hover { box-shadow: 0 14px 34px -10px color-mix(in oklab, var(--color-brand) 85%, transparent); }
  .secundario {
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    background: var(--color-surface);
  }
  .secundario:hover { border-color: var(--color-brand); }

  /* ── Servicios: una fila de etiquetas pequeñas, más estrecha que los botones ── */
  .servicios {
    display: flex;
    max-width: 46rem;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: clamp(1.75rem, 5vh, 2.75rem);
  }
  .servicios a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid color-mix(in oklab, var(--color-brand) 18%, var(--color-line));
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    font-size: 0.85rem;
    color: var(--color-ink);
    background: color-mix(in oklab, var(--color-surface) 75%, transparent);
    transition: border-color 0.2s, color 0.2s;
  }
  .servicios a:hover { border-color: var(--color-brand); color: var(--color-brand); }
  .servicios :global(svg) { color: var(--color-brand); }
  .punta {
    margin-top: clamp(1.25rem, 3.5vh, 2rem);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  @keyframes giro { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .destello::before { animation: none; }
    .botones a, .servicios a { transition: none; }
  }
</style>
