---
/**
 * STORE-OWNED. Portada del tema «limpio». Una pantalla: el eslogan (pirámide invertida,
 * cada fila más estrecha), la escena que enseña lo que se vende, dos botones, los
 * servicios y, debajo, «Así funciona».
 *
 * Animación de la portada (CSS puro, sin JavaScript): un ciclo de 9 s con tres turnos.
 * En cada turno se enciende una parte del título («Tu negocio», «tu evento», «tu idea»)
 * como una bombilla y a la vez aparece su escena: la web y la ficha de mapa de un
 * negocio, la invitación de una boda y un flujo automático. Todas las piezas usan el
 * mismo keyframe desfasado (0, -6 y -3 s), así que nunca se descoordinan. Solo se animan
 * opacity y transform (los compone la GPU) y con prefers-reduced-motion queda quieta.
 *
 * Inspirado en Word Rotate, Safari y Animated Beam de Magic UI (MIT, licencias/magicui.txt),
 * reescritos en CSS. Las palabras encendidas son una capa ::after con el mismo texto
 * (content: attr() / "" para que el lector de pantalla no lo lea dos veces).
 */
import Icono from './IconoCat.astro';
import Boton from './ui/Boton.astro';
import Fondo from './ui/Fondo.astro';
import Marco from './ui/Marco.astro';
import Pasos from './ui/Pasos.astro';
import Pildora from './ui/Pildora.astro';
import Seccion from './ui/Seccion.astro';

interface Opcion {
  id: string;
  href: string;
}

interface Props {
  /** Objetivos del selector, ya con su enlace al resultado. */
  objetivos: readonly Opcion[];
  /** Página del test «¿Qué estás buscando?». */
  testHref: string;
  /** Listado completo de servicios. */
  catalogHref: string;
}

const { objetivos, testHref, catalogHref } = Astro.props;

// Servicios que se nombran bajo los botones: nombre corto, icono y objetivo del test.
// Un objetivo que no exista se ignora.
const SERVICIOS: [string, string, string][] = [
  ['llamadas', 'world-www', 'Webs'],
  ['vender', 'shopping-bag', 'Tiendas online'],
  ['citas', 'calendar-check', 'Reservas'],
  ['automatizar', 'route', 'Automatizaciones'],
  ['trabajo', 'id-badge-2', 'CV'],
  ['evento', 'heart', 'Invitaciones'],
];
const servicios = SERVICIOS.flatMap(([id, icono, nombre]) => {
  const o = objetivos.find((x) => x.id === id);
  return o ? [{ href: o.href, icono, nombre }] : [];
});

const PASOS = [
  { icono: 'hand-click', titulo: 'Elige', texto: 'Una plantilla del catálogo o la que te recomiende el test en un minuto.' },
  { icono: 'pencil', titulo: 'Rellena tus datos', texto: 'Textos, fotos y colores. Ves la vista previa mientras lo personalizas.' },
  { icono: 'rocket', titulo: 'Listo al momento', texto: 'Pagas el precio cerrado y lo descargas o publicas al instante.' },
];
---

<Fondo />

<section class="portada" aria-labelledby="portada-titulo">
  <div class="titulo-caja">
    <h1 id="portada-titulo">
      <span class="fila fila-1"><span class="luz t1" data-t="Tu negocio">Tu negocio</span>, <span class="luz t2" data-t="tu evento">tu evento</span>,</span>
      <span class="fila fila-2"><span class="luz t3" data-t="tu idea">tu idea</span>, <span class="marca">en marcha</span></span>
      <span class="fila fila-3"><span class="marca">sin complicaciones</span></span>
    </h1>
  </div>

  <div class="escena-caja">
  <div class="escenario" aria-hidden="true">
    <span class="chispa"><Icono name="bulb" class="h-5 w-5" /><Icono name="arrow-right" class="flecha h-4 w-4" /></span>

    <div class="escena t1">
      <Marco url="cafeterialuna.es">
        <img src="/images/demos/cafe-coffee-shop-640.webp" width="640" height="430" alt="" fetchpriority="high" decoding="async" />
      </Marco>
      <div class="flotante abajo-izq">
        <span class="icono-redondo"><Icono name="map-pin" class="h-4 w-4" /></span>
        <span>
          <b>Cafetería Luna</b>
          <span class="estrellas"><Icono name="star" class="h-3 w-3" /> 4,9 · 128 reseñas</span>
          <span class="estado">Abierto · Cómo llegar</span>
        </span>
      </div>
    </div>

    <div class="escena t2">
      <Marco url="lauraydani.es">
        <img src="/images/demos/wedding-640.webp" width="640" height="430" alt="" decoding="async" />
      </Marco>
      <div class="flotante abajo-der">
        <span class="icono-redondo ok"><Icono name="circle-check" class="h-4 w-4" /></span>
        <span>
          <b>Asistencia confirmada</b>
          <span class="estado">86 invitados · 14 de junio</span>
        </span>
      </div>
    </div>

    <div class="escena t3">
      <div class="flujo">
        <p class="flujo-cabecera"><Icono name="route" class="h-4 w-4" /> Automatización · Pedidos</p>
        <ol class="nodos">
          <li><span class="icono-redondo"><Icono name="shopping-cart" class="h-4 w-4" /></span>Nuevo pedido</li>
          <li><span class="icono-redondo"><Icono name="file-invoice" class="h-4 w-4" /></span>Factura PDF</li>
          <li><span class="icono-redondo"><Icono name="mail-fast" class="h-4 w-4" /></span>Aviso al cliente</li>
        </ol>
        <div class="carril"><span class="progreso"></span></div>
      </div>
      <div class="flotante arriba-der">
        <span class="icono-redondo ok"><Icono name="bolt" class="h-4 w-4" /></span>
        <span>
          <b>Hecho solo</b>
          <span class="estado">en 4 segundos, sin tocar nada</span>
        </span>
      </div>
    </div>
  </div>
  <!-- WCAG 2.2.2: lo que se mueve más de 5 s debe poder pararse. Sin JS no se muestra. -->
  <button type="button" class="pausa" data-pausa-anim hidden>
    <span class="si-mueve"><Icono name="player-pause" class="h-4 w-4" />Pausar animación</span>
    <span class="si-pausa"><Icono name="player-play" class="h-4 w-4" />Reanudar animación</span>
  </button>
  </div>

  <div class="resto">
    <p class="subtitulo">Crea tu web, automatiza tu negocio y lanza tu evento en pocos pasos. Todo automático, a precio cerrado y con vista previa antes de pagar.</p>
    <div class="botones">
      <Boton href={testHref}>Haz el test y te recomendamos</Boton>
      <Boton href={catalogHref} variante="secundario">Ver todos los servicios</Boton>
    </div>
    {servicios.length > 0 && (
      <ul class="servicios" aria-label="Servicios">
        {servicios.map((s) => (
          <li><Pildora href={s.href} icono={s.icono}>{s.nombre}</Pildora></li>
        ))}
      </ul>
    )}
    <p class="punta">Precio cerrado · 100 % automático</p>
  </div>
</section>

<Seccion id="como" antetitulo="Así funciona" separada>
  <Pasos pasos={PASOS} etiqueta="Pasos para tenerlo listo" />
</Seccion>

<style>
  /* ── Disposición: en el móvil todo en columna y centrado (título, escena, resto);
     desde 60rem, texto a la izquierda y escena a la derecha. ── */
  .portada {
    display: grid;
    grid-template-areas: 'titulo' 'escena' 'resto';
    gap: var(--ds-hueco-8);
    justify-items: center;
    padding-block: clamp(0rem, 2vh, 1.5rem) var(--ds-hueco-8);
    text-align: center;
  }
  .titulo-caja { grid-area: titulo; width: 100%; container-type: inline-size; }
  .escena-caja {
    grid-area: escena;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ds-hueco-3);
    width: min(100%, 34rem);
  }
  .resto {
    display: flex;
    grid-area: resto;
    flex-direction: column;
    align-items: center;
  }
  @media (min-width: 60rem) {
    .portada {
      grid-template-areas: 'titulo escena' 'resto escena';
      grid-template-columns: 1.08fr 1fr;
      grid-template-rows: auto 1fr;
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
      row-gap: var(--ds-hueco-6);
      align-items: center;
      justify-items: start;
      text-align: left;
    }
    .titulo-caja { align-self: end; }
    .resto { align-self: start; align-items: flex-start; }
    .escena-caja { align-self: center; }
  }

  /* ── Título: tres filas fijas, cada una más pequeña. Tamaño en cqi (ancho de su
     columna), así no se parte ni desborda en ningún ancho. ── */
  h1 {
    font-weight: 700;
    letter-spacing: var(--ds-tracking-titular);
    line-height: 1.05;
    color: var(--color-ink);
  }
  /* Mínimo y máximo en rem: siguen el tamaño de letra que elija el usuario. Si con
     una base grande la fila no cabe, se parte en vez de desbordar. */
  .fila { display: block; text-wrap: balance; }
  .fila-1 { font-size: clamp(1.5rem, 9.2cqi, 4.4rem); }
  .fila-2 { font-size: clamp(1.35rem, 8.3cqi, 4rem); }
  .fila-3 { font-size: clamp(1.2rem, 7.4cqi, 3.55rem); }
  .marca {
    background: var(--ds-degradado-marca);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Palabras que se encienden: halo cálido (::before) y el mismo texto en degradado de
     luz (::after) por encima. Solo cambia su opacidad. */
  /* inline-block: la capa ::after ocupa la misma caja que el texto y cae encima exacta. */
  .luz { position: relative; display: inline-block; isolation: isolate; }
  .luz::before,
  .luz::after { position: absolute; opacity: 0; pointer-events: none; }
  .luz::before {
    content: '';
    inset: -0.15em -0.3em;
    z-index: -1;
    border-radius: 0.4em;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--color-accent) 22%, transparent), transparent);
  }
  .luz::after {
    content: attr(data-t);
    content: attr(data-t) / '';
    inset: 0;
    background: var(--ds-degradado-luz);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ── Escena: las tres capas en la misma celda de rejilla; la caja mide lo que la más
     alta, así nunca se solapa con lo de debajo ni mueve la página al cambiar. ── */
  .escenario {
    position: relative;
    display: grid;
    align-items: center;
    width: 100%;
  }
  .escena {
    position: relative;
    grid-area: 1 / 1;
    padding: 0 1.25rem 2.5rem 0;
    opacity: 0;
  }
  .escena.t3 { padding: 0 0 3.25rem; }
  .escena img { display: block; width: 100%; height: auto; }

  .chispa {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    top: -1.1rem;
    left: 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: var(--ds-radio-pildora);
    padding: 0.4rem 0.55rem;
    color: var(--color-accent);
    background: var(--color-surface);
    box-shadow: var(--ds-sombra-2);
  }
  .chispa :global(.flecha) { rotate: 90deg; color: var(--color-faint); }
  .chispa::before {
    content: '';
    position: absolute;
    inset: -0.6rem;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--color-accent) 35%, transparent), transparent);
    opacity: 0;
  }
  @media (min-width: 60rem) {
    .chispa { top: 38%; left: -1.1rem; translate: -100% 0; }
    .chispa :global(.flecha) { rotate: 0deg; }
  }

  /* Tarjetas flotantes encima del marco: el «resultado» de cada escena. */
  .flotante {
    position: absolute;
    display: flex;
    align-items: center;
    gap: var(--ds-hueco-3);
    max-width: 15rem;
    border: 1px solid var(--color-line);
    border-radius: var(--ds-radio-tarjeta);
    padding: 0.7rem 0.95rem 0.7rem 0.7rem;
    font-size: 0.78rem;
    line-height: 1.35;
    text-align: left;
    color: var(--color-muted);
    background: var(--color-surface);
    box-shadow: var(--ds-sombra-3);
  }
  .flotante b { display: block; font-size: 0.88rem; color: var(--color-ink); }
  .flotante > span:last-child > span { display: block; }
  .abajo-izq { bottom: 0; left: -0.5rem; }
  .abajo-der { bottom: 0; right: 0; }
  .arriba-der { bottom: 0; right: 0; }
  @media (min-width: 60rem) {
    .escena.t3 { padding: 2.25rem 0 0; }
    .arriba-der { top: 0; bottom: auto; }
  }
  .estrellas { display: inline-flex !important; align-items: center; gap: 0.2rem; color: #b7791f; }
  .estrellas :global(svg) { fill: currentColor; }
  .estado { color: var(--color-brand); font-weight: 600; }
  .icono-redondo {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    color: var(--color-accent);
    background: color-mix(in oklab, var(--color-accent) 12%, var(--color-surface));
  }
  .icono-redondo.ok { color: var(--color-brand); background: color-mix(in oklab, var(--color-brand) 12%, var(--color-surface)); }

  /* Flujo automático: tres nodos y un carril que se llena. */
  .flujo {
    border: 1px solid var(--color-line);
    border-radius: var(--ds-radio-marco);
    padding: 1.1rem 1.25rem 1.4rem;
    background: var(--color-surface);
    box-shadow: var(--ds-sombra-3);
    text-align: left;
  }
  .flujo-cabecera {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--ds-texto-etiqueta);
    font-weight: 600;
    letter-spacing: var(--ds-tracking-etiqueta);
    text-transform: uppercase;
    color: var(--color-faint);
  }
  .nodos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ds-hueco-3);
    margin-top: var(--ds-hueco-6);
  }
  .nodos li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--ds-radio-marco);
    padding: 1rem 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-align: center;
    color: var(--color-ink);
    background: var(--color-paper);
  }
  .nodos li:nth-child(2) .icono-redondo,
  .nodos li:nth-child(3) .icono-redondo { color: var(--color-brand); background: color-mix(in oklab, var(--color-brand) 12%, var(--color-surface)); }
  .carril {
    height: 0.35rem;
    margin-top: var(--ds-hueco-6);
    overflow: hidden;
    border-radius: var(--ds-radio-pildora);
    background: var(--color-line);
  }
  .progreso {
    display: block;
    height: 100%;
    background: var(--ds-degradado-marca);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* ── Resto ── */
  .subtitulo {
    max-width: 44ch;
    font-size: var(--ds-texto-lead);
    line-height: 1.5;
    color: var(--color-muted);
    text-wrap: balance;
  }
  .botones {
    display: flex;
    flex-wrap: wrap;
    justify-content: inherit;
    gap: var(--ds-hueco-3);
    margin-top: var(--ds-hueco-8);
  }
  .resto .botones { justify-content: center; }
  .servicios {
    display: flex;
    max-width: 40rem;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--ds-hueco-2);
    margin-top: var(--ds-hueco-8);
  }
  @media (min-width: 60rem) {
    .resto .botones,
    .servicios { justify-content: flex-start; }
  }
  .punta {
    margin-top: var(--ds-hueco-6);
    font-size: var(--ds-texto-etiqueta);
    font-weight: 600;
    letter-spacing: var(--ds-tracking-etiqueta);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  /* ── El ciclo: un keyframe para todo, desfasado por turno ── */
  @media (prefers-reduced-motion: no-preference) {
    .luz::before,
    .luz::after { animation: enciende 9s ease-in-out infinite; }
    .escena { animation: turno 9s var(--ds-curva) infinite; }
    .escena { will-change: opacity, transform; }
    .t2::before, .t2::after, .escena.t2 { animation-delay: -6s; }
    .t3::before, .t3::after, .escena.t3 { animation-delay: -3s; }
    .escena.t3 .progreso { animation: progreso 9s var(--ds-curva) -3s infinite; }
    .chispa::before { animation: chispa 3s ease-out infinite; }
  }
  @media (prefers-reduced-motion: reduce) {
    .escena.t1 { opacity: 1; }
    .progreso { transform: none; }
  }
  .pausa {
    align-self: flex-end;
    display: inline-flex;
    border: 1px solid var(--color-line);
    border-radius: var(--ds-radio-pildora);
    padding: 0.3rem 0.75rem;
    font-size: 0.8rem;
    color: var(--color-muted);
    background: var(--color-surface);
    cursor: pointer;
    transition: color var(--ds-mov-rapido), border-color var(--ds-mov-rapido);
  }
  .pausa:hover { color: var(--color-ink); border-color: var(--color-faint); }
  .pausa:focus-visible { outline: 3px solid var(--color-brand); outline-offset: 2px; }
  .pausa > span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .pausa .si-pausa,
  .portada[data-pausa] .pausa .si-mueve { display: none; }
  .portada[data-pausa] .pausa .si-pausa { display: inline-flex; }
  /* Pausa todo lo que se repite en la portada, también el destello de los botones. */
  .portada[data-pausa] :global(*),
  .portada[data-pausa] :global(*)::before,
  .portada[data-pausa] :global(*)::after { animation-play-state: paused !important; }
  @media (prefers-reduced-motion: reduce) {
    .pausa { display: none; }
  }
  @keyframes turno {
    0% { opacity: 0; transform: translateY(0.5rem) scale(0.985); }
    5%, 30% { opacity: 1; transform: none; }
    35%, 100% { opacity: 0; transform: translateY(-0.35rem) scale(0.99); }
  }
  @keyframes enciende {
    0% { opacity: 0; }
    6%, 30% { opacity: 1; }
    36%, 100% { opacity: 0; }
  }
  @keyframes progreso {
    0%, 6% { transform: scaleX(0); }
    26%, 100% { transform: scaleX(1); }
  }
  @keyframes chispa {
    0% { opacity: 0; }
    12% { opacity: 1; }
    60%, 100% { opacity: 0; }
  }
</style>

<script>
  // Botón de pausa de la portada; recuerda la elección del visitante.
  const CLAVE = 'ash-portada-pausa';
  const boton = document.querySelector<HTMLButtonElement>('[data-pausa-anim]');
  const portada = boton?.closest<HTMLElement>('.portada');
  if (boton && portada) {
    const aplicar = (pausa: boolean) => {
      portada.toggleAttribute('data-pausa', pausa);
    };
    let pausa = false;
    try { pausa = localStorage.getItem(CLAVE) === '1'; } catch { /* sin almacenamiento */ }
    aplicar(pausa);
    boton.hidden = false;
    boton.addEventListener('click', () => {
      pausa = !pausa;
      aplicar(pausa);
      try { localStorage.setItem(CLAVE, pausa ? '1' : '0'); } catch { /* sin almacenamiento */ }
    });
  }
</script>
