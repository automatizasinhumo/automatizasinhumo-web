---
import type { StorefrontShellModel } from '../../features/storefront/models';
import Logo from './Logo.astro';
import Boton from './ui/Boton.astro';

/**
 * STORE-OWNED. Tema «limpio»: banda de llamada a la acción, columnas y la marca
 * en grande como cierre (decorativa, aria-hidden). Todo con tokens --ds-*.
 *
 * Footer links come from the merchant's navigation menu, already filtered to
 * targets that are actually publishable, so nothing here can render a dead
 * link. Like the header, this renders on every page.
 */
interface Props {
  model: StorefrontShellModel;
}

const { model } = Astro.props;
---

<footer class="pie">
  <div class="interior">
    <section class="llamada" aria-labelledby="pie-llamada">
      <div>
        <h2 id="pie-llamada">¿Lo ponemos en marcha?</h2>
        <p>Haz el test en un minuto y te decimos qué te encaja, con precio cerrado y vista previa antes de pagar.</p>
      </div>
      <Boton href="/elige" variante="secundario">Haz el test</Boton>
    </section>

    <div class="columnas">
      <div>
        <span class="chapa"><Logo /></span>
        <p class="lema">
          Creamos páginas web, automatizaciones y otros servicios digitales a un precio cerrado. Puedes contratar cada servicio directamente o pedir una prueba gratuita antes de pagar. David Porto Díaz atiende personalmente tus consultas.
        </p>
      </div>
      {
        model.footerLinks.length > 0 && (
          <nav aria-label="Pie de página" class="enlaces">
            {model.footerLinks.map((link) => (
              <a href={link.href}>{link.text}</a>
            ))}
          </nav>
        )
      }
    </div>
    {
      model.sectorLinks.length > 0 && (
        <section aria-labelledby="pie-sectores" class="sectores">
          <h2 id="pie-sectores">Webs por sector</h2>
          <ul>
            {model.sectorLinks.map((link) => (
              <li><a href={link.href}>{link.text}</a></li>
            ))}
          </ul>
        </section>
      )
    }
    <p class="legal">&copy; {new Date().getFullYear()} {model.storeName} · Sin complicaciones y con una persona detrás.</p>
  </div>
  <p class="gigante" aria-hidden="true">sin humo</p>
</footer>

<style>
  .pie {
    position: relative;
    overflow: hidden;
    margin-top: 4rem;
    color: #fff;
    background:
      radial-gradient(60rem 30rem at 85% -10%, color-mix(in oklab, var(--color-brand) 45%, transparent), transparent 70%),
      var(--color-ink);
  }
  .interior {
    max-width: 72rem;
    margin-inline: auto;
    padding: var(--ds-hueco-12) var(--ds-hueco-6) 0;
  }
  .llamada {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--ds-hueco-6);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: var(--ds-radio-tarjeta);
    padding: var(--ds-hueco-8);
    background: linear-gradient(135deg, color-mix(in oklab, var(--color-brand) 70%, var(--color-ink)), color-mix(in oklab, var(--color-brand) 25%, var(--color-ink)));
    box-shadow: var(--ds-sombra-3);
  }
  .llamada h2 { font-family: var(--font-serif); font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem); font-weight: 700; letter-spacing: var(--ds-tracking-titular); line-height: 1.1; }
  .llamada p { margin-top: var(--ds-hueco-2); max-width: 34rem; color: rgb(255 255 255 / 0.8); }
  .columnas {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--ds-hueco-8);
    padding-block: var(--ds-hueco-12) var(--ds-hueco-8);
  }
  @media (min-width: 40rem) { .columnas { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); } }
  .chapa { display: inline-block; max-width: 100%; border-radius: 0.75rem; padding: 0.5rem 0.75rem; background: var(--color-paper); }
  .lema { margin-top: var(--ds-hueco-6); max-width: 24rem; font-size: 0.875rem; line-height: 1.65; color: rgb(255 255 255 / 0.75); }
  .enlaces { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-content: start; gap: var(--ds-hueco-3) var(--ds-hueco-6); font-size: 0.875rem; }
  .pie a { color: rgb(255 255 255 / 0.8); text-underline-offset: 3px; transition: color var(--ds-mov-rapido); }
  .pie a:hover { color: #fff; text-decoration: underline; }
  .pie a:focus-visible { outline: 2px solid #fff; outline-offset: 2px; border-radius: 2px; }
  .sectores { border-top: 1px solid rgb(255 255 255 / 0.1); padding-block: var(--ds-hueco-6); font-size: 0.875rem; }
  .sectores h2 { font-weight: 600; }
  .sectores ul { display: flex; flex-wrap: wrap; gap: var(--ds-hueco-2) var(--ds-hueco-6); margin-top: var(--ds-hueco-3); }
  .legal { border-top: 1px solid rgb(255 255 255 / 0.1); padding-block: var(--ds-hueco-6); font-size: 0.75rem; color: rgb(255 255 255 / 0.6); }
  /* La marca en grande, cortada por abajo: cierre visual, sin texto que leer. */
  .gigante {
    margin: 0 0 -0.22em;
    font-family: var(--font-serif);
    font-size: clamp(4.5rem, 21vw, 17rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.9;
    text-align: center;
    white-space: nowrap;
    color: transparent;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.16), rgb(255 255 255 / 0.02) 85%);
    -webkit-background-clip: text;
    background-clip: text;
    user-select: none;
  }
</style>
