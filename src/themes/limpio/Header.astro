---
import type { StorefrontShellModel } from '../../features/storefront/models';
import StoreNav from '../../features/storefront/controls/StoreNav.astro';
import StoreSearchToggle from '../../features/storefront/controls/StoreSearchToggle.astro';
import StoreCartControl from '../../features/storefront/controls/StoreCartControl.astro';
import StoreAccountControl from '../../features/storefront/controls/StoreAccountControl.astro';
import Logo from './Logo.astro';
import Boton from './ui/Boton.astro';
import LuzTarjetas from './ui/LuzTarjetas.astro';
import Transiciones from './ui/Transiciones.astro';
import StoreMegaMenu from '../../features/storefront/controls/StoreMegaMenu.astro';
import { menuAreas, coveredByMegaMenu } from './menuAreas';

/**
 * STORE-OWNED. Tema «limpio»: cabecera en isla flotante (logo, Servicios, lupa,
 * carrito y una llamada a la acción). Arriba del todo es transparente y se funde con
 * la página; al bajar se vuelve cristal con borde y sombra (ligado al scroll, sin JS).
 * Sin soporte de animation-timeline queda siempre en cristal.
 *
 * It renders on EVERY page, including cart, checkout, payment, account, and
 * Admin login. A broken header is a broken checkout, so keep the core controls
 * below and change their placement and styling rather than their markup.
 *
 * See CUSTOMIZING.md for the full contract.
 */
interface Props {
  model: StorefrontShellModel;
}

const { model } = Astro.props;
// En xl el mega menú «Servicios» sustituye a los enlaces de catálogo y categorías;
// el resto (páginas) sigue en línea. Por debajo de xl, la hamburguesa lleva todos.
// El catálogo vive en / mientras la portada no apunte a otra página.
const shopHref = model.catalogHref;
const pageLinks = model.headerLinks.filter((link) => link.href !== shopHref && !coveredByMegaMenu(link.href));
---

{/* Announcement bar. Deliberately NOT fixed: the header below is sticky, so a
    fixed bar would need the header offset by the bar's height — which varies
    as the message wraps on narrow screens. Static means it's seen on load,
    scrolls away, and costs no vertical space on mobile. */}
{
  model.announcement && (
    <div class="bg-brand text-on-brand">
      <div class="mx-auto max-w-6xl px-6 py-1 text-center text-[13px] font-medium">
        {model.announcement.href ? (
          <a href={model.announcement.href} class="inline-block py-1 underline-offset-2 hover:underline">
            {model.announcement.text}
          </a>
        ) : (
          model.announcement.text
        )}
      </div>
    </div>
  )
}

<header class="cabecera">
  <div class="isla">
    <a href="/" aria-label={model.storeName} class="min-w-0 max-w-full shrink-0">
      {
        model.logo ? (
          /* Not lazy: the header logo is above the fold on every page. The
             store name stays the alt text, so the header still reads the
             same to a screen reader or when the image fails. */
          <img src={model.logo.src} alt={model.logo.alt} class="h-8 max-w-[min(12rem,100%)] object-contain sm:h-10" />
        ) : (
          <Logo />
        )
      }
    </a>
    {/* ml-auto pins the whole nav to the right edge of the header row, so it
        stays flush right no matter how few items a merchant has.
        min-w-0 is what lets long labels ellipsize instead of overflowing the
        page: flex items default to min-width:auto, and without it here the
        shrink stops at this level and the row grows past the viewport —
        putting min-w-0 only on the links themselves is not enough. */}
    <nav
      aria-label="Principal"
      class="ml-auto flex min-w-0 flex-wrap items-center justify-end gap-3 text-sm font-medium text-ink sm:gap-5"
    >
      <StoreMegaMenu
        label="Servicios"
        areas={menuAreas}
        allHref={model.serviciosHref}
        allText="Ver todos los servicios"
        links={pageLinks}
        class="hidden xl:flex"
      />
      {/* Sin fila en línea: en xl la sustituye el mega menú; la hamburguesa
          (xl:hidden) sigue llevando todos los enlaces del menú de D1. */}
      <StoreNav links={model.headerLinks} inline={false} />
      {/* La búsqueda es una lupa en todos los anchos: la cabecera queda limpia y el
          formulario (GET real, funciona sin JS) se abre colgado de la isla. */}
      <StoreSearchToggle
        action={model.search.action}
        query={model.search.query}
        class=""
        panelClass="absolute right-2 top-full z-40 mt-2 w-[min(22rem,calc(100vw-2rem))] rounded-2xl border border-line bg-surface p-3 shadow-lg"
      />
      {model.cart.enabled && <StoreCartControl href={model.cart.href} />}
      {model.account.enabled && <StoreAccountControl href={model.account.href} />}
      <Boton href="/elige" variante="secundario" talla="compacta" class="hidden sm:inline-flex">Haz el test</Boton>
    </nav>
  </div>
</header>
{/* Efectos globales del sistema (una vez por página): borde luminoso de las .tarjeta y transición entre páginas. */}
<LuzTarjetas />
<Transiciones />

<script>
  // Publica la altura real de la cabecera fija en --alto-cabecera para que lo que se pega
  // debajo (barras de pasos, anclas) no quede tapado; con zoom de texto la isla baja de línea
  // y la altura cambia, por eso se mide en vez de fijarla.
  const cabecera = document.querySelector<HTMLElement>('.cabecera');
  if (cabecera && 'ResizeObserver' in window) {
    new ResizeObserver(() => {
      document.documentElement.style.setProperty('--alto-cabecera', `${cabecera.offsetHeight}px`);
    }).observe(cabecera);
  }
</script>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 20;
    padding: var(--ds-hueco-2) var(--ds-hueco-2) 0;
  }
  .isla {
    position: relative;
    display: flex;
    /* Con letra grande (zoom de texto 200 %) los controles bajan de línea en
       vez de sacar la página de la pantalla; a tamaño normal caben en una. */
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ds-hueco-3);
    max-width: 72rem;
    margin-inline: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--ds-radio-tarjeta);
    padding: 0.6rem 0.9rem;
    background: color-mix(in oklab, var(--color-surface) 82%, transparent);
    box-shadow: var(--ds-sombra-2);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
  }
  @media (min-width: 40rem) {
    .cabecera { padding: var(--ds-hueco-3) var(--ds-hueco-4) 0; }
    .isla { border-radius: var(--ds-radio-pildora); padding: 0.55rem 0.7rem 0.55rem 1.4rem; gap: var(--ds-hueco-6); }
  }
  /* Alto táctil mínimo (44 px) en todos los controles de la isla: logo, menú, lupa, carrito,
     cuenta y botón. La caja crece, el icono y el texto no. */
  .isla > a,
  .isla nav :global(a),
  .isla nav :global(summary),
  .isla nav :global(button) { min-height: var(--ds-toque); align-items: center; }
  /* display solo si no está oculto por una utilidad (p. ej. «hidden sm:inline-flex»). */
  .isla > a:not(.hidden),
  .isla nav :global(a:not(.hidden)),
  .isla nav :global(summary:not(.hidden)),
  .isla nav :global(button:not(.hidden)) { display: inline-flex; }
  .isla nav :global(summary),
  .isla nav :global(button) { min-width: var(--ds-toque); justify-content: center; }
  /* Arriba del todo, sin caja; al bajar 0-96 px aparece el cristal. Solo cambia
     color, borde y sombra: no mueve nada, así que vale también con movimiento reducido. */
  @supports (animation-timeline: scroll()) {
    .isla {
      animation: cristal linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 6rem;
    }
  }
  @keyframes cristal {
    from {
      border-color: transparent;
      background: transparent;
      box-shadow: none;
      backdrop-filter: none;
    }
  }
</style>
