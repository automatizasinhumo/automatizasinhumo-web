---
import type { StorefrontShellModel } from '../../features/storefront/models';
import StoreNav from '../../features/storefront/controls/StoreNav.astro';
import StoreSearch from '../../features/storefront/controls/StoreSearch.astro';
import StoreSearchToggle from '../../features/storefront/controls/StoreSearchToggle.astro';
import StoreCartControl from '../../features/storefront/controls/StoreCartControl.astro';
import StoreAccountControl from '../../features/storefront/controls/StoreAccountControl.astro';
import Logo from './Logo.astro';
import StoreMegaMenu from '../../features/storefront/controls/StoreMegaMenu.astro';
import { menuAreas, coveredByMegaMenu } from './menuAreas';

/**
 * STORE-OWNED. Tema «limpio»: la portada nueva (logo, buscador, Servicios y carrito).
 *
 * It renders on EVERY page, including cart, checkout, payment, account, and
 * Admin login. A broken header is a broken checkout, so keep the core controls
 * below and change their placement and styling rather than their markup.
 *
 * See CUSTOMIZING.md for the full contract.
 */
interface Props {
  model: StorefrontShellModel;
}

const { model } = Astro.props;
// En xl el mega menú «Servicios» sustituye a los enlaces de catálogo y categorías;
// el resto (páginas) sigue en línea. Por debajo de xl, la hamburguesa lleva todos.
// El catálogo vive en / mientras la portada no apunte a otra página.
const shopHref = model.catalogHref;
const pageLinks = model.headerLinks.filter((link) => link.href !== shopHref && !coveredByMegaMenu(link.href));
---

{/* Portada limpia: sin barra de aviso. */}
<header class="sticky top-0 z-20 border-b border-line bg-surface/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-4 sm:gap-6 sm:px-6">
    <a href="/" aria-label={model.storeName} class="shrink-0">
      {
        model.logo ? (
          /* Not lazy: the header logo is above the fold on every page. The
             store name stays the alt text, so the header still reads the
             same to a screen reader or when the image fails. */
          <img src={model.logo.src} alt={model.logo.alt} class="h-8 max-w-48 object-contain sm:h-10" />
        ) : (
          <Logo />
        )
      }
    </a>
    <StoreSearch
      action={model.search.action}
      query={model.search.query}
      class="ml-auto hidden flex-1 justify-end sm:flex"
    />
    {/* ml-auto pins the whole nav to the right edge of the header row, so it
        stays flush right no matter how few items a merchant has.
        min-w-0 is what lets long labels ellipsize instead of overflowing the
        page: flex items default to min-width:auto, and without it here the
        shrink stops at this level and the row grows past the viewport —
        putting min-w-0 only on the links themselves is not enough. */}
    <nav
      aria-label="Principal"
      class="ml-auto flex min-w-0 items-center gap-2 text-sm font-medium text-ink min-[400px]:gap-3 sm:gap-6"
    >
      <StoreMegaMenu
        label="Servicios"
        areas={menuAreas}
        allHref={shopHref}
        allText="Ver todos los servicios"
        links={pageLinks}
        class="hidden xl:flex"
      />
      {/* Sin fila en línea: en xl la sustituye el mega menú; la hamburguesa
          (xl:hidden) sigue llevando todos los enlaces del menú de D1. */}
      <StoreNav links={model.headerLinks} inline={false} />
      {/* The inline field is hidden below sm; the magnifier opens it in place.
          The panel hangs from the sticky header (its positioned ancestor), full
          width minus the gutters, because the magnifier is not at the edge. */}
      <StoreSearchToggle
        action={model.search.action}
        query={model.search.query}
        class="sm:hidden"
        panelClass="absolute inset-x-4 top-full z-40 mt-1 border border-line bg-surface p-3 shadow-lg"
      />
      {model.cart.enabled && <StoreCartControl href={model.cart.href} />}
      {model.account.enabled && <StoreAccountControl href={model.account.href} />}
    </nav>
  </div>
</header>
