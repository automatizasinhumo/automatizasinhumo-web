// Adaptado de mearashadowfax/ScrewFast (MIT)
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { publicOrigin } from '../http/origin';
import { buildPageMetadata } from '../seo/metadata';
import CardBlog from './CardBlog.astro';
import { entriesFor } from './content';

const posts = await entriesFor();
const title = 'Ideas claras para tu web y tu negocio local';
const description =
  'Consejos prácticos para elegir una web, mejorar tu presencia local y conseguir que tus clientes te encuentren en Google.';
const origin = publicOrigin(Astro.url.origin, env.CANONICAL_ORIGIN);
const metadata = buildPageMetadata({
  title,
  description,
  canonical: new URL(Astro.url.pathname, origin).href,
});
const jsonLd = JSON.stringify(metadata.jsonLd).replace(/</g, '\\u003c');
---

<Layout title={metadata.title} description={metadata.description} canonical={metadata.canonical}>
  <script is:inline type="application/ld+json" set:html={jsonLd}></script>
  <section class="fondo-tecnico cabecera-pagina">
    <span class="etiqueta">Guías para decidir con criterio</span>
    <h1 class="mt-4 max-w-3xl font-serif text-4xl font-bold leading-tight text-ink sm:text-5xl">
      Ideas claras para tu web y tu negocio local
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-muted">
      Respuestas prácticas sobre costes, presencia online y SEO local. Sin promesas mágicas ni tecnicismos innecesarios.
    </p>
    <p class="mt-4 text-sm text-muted">
      ¿Quieres ponerlo en práctica? <a href="/elige" class="font-semibold text-brand underline-offset-4 hover:underline">Encuentra el servicio que necesitas →</a>
    </p>
  </section>

  <section class="py-10 sm:py-14" aria-label="Artículos">
    <div class="grid gap-5 md:grid-cols-2">
      {posts.map((post) => <CardBlog blogEntry={post} />)}
    </div>
  </section>
</Layout>
