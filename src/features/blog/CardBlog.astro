// Adaptado de mearashadowfax/ScrewFast (MIT)
import { formatDate, pathFor, type BlogEntry } from './content';

interface Props {
  blogEntry: BlogEntry;
  headingLevel?: 'h2' | 'h3';
}

const { blogEntry, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<a
  class="tarjeta group flex h-full flex-col overflow-hidden transition hover:-translate-y-0.5 hover:shadow-lg"
  href={pathFor(blogEntry)}
>
  <img
    class="aspect-[16/9] w-full object-cover"
    src={blogEntry.data.cardImage}
    alt={blogEntry.data.cardImageAlt}
    width="1200"
    height="675"
    loading="lazy"
  />
  <div class="flex flex-1 flex-col p-5">
    <p class="text-xs font-medium text-muted">
      {formatDate(blogEntry.data.pubDate)} · {blogEntry.data.readTime} min de lectura
    </p>
    <Heading class="mt-2 font-serif text-xl font-semibold text-ink group-hover:text-brand">
      {blogEntry.data.title}
    </Heading>
    <p class="mt-2 flex-1 text-sm leading-6 text-muted">{blogEntry.data.description}</p>
    <span class="mt-4 text-sm font-semibold text-brand">Leer artículo →</span>
  </div>
</a>
