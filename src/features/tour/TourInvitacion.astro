---
/**
 * Tour de bienvenida de la portada con Driver.js (MIT, https://github.com/nilbuild/driver.js).
 * Sale solo una vez por visita, sin que haya que activarlo (src/features/tour/guia.ts): cada
 * ventanita trae la X y «No volver a mostrar». El enlace «Ver guía» del pie (`/#guia`) la
 * reabre siempre. Los pasos salen de src/data/tour.ts; uno cuyo bloque no esté visible se salta.
 * Script empaquetado (sin is:inline) para no sumar excepciones a la CSP.
 */
---

<script>
  import { guiar } from './guia';
  import { ANCLA_TOUR, PASOS_TOUR } from '../../data/tour';

  const pasos = PASOS_TOUR.map((p) => ({ guia: p.id, titulo: p.titulo, texto: p.texto }));
  const abrir = (auto: boolean) => guiar(pasos, { atributo: 'data-tour', clave: 'portada', auto });

  const pedidaPorEnlace = () => {
    if (location.hash !== `#${ANCLA_TOUR}`) return false;
    history.replaceState(null, '', location.pathname + location.search);
    return true;
  };
  window.addEventListener('hashchange', () => {
    if (pedidaPorEnlace()) void abrir(false);
  });
  void abrir(!pedidaPorEnlace());
</script>
