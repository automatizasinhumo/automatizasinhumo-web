---
import type { StorefrontLink } from '../models';
import {
  NavigationMenu,
  NavigationMenuContent,
  NavigationMenuItem,
  NavigationMenuLink,
  NavigationMenuList,
  NavigationMenuTrigger,
} from './starwind/navigation-menu';

/**
 * Mega menú de cabecera: un desplegable de áreas (dos niveles como máximo) más
 * enlaces sueltos. Envuelve el Navigation Menu de Starwind UI (MIT), que trae
 * teclado, Escape y foco. Sin JavaScript el panel no se abre: en xl las categorías
 * solo quedan en /products (pendiente en el backlog #87).
 * Un tema puede pintar su propio panel con el slot «panel» (y su ancho con panelClass);
 * sin slot sale la rejilla de áreas de siempre.
 */
export interface MegaMenuArea {
  title: string;
  href: string;
  items: StorefrontLink[];
}

interface Props {
  label: string;
  areas: MegaMenuArea[];
  allHref: string;
  allText: string;
  links?: StorefrontLink[];
  class?: string;
  panelClass?: string;
}

const { label, areas, allHref, allText, links = [], class: className, panelClass = 'w-[min(46rem,calc(100vw-2rem))] p-5' } = Astro.props;
const panelPropio = Astro.slots.has('panel');
---

<NavigationMenu aria-label={label} class={className}>
  <NavigationMenuList>
    <NavigationMenuItem value="areas">
      <NavigationMenuTrigger>{label}</NavigationMenuTrigger>
      <NavigationMenuContent class={panelClass}>
        {panelPropio ? <slot name="panel" /> : (
        <>
        <div class="grid grid-cols-3 gap-6">
          {
            areas.map((area) => (
              <div>
                <NavigationMenuLink href={area.href} class="font-semibold text-ink">
                  {area.title}
                </NavigationMenuLink>
                <ul class="mt-1">
                  {area.items.map((item) => (
                    <li>
                      <NavigationMenuLink href={item.href} class="text-muted">
                        {item.text}
                      </NavigationMenuLink>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <NavigationMenuLink href={allHref} class="mt-4 border-t border-line pt-3 font-medium text-brand">
          {allText} →
        </NavigationMenuLink>
        </>
        )}
      </NavigationMenuContent>
    </NavigationMenuItem>
    {
      links.map((link) => (
        <NavigationMenuItem>
          <NavigationMenuLink href={link.href}>{link.text}</NavigationMenuLink>
        </NavigationMenuItem>
      ))
    }
  </NavigationMenuList>
</NavigationMenu>

<script>
  import { createNavigationMenu } from '@starwind-ui/runtime/navigation-menu';

  // Atrás/adelante restaura la página desde la bfcache tal como se dejó: con el
  // panel abierto y su estado interno a medias. Se cierra al salir (pagehide) y,
  // por si el navegador guardó la foto antes, también al volver (pageshow).
  const closeAll = () =>
    document
      .querySelectorAll<HTMLElement>('[data-sw-nav-menu]')
      .forEach((root) => createNavigationMenu(root).close());
  window.addEventListener('pagehide', closeAll);
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) closeAll();
  });
</script>
