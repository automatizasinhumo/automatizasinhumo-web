---
/**
 * Página «Demos en vivo»: galería de capturas reales de las plantillas publicadas,
 * con filtro por categoría (chips, sin JS obligatorio: sin JS se ven todas).
 * Datos: src/data/galeria-demos.json (manual/demos/gen-galeria.mjs).
 */
import Icono from '../../components/Icono.astro';
import Captura from './Captura.astro';
import galeria from '../../data/galeria-demos.json';
import { ICONO_CAT } from './iconos';

const { cats, items } = galeria;
const ld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Demos en vivo de Automatiza sin humo',
  itemListElement: items.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: d.titulo, url: d.url })),
});
---

<script is:inline type="application/ld+json" set:html={ld}></script>

<section class="fondo-tecnico rounded-3xl border border-line px-6 py-10 sm:px-10 sm:py-12">
  <span class="etiqueta">{items.length} demos y diseños</span>
  <h1 class="mt-4 max-w-3xl text-4xl font-bold leading-[1.05] text-ink sm:text-5xl">Mira lo que recibes <span class="text-brand">antes de comprar.</span></h1>
  <p class="mt-5 max-w-2xl text-lg text-muted">Las <b class="text-ink">demos interactivas</b> se pueden probar ya, con datos de ejemplo (no se guarda nada). Los <b class="text-ink">diseños de ejemplo</b> enseñan estilos: tu versión lleva tus textos, fotos y colores, en español.</p>
</section>

<div class="sticky top-0 z-10 -mx-4 mt-8 bg-paper/90 px-4 py-3 backdrop-blur" role="toolbar" aria-label="Filtrar demos por categoría">
  <div class="flex gap-2 overflow-x-auto pb-1">
    <button type="button" data-cat="" aria-pressed="true" class="chip-demo">Todas <span class="opacity-70">{items.length}</span></button>
    {cats.map((c) => (
      <button type="button" data-cat={c.slug} aria-pressed="false" class="chip-demo">
        <Icono name={ICONO_CAT[c.slug] ?? 'sparkles'} class="h-4 w-4" />{c.nombre} <span class="opacity-70">{items.filter((i) => i.cat === c.slug).length}</span>
      </button>
    ))}
  </div>
</div>

<ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="galeria-demos">
  {items.map((d) => (
    <li data-cat={d.cat} class="tarjeta group flex flex-col overflow-hidden">
      <a href={d.url} target="_blank" rel="noopener" class="fondo-tecnico relative block border-b border-line px-4 pt-4" aria-label={`${d.tipo === 'interactiva' ? 'Probar demo interactiva' : 'Ver diseño de ejemplo'}: ${d.titulo}`}>
        <span class="block overflow-hidden rounded-t-lg border border-b-0 border-line bg-surface shadow-[0_12px_26px_-18px_rgba(23,45,45,0.55)] transition-transform duration-300 group-hover:-translate-y-1">
          <span class="flex gap-1.5 border-b border-line bg-paper px-3 py-1.5" aria-hidden="true">
            <span class="h-2 w-2 rounded-full bg-accent/70"></span><span class="h-2 w-2 rounded-full bg-line"></span><span class="h-2 w-2 rounded-full bg-line"></span>
          </span>
          <Captura src={`/images/demos/${d.img}.png`} alt={`Captura de la demo ${d.titulo}`} class="aspect-[16/10] w-full object-cover object-top" />
        </span>
        <span class:list={['absolute left-3 top-3 inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-semibold', d.tipo === 'interactiva' ? 'bg-brand text-on-brand' : 'bg-surface/95 text-ink border border-line']}>
          {d.tipo === 'interactiva' ? 'Demo interactiva' : 'Diseño de ejemplo'}
        </span>
        <span class="absolute right-3 top-3 inline-flex items-center gap-1 rounded-full bg-ink/85 px-2.5 py-1 text-xs font-semibold text-white opacity-0 transition-opacity group-hover:opacity-100">
          {d.tipo === 'interactiva' ? 'Probar' : 'Ver'} <Icono name="external-link" class="h-3.5 w-3.5" />
        </span>
      </a>
      <div class="flex flex-1 flex-col p-4">
        <p class="font-semibold text-ink">{d.titulo}</p>
        <a href={`/products/${d.producto}`} class="mt-1 flex-1 text-sm text-muted hover:text-brand">{d.nombre}</a>
        <div class="mt-3 flex items-center justify-between text-sm">
          <span class="font-semibold text-ink">desde {d.precio} € <span class="font-normal text-faint">· {d.plazo}</span></span>
          <a href={`/products/${d.producto}`} class="inline-flex items-center gap-1 font-semibold text-brand">Lo quiero <Icono name="arrow-right" class="h-4 w-4" /></a>
        </div>
      </div>
    </li>
  ))}
</ul>

<section class="mt-14 rounded-3xl border border-line bg-surface px-8 py-8 text-center">
  <p class="text-lg font-semibold text-ink">¿No ves tu caso?</p>
  <p class="mt-1 text-muted">Cuéntanoslo gratis y David te responde con una propuesta y una vista previa. Pagas solo si te gusta.</p>
  <a href="/empezar/consulta" class="mt-4 inline-block rounded-full bg-brand px-6 py-3 text-sm font-semibold text-on-brand hover:bg-brand-hover">Cuéntanos qué necesitas</a>
</section>

<style>
  .chip-demo { display: inline-flex; align-items: center; gap: .4rem; white-space: nowrap; border-radius: 9999px; border: 1px solid var(--color-line, #D5DDD8); background: var(--color-surface, #fff); padding: .45rem .95rem; font-size: .875rem; font-weight: 600; color: var(--color-ink, #172D2D); cursor: pointer; }
  .chip-demo[aria-pressed='true'] { background: var(--color-brand, #176B5A); border-color: var(--color-brand, #176B5A); color: #fff; }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip-demo');
  const tarjetas = document.querySelectorAll<HTMLElement>('#galeria-demos > li');
  chips.forEach((b) => b.addEventListener('click', () => {
    const cat = b.dataset.cat ?? '';
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
    tarjetas.forEach((t) => { t.hidden = !!cat && t.dataset.cat !== cat; });
  }));
</script>
