---
// Adapted from fulldotdev/ui (MIT), services-1.astro. Copyright (c) 2024 Fulldev, Sil Veltman. See licencias/fulldotdev-ui.txt.
import type { HomeService } from '../homeServices';

interface Props {
  services: HomeService[];
}

const { services } = Astro.props;
---

{
  services.length > 0 && (
    <section class="mb-16" aria-labelledby="servicios-necesidad">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <span class="etiqueta">Servicios reales del catálogo</span>
          <h2 id="servicios-necesidad" class="mt-3 text-3xl font-bold text-ink">
            Para empezar hoy
          </h2>
        </div>
        <a href="/products" class="text-sm font-semibold text-brand hover:underline">
          Ver todos los servicios →
        </a>
      </div>
      <ul class="mt-6 grid gap-5 md:grid-cols-3">
        {services.map((service) => (
          <li>
            <a
              href={service.href}
              class="tarjeta group flex h-full flex-col overflow-hidden"
            >
              <img
                src={service.image.src}
                srcset={service.image.srcset}
                sizes={service.image.sizes}
                alt={service.image.alt}
                width="640"
                height="400"
                loading="lazy"
                class="aspect-[16/10] w-full border-b border-line bg-paper object-cover"
              />
              <span class="flex flex-1 flex-col p-5">
                <span class="mb-2 text-xs font-semibold uppercase tracking-wider text-accent">
                  «{service.need}»
                </span>
                <span class="font-serif text-lg font-semibold text-ink">{service.name}</span>
                <span class="mt-1.5 flex-1 text-sm leading-relaxed text-muted">
                  {service.description}
                </span>
                <span class="mt-4 flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm">
                  {service.templatePrice && (
                    <>
                      <span class="font-semibold text-ink">{service.templatePrice}</span>
                      <span class="text-muted">con plantilla y guía</span>
                    </>
                  )}
                  {service.setupPrice && (
                    <>
                      {service.templatePrice && <span class="text-faint" aria-hidden="true">·</span>}
                      <span class="font-semibold text-ink">{service.setupPrice}</span>
                      <span class="text-muted">te lo montamos</span>
                    </>
                  )}
                </span>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand">
                  Ver modalidades
                  <span
                    aria-hidden="true"
                    class="transition-transform group-hover:translate-x-1"
                  >
                    →
                  </span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
