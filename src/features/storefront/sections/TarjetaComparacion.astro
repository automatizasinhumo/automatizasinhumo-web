---
// Adapted from konstantinWDK/astro-components (MIT), PricingCompareMiniCard.astro. Copyright (c) 2026 konstantinwdk. See licencias/astro-components.txt.
interface Props {
  planName: string;
  price: string;
  description: string;
  features: string[];
  featured?: boolean;
}

const { planName, price, description, features, featured = false } = Astro.props;
---

<article
  class:list={[
    'relative flex h-full flex-col rounded-2xl border bg-surface p-6 shadow-sm transition-shadow hover:shadow-md',
    featured ? 'border-brand ring-2 ring-brand/20' : 'border-line',
  ]}
>
  {featured && (
    <span class="absolute -top-3 right-5 rounded-full bg-brand px-3 py-1 text-xs font-semibold text-on-brand">
      Más cómodo
    </span>
  )}
  <header class="border-b border-line pb-5">
    <h3 class="font-serif text-xl font-bold text-ink">{planName}</h3>
    <p class="mt-2 min-h-10 text-sm leading-relaxed text-muted">{description}</p>
    <p class="mt-4 text-3xl font-bold tabular-nums tracking-tight text-ink">
      {price}
      <span class="ml-1 text-xs font-medium tracking-normal text-faint">pago único</span>
    </p>
  </header>
  <ul class="my-5 flex flex-1 flex-col gap-3 text-sm text-muted">
    {features.map((feature) => (
      <li class="flex items-start gap-3">
        <svg
          class="mt-0.5 size-4 shrink-0 text-brand"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m5 12 4 4L19 6" />
        </svg>
        <span>{feature}</span>
      </li>
    ))}
  </ul>
  <a
    href="#comprar"
    class:list={[
      'inline-flex min-h-11 items-center justify-center rounded-full px-5 py-3 text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand',
      featured
        ? 'bg-brand text-on-brand hover:bg-brand-hover'
        : 'border border-brand text-brand hover:bg-brand/5',
    ]}
  >
    Ver opciones de compra
  </a>
</article>
