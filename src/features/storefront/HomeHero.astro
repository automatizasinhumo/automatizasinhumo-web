---
/**
 * Portada de Automatiza sin humo: propuesta de valor, cómo funciona y accesos
 * a las categorías más pedidas. Solo se pinta en la primera página del
 * catálogo en `/` (sin orden ni paginación), para no repetirse al navegar.
 */
const destacados = [
  { href: '/categories/webs', titulo: 'Webs para tu negocio', desde: 'desde 14 €' },
  { href: '/categories/automatizaciones', titulo: 'Automatizaciones', desde: 'desde 99 €' },
  { href: '/categories/documentos', titulo: 'Documentos, PDF e IA', desde: 'desde 29 €' },
  { href: '/categories/planes', titulo: 'Planes mensuales', desde: 'desde 9 €/mes' },
];
const pasos = [
  ['1', 'Eliges', 'Un servicio con precio cerrado y plazo de entrega. Sin presupuestos ni reuniones.'],
  ['2', 'Rellenas campos', 'Un formulario corto con tus textos, colores y datos. Nada técnico.'],
  ['3', 'Lo recibes funcionando', 'Publicado con tu marca, o en plantilla con guía si prefieres montarlo tú.'],
];
---

<section class="mb-16 border-b border-line pb-14">
  <p class="text-xs uppercase tracking-[0.25em] text-muted">Webs y automatizaciones a precio cerrado</p>
  <h1 class="mt-3 max-w-3xl font-serif text-4xl leading-tight tracking-tight sm:text-6xl">
    Tu web, tus reservas y tus tareas repetitivas, resueltas sin humo.
  </h1>
  <p class="mt-5 max-w-2xl text-lg text-muted">
    Más de 70 servicios listos para pymes y autónomos, montados sobre software de código abierto.
    Pagas una vez, sin permanencia, y el resultado es tuyo.
  </p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a href="#catalogo" class="bg-brand px-6 py-3 text-xs uppercase tracking-widest text-on-brand hover:opacity-90">Ver servicios</a>
    <a href="/pages/demos" class="border border-brand px-6 py-3 text-xs uppercase tracking-widest text-brand hover:bg-brand hover:text-on-brand">Ver demos en vivo</a>
  </div>

  <ol class="mt-14 grid gap-8 sm:grid-cols-3">
    {pasos.map(([n, t, d]) => (
      <li>
        <span class="font-serif text-3xl text-muted">{n}</span>
        <h2 class="mt-1 text-sm uppercase tracking-widest">{t}</h2>
        <p class="mt-2 text-sm text-muted">{d}</p>
      </li>
    ))}
  </ol>

  <ul class="mt-12 grid grid-cols-2 gap-4 lg:grid-cols-4">
    {destacados.map((c) => (
      <li>
        <a href={c.href} class="block border border-line p-5 hover:border-brand">
          <span class="block font-serif text-lg leading-snug">{c.titulo}</span>
          <span class="mt-1 block text-xs uppercase tracking-widest text-muted">{c.desde}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
<div id="catalogo"></div>
