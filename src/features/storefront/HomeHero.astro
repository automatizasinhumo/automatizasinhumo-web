---
/**
 * Portada de Automatiza sin humo: propuesta de valor, plantillas reales (capturas
 * de las demos publicadas), cómo funciona y accesos a las categorías más pedidas.
 * Solo se pinta en la primera página del catálogo en `/` (sin orden ni paginación).
 */
import Icono from '../../components/Icono.astro';

const destacados = [
  { href: '/categories/webs', titulo: 'Webs para tu negocio', desde: 'desde 14 €', icono: 'world-www' },
  { href: '/categories/automatizaciones', titulo: 'Automatizaciones', desde: 'desde 99 €', icono: 'route' },
  { href: '/categories/documentos', titulo: 'Documentos, PDF e IA', desde: 'desde 29 €', icono: 'file-text' },
  { href: '/categories/planes', titulo: 'Planes mensuales', desde: 'desde 9 €/mes', icono: 'calendar-repeat' },
];
const pasos = [
  ['01', 'Solicitas', 'Eliges un servicio con precio cerrado y rellenas un formulario corto (2-3 minutos). Sin tarjeta.', 'pencil'],
  ['02', 'Recibes la vista previa', 'David Porto Díaz la prepara con tus datos reales y te la envía en 24-72 h laborables.', 'eye'],
  ['03', 'Decides si pagas', 'Si te gusta, pagas y lo recibes funcionando. Si no te convence, no pagas nada.', 'cash'],
];
// Nivel A de manual/catalogo/entrega.mjs: salen con un prompt y se entregan el mismo día.
const rapidos = [
  { slug: 'web-una-pagina', necesidad: 'Necesito estar en internet', nombre: 'Web de una página', precio: 149, plazo: '48 h', icono: 'world-www', captura: 'cafe-coffee-shop', texto: 'Tu negocio en una página clara, con contacto y mapa, publicada con tu marca.' },
  { slug: 'carta-qr', necesidad: 'Quiero dejar de reimprimir la carta', nombre: 'Carta digital con QR', precio: 49, plazo: '24 h', icono: 'qrcode', captura: 'carta-whatsapp', texto: 'La carta en el móvil del cliente. Cambias precios sin reimprimir.' },
  { slug: 'tarjeta-digital', necesidad: 'Quiero que me encuentren fácil', nombre: 'Tarjeta de visita digital', precio: 29, plazo: '24 h', icono: 'id-badge-2', captura: 'link-in-bio', texto: 'Un enlace y un QR con tus datos, redes y botón de guardar contacto.' },
];
const ventajas = [
  ['Precio cerrado', 'Ves el precio antes de pagar. No hay presupuestos que crecen ni horas extra.', 'receipt-euro'],
  ['Pruebas antes de pagar', 'Primero ves una vista previa con tus datos. Si no te convence, no pagas nada.', 'eye'],
  ['Una persona detrás', 'Te atiende David Porto Díaz, no un robot. Te responde cualquier duda, rápido y sin tecnicismos.', 'mood-smile'],
  ['Es tuyo', 'Accesos a tu nombre y sin cuotas obligatorias. Sin permanencia.', 'lock-open'],
];
const faq = [
  ['¿Tengo que pagar antes?', 'No. Empiezas gratis rellenando los datos, te enviamos una vista previa y solo pagas si te gusta.'],
  ['¿Es solo para empresas?', 'No. También para particulares: bodas, cumpleaños, eventos, asociaciones o un proyecto personal.'],
  ['¿Qué diferencia hay entre «Plantilla + guía» y «Te lo montamos»?', 'Con «Plantilla + guía» recibes la plantilla rellenada y una guía paso a paso para publicarla. Con «Te lo montamos» te la entregamos publicada y funcionando.'],
  ['¿Y si necesito cambios?', 'Los ajustes sobre lo que has pedido están incluidos. Contesta al email de entrega y los hacemos.'],
  ['¿Tengo que pagar algo cada mes?', 'No. Casi todo se publica en planes gratuitos. Si algo necesita una cuenta de pago, lo verás en la ficha antes de comprar.'],
];
// Capturas reales de plantillas publicadas en el worker de demos.
const muestras = [
  { src: '/images/demos/carta-whatsapp.png', alt: 'Carta digital con pedido por WhatsApp' },
  { src: '/images/demos/boda-sage.png', alt: 'Web de boda con confirmación de asistencia' },
  { src: '/images/demos/real-estate-agency.png', alt: 'Web de inmobiliaria con fichas de pisos' },
];
---

<section class="fondo-tecnico mb-16 rounded-3xl border border-line px-6 py-10 sm:px-10 sm:py-14">
  <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <span class="etiqueta">Webs y automatizaciones a precio cerrado</span>
      <h1 class="mt-4 max-w-2xl text-4xl font-bold leading-[1.05] text-ink sm:text-[3.4rem]">
        Tu web, tus reservas y tus tareas repetitivas, <span class="text-brand">resueltas sin humo.</span>
      </h1>
      <p class="mt-5 max-w-xl text-lg text-muted">
        Más de 70 servicios para negocios, autónomos y particulares (bodas, eventos, asociaciones…).
        Sin complicaciones, rápido y con una persona que te responde. Empiezas gratis y pagas solo si te gusta.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#catalogo" class="rounded-full bg-brand px-6 py-3 text-sm font-semibold text-on-brand hover:bg-brand-hover">Elegir servicio</a>
        <a href="/empezar/consulta" class="rounded-full border border-brand bg-surface px-6 py-3 text-sm font-semibold text-brand hover:bg-brand hover:text-on-brand">Cuéntanos qué necesitas →</a>
      </div>
      <ul class="mt-6 flex flex-wrap gap-2 text-sm font-medium text-ink">
        <li class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1.5"><Icono name="shield-check" class="h-4 w-4 text-brand" /> Sin pago por adelantado</li>
        <li class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1.5"><Icono name="mood-smile" class="h-4 w-4 text-brand" /> Atendido por una persona real</li>
        <li class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1.5"><Icono name="receipt-euro" class="h-4 w-4 text-brand" /> Precio cerrado</li>
      </ul>
    </div>

    <a href="/pages/demos" class="relative mx-auto block h-[300px] w-full max-w-[520px] sm:h-[360px]" aria-label="Ver las demos en vivo">
      {/* Móvil en primer plano: la mayoría de clientes verá su web en el teléfono. */}
      <figure class="absolute bottom-0 right-[2%] z-10 w-[29%] overflow-hidden rounded-[1.4rem] border-[5px] border-ink bg-ink shadow-[0_22px_40px_-18px_rgba(23,45,45,0.6)]" aria-hidden="true">
        <span class="mx-auto my-1 block h-1.5 w-8 rounded-full bg-paper/30"></span>
        <img src="/images/demos/link-in-bio.png" alt="" width="1280" height="860" loading="eager" class="aspect-[9/17] w-full rounded-b-[1rem] object-cover object-[50%_0]" />
      </figure>
      <span class="absolute -bottom-3 left-2 z-10 inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1 text-xs font-semibold text-ink shadow-sm">
        <Icono name="player-play" class="h-3.5 w-3.5 text-brand" /> Ver demos en vivo
      </span>
      {muestras.map((m, i) => (
        <figure
          class="absolute overflow-hidden rounded-2xl border border-line bg-surface shadow-[0_18px_40px_-20px_rgba(23,45,45,0.45)]"
          style={[
            'left:0;top:28px;width:62%;transform:rotate(-3deg);z-index:1',
            'right:0;top:0;width:62%;transform:rotate(2.5deg);z-index:2',
            'left:8%;bottom:0;width:62%;z-index:3',
          ][i]}
        >
          <div class="flex gap-1.5 border-b border-line bg-paper px-3 py-2">
            <span class="h-2 w-2 rounded-full bg-accent/70"></span>
            <span class="h-2 w-2 rounded-full bg-line"></span>
            <span class="h-2 w-2 rounded-full bg-line"></span>
          </div>
          <img src={m.src} alt={m.alt} width="1280" height="860" loading="eager" class="aspect-[16/10] w-full object-cover object-top" />
        </figure>
      ))}
    </a>
  </div>

  <h2 class="mt-14 text-center text-sm font-semibold uppercase tracking-widest text-brand">Así funciona · pagas al final</h2>
  <ol class="mt-4 grid gap-4 sm:grid-cols-3">
    {pasos.map(([n, t, d, ico], i) => (
      <li class="tarjeta relative p-5">
        {i < pasos.length - 1 && (
          <span class="absolute -right-3 top-1/2 z-10 hidden h-6 w-6 -translate-y-1/2 place-items-center rounded-full border border-line bg-surface text-brand sm:grid" aria-hidden="true"><Icono name="arrow-right" class="h-3.5 w-3.5" /></span>
        )}
        <span class="flex items-center justify-between">
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-brand/10 text-brand"><Icono name={ico} class="h-6 w-6" /></span>
          <span class="font-serif text-sm font-bold text-accent">{n}</span>
        </span>
        <h3 class="mt-3 text-lg font-semibold text-ink">{t}</h3>
        <p class="mt-1.5 text-sm text-muted">{d}</p>
      </li>
    ))}
  </ol>

  <ul class="mt-4 grid grid-cols-2 gap-4 lg:grid-cols-4">
    {destacados.map((c) => (
      <li>
        <a href={c.href} class="tarjeta group block h-full p-5">
          <span class="mb-3 grid h-10 w-10 place-items-center rounded-full border border-line bg-paper text-brand transition-colors group-hover:bg-brand group-hover:text-on-brand"><Icono name={c.icono} class="h-5 w-5" /></span>
          <span class="block font-serif text-lg font-semibold leading-snug text-ink">{c.titulo}</span>
          <span class="mt-2 inline-block text-sm font-medium text-brand">{c.desde} →</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<section class="mb-16" aria-labelledby="rapidos-titulo">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <span class="etiqueta">Listos en 24–48 h</span>
      <h2 id="rapidos-titulo" class="mt-3 text-3xl font-bold text-ink">Para empezar hoy</h2>
    </div>
    <a href="/products" class="text-sm font-semibold text-brand hover:underline">Ver los 71 servicios →</a>
  </div>
  <ul class="mt-6 grid gap-5 md:grid-cols-3">
    {rapidos.map((p) => (
      <li>
        <a href={`/products/${p.slug}`} class="tarjeta group flex h-full flex-col overflow-hidden">
          <span class="fondo-tecnico relative block border-b border-line px-5 pt-12">
            <span class="block overflow-hidden rounded-t-xl border border-b-0 border-line bg-surface shadow-[0_14px_30px_-18px_rgba(23,45,45,0.5)] transition-transform duration-300 group-hover:-translate-y-1">
              <span class="flex gap-1.5 border-b border-line bg-paper px-3 py-2" aria-hidden="true">
                <span class="h-2 w-2 rounded-full bg-accent/70"></span><span class="h-2 w-2 rounded-full bg-line"></span><span class="h-2 w-2 rounded-full bg-line"></span>
              </span>
              <img src={`/images/demos/${p.captura}.png`} alt={`Ejemplo real: ${p.nombre}`} width="1280" height="860" loading="lazy" class="aspect-[16/10] w-full object-cover object-top" />
            </span>
            <span class="absolute left-4 top-3 inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1 text-xs font-semibold text-ink shadow-sm">
              <Icono name="clock" class="h-3.5 w-3.5 text-brand" /> Entrega en {p.plazo}
            </span>
          </span>
          <span class="flex flex-1 flex-col p-5">
            <span class="mb-2 text-xs font-semibold uppercase tracking-wider text-accent">«{p.necesidad}»</span>
            <span class="flex items-center gap-2.5 font-serif text-lg font-semibold text-ink">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-brand/10 text-brand"><Icono name={p.icono} class="h-5 w-5" /></span>{p.nombre}
            </span>
            <span class="mt-1.5 flex-1 text-sm text-muted">{p.texto}</span>
            <span class="mt-4 flex items-center justify-between text-sm">
              <span class="font-semibold text-ink">desde {p.precio} €</span>
              <span class="inline-flex items-center gap-1 font-semibold text-brand">Ver ficha <Icono name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" /></span>
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<section class="mb-16 grid gap-10 lg:grid-cols-[1fr_1.2fr]">
  <div>
    <h2 class="text-3xl font-bold text-ink">Por qué sin humo</h2>
    <dl class="mt-6 space-y-5">
      {ventajas.map(([t, d, ico]) => (
        <div class="flex gap-4">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-accent/10 text-accent"><Icono name={ico} class="h-6 w-6" /></span>
          <div>
            <dt class="font-semibold text-ink">{t}</dt>
            <dd class="mt-1 text-sm text-muted">{d}</dd>
          </div>
        </div>
      ))}
    </dl>
  </div>
  <div>
    <h2 class="text-3xl font-bold text-ink">Preguntas rápidas</h2>
    <div class="mt-6 divide-y divide-line border-y border-line">
      {faq.map(([q, a]) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink">
            {q}<span class="text-brand transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-2 text-sm text-muted">{a}</p>
        </details>
      ))}
    </div>
    <a href="/pages/preguntas-frecuentes" class="mt-4 inline-block text-sm font-semibold text-brand hover:underline">Todas las preguntas →</a>
  </div>
</section>
<div id="catalogo"></div>
