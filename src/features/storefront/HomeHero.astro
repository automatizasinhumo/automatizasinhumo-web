---
/**
 * Portada de Automatiza sin humo: propuesta de valor, plantillas reales (capturas
 * de las demos publicadas), cómo funciona y accesos a las categorías más pedidas.
 * Solo se pinta en la primera página del catálogo en `/` (sin orden ni paginación).
 */
import Icono from '../../components/Icono.astro';
import Captura from './Captura.astro';
import ServiciosPorNecesidad from './sections/ServiciosPorNecesidad.astro';
import type { HomeService } from './homeServices';

interface Props {
  services: HomeService[];
}

const { services } = Astro.props;
// Precio «desde» de los destacados, leído del catálogo (no escrito a mano): así la
// primera pantalla dice qué vendemos y cuánto cuesta, y no se queda desfasada.
const precios = services
  .map((s) => ({ name: s.name, href: s.href, desde: s.fromPrice }))
  .filter((s): s is { name: string; href: string; desde: string } => s.desde !== null);

const destacados = [
  { href: '/servicios/web', titulo: 'Webs para tu negocio', desde: 'desde 49 €', icono: 'world-www' },
  { href: '/categories/automatizaciones', titulo: 'Automatizaciones', desde: 'desde 99 €', icono: 'route' },
  { href: '/categories/documentos', titulo: 'Documentos, PDF e IA', desde: 'desde 29 €', icono: 'file-text' },
  { href: '/categories/planes', titulo: 'Planes mensuales', desde: 'desde 9 €/mes', icono: 'calendar-repeat' },
];
const pasos = [
  ['01', 'Eliges cómo empezar', 'Puedes contratar el servicio directamente o pedir una prueba gratuita, sin tarjeta.', 'pencil'],
  ['02', 'Lo ves terminado al momento', 'Webs y CV se montan solos mientras escribes; los servicios a medida, en 24–72 h laborables.', 'eye'],
  ['03', 'Lo revisas y lo recibes', 'Publicado o con una guía para publicarlo tú, según la modalidad. Si empezaste gratis, pagas solo si te gusta.', 'cash'],
];
const ventajas = [
  ['Precio cerrado', 'Ves el precio antes de pagar. No hay presupuestos que crecen ni horas extra.', 'receipt-euro'],
  ['Descubre el servicio antes de contratarlo', 'Puedes tocar demos reales de nuestros servicios. Y si prefieres, pides una vista previa gratis con tus datos.', 'eye'],
  ['Una persona detrás', 'Te atiende David Porto Díaz, no un robot. Te responde cualquier duda, rápido y sin tecnicismos.', 'mood-smile'],
  ['Es tuyo', 'Los servicios de pago único no tienen cuota con nosotros. Si hay costes externos, se indican antes de comprar.', 'lock-open'],
];
const faq = [
  ['¿Tengo que pagar antes?', 'Tú eliges. Puedes contratarlo directamente con tarjeta (con garantía de devolución de 7 días) o pedir una vista previa gratis y pagar solo si te gusta.'],
  ['¿Es solo para empresas?', 'No. También para particulares: bodas, cumpleaños, eventos, asociaciones o un proyecto personal.'],
  ['¿Qué diferencia hay entre «Plantilla + guía» y «Te lo montamos»?', 'Con «Plantilla + guía» recibes la plantilla rellenada y una guía paso a paso para publicarla. Con «Te lo montamos» te la entregamos publicada y funcionando.'],
  ['¿Y si necesito cambios?', 'Tienes una ronda de ajustes incluida, que puedes solicitar durante los siete días siguientes a la primera versión.'],
  ['¿Tengo que pagar algo cada mes?', 'No. Casi todo se publica en planes gratuitos. Si algo necesita una cuenta de pago, lo verás en la ficha antes de comprar.'],
];
// Capturas reales de plantillas publicadas en el worker de demos.
const muestras = [
  { src: '/images/demos/es-casa-remedios.png', alt: 'Web de bar con la carta y pedido por WhatsApp' },
  { src: '/images/demos/es-clinica-dental.png', alt: 'Web de clínica dental con cita previa' },
  { src: '/images/demos/es-taller.png', alt: 'Web de taller mecánico con presupuesto previo' },
];
---

<section class="fondo-tecnico cabecera-pagina mb-16">
  <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <span class="etiqueta">Webs, reservas y automatizaciones a precio cerrado</span>
      <h1 class="mt-4 max-w-2xl text-4xl font-bold leading-[1.05] text-ink sm:text-[3.4rem]">
        Tu negocio, tu evento o tu idea, <span class="text-brand">en marcha sin complicaciones.</span>
      </h1>
      <p class="mt-5 max-w-xl text-lg text-muted">
        Soluciones digitales para tu negocio, tu evento o tu proyecto: webs, reservas, cartas QR, invitaciones y automatizaciones a precio cerrado.
        Elige entre hacerlo con nuestra guía o recibirlo listo para usar. Compra directamente o pide una muestra gratis. Te atiende una persona.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#catalogo" class="boton boton-principal">Elegir servicio</a>
        <a href="/empezar/consulta" data-tour="consulta" class="boton boton-secundario">Cuéntanos qué necesitas →</a>
      </div>
      <p class="mt-3 text-sm text-muted">¿No sabes cuál elegir? <a href="/elige" class="font-semibold text-brand underline-offset-2 hover:underline">Responde tres preguntas</a> y te lo decimos.</p>
      {precios.length > 0 && (
        <p class="mt-5 text-sm text-muted" data-precios-hero>
          Por ejemplo:{' '}
          {precios.map((p, i) => (
            <>
              <a href={p.href} class="font-semibold text-ink underline decoration-brand/40 underline-offset-2 hover:text-brand">{p.name}</a>{' '}
              desde <strong class="text-ink">{p.desde}</strong>{i < precios.length - 1 ? ' · ' : '.'}
            </>
          ))}
        </p>
      )}
      <ul class="mt-6 flex flex-wrap gap-2 text-sm font-medium text-ink">
        <li class="pildora"><Icono name="shield-check" class="h-4 w-4 text-brand" /> La muestra es gratuita y no necesitas tarjeta</li>
        <li class="pildora"><Icono name="mood-smile" class="h-4 w-4 text-brand" /> Atendido por una persona real</li>
        <li class="pildora"><Icono name="receipt-euro" class="h-4 w-4 text-brand" /> Precio cerrado</li>
      </ul>
    </div>

    <a href="/pages/demos" data-tour="vista-previa" class="relative mx-auto block h-[300px] w-full max-w-[520px] sm:h-[360px]" aria-label="Ver las demos en vivo">
      {/* Móvil en primer plano: la mayoría de clientes verá su web en el teléfono. */}
      <figure class="absolute bottom-0 right-[2%] z-10 w-[29%] overflow-hidden rounded-[1.4rem] border-[5px] border-ink bg-ink shadow-[0_22px_40px_-18px_rgba(23,45,45,0.6)]" aria-hidden="true">
        <span class="mx-auto my-1 block h-1.5 w-8 rounded-full bg-paper/30"></span>
        <Captura src="/images/demos/es-movil-peluqueria.png" alt="" loading="eager" sizes="(min-width: 1024px) 220px, 50vw" class="aspect-[9/17] w-full rounded-b-[1rem] object-cover object-[50%_0]" />
      </figure>
      <span class="absolute -bottom-3 left-2 z-10 pildora pildora-flotante">
        <Icono name="player-play" class="h-3.5 w-3.5 text-brand" /> Ver demos en vivo
      </span>
      {muestras.map((m, i) => (
        <figure
          class="absolute overflow-hidden rounded-2xl border border-line bg-surface shadow-[0_18px_40px_-20px_rgba(23,45,45,0.45)]"
          style={[
            'left:0;top:28px;width:62%;transform:rotate(-3deg);z-index:1',
            'right:0;top:0;width:62%;transform:rotate(2.5deg);z-index:2',
            'left:8%;bottom:0;width:62%;z-index:3',
          ][i]}
        >
          <div class="flex gap-1.5 border-b border-line bg-paper px-3 py-2">
            <span class="h-2 w-2 rounded-full bg-accent/70"></span>
            <span class="h-2 w-2 rounded-full bg-line"></span>
            <span class="h-2 w-2 rounded-full bg-line"></span>
          </div>
          <Captura src={m.src} alt={m.alt} loading="eager" sizes="(min-width: 1024px) 260px, 62vw" class="aspect-[16/10] w-full object-cover object-top" />
        </figure>
      ))}
    </a>
  </div>

  <h2 class="mt-14 text-center text-sm font-semibold uppercase tracking-widest text-brand">Así funciona · dos formas de empezar</h2>
  <ol data-tour="modalidades" class="mt-4 grid gap-4 sm:grid-cols-3">
    {pasos.map(([n, t, d, ico], i) => (
      <li class="tarjeta relative p-5">
        {i < pasos.length - 1 && (
          <span class="absolute -right-3 top-1/2 z-10 hidden h-6 w-6 -translate-y-1/2 place-items-center rounded-full border border-line bg-surface text-brand sm:grid" aria-hidden="true"><Icono name="arrow-right" class="h-3.5 w-3.5" /></span>
        )}
        <span class="flex items-center justify-between">
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-brand/10 text-brand"><Icono name={ico} class="h-6 w-6" /></span>
          <span class="font-serif text-sm font-bold text-accent">{n}</span>
        </span>
        <h3 class="mt-3 text-lg font-semibold text-ink">{t}</h3>
        <p class="mt-1.5 text-sm text-muted">{d}</p>
      </li>
    ))}
  </ol>

  <ul class="mt-4 grid grid-cols-2 gap-4 lg:grid-cols-4">
    {destacados.map((c) => (
      <li>
        <a href={c.href} class="tarjeta group block h-full p-5">
          <span class="mb-3 grid h-10 w-10 place-items-center rounded-full border border-line bg-paper text-brand transition-colors group-hover:bg-brand group-hover:text-on-brand"><Icono name={c.icono} class="h-5 w-5" /></span>
          <span class="block font-serif text-lg font-semibold leading-snug text-ink">{c.titulo}</span>
          <span class="mt-2 inline-block text-sm font-medium text-brand">{c.desde} →</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<ServiciosPorNecesidad services={services} />

<section class="mb-16 grid gap-10 lg:grid-cols-[1fr_1.2fr]">
  <div>
    <h2 class="text-3xl font-bold text-ink">Por qué sin humo</h2>
    <ul class="mt-6 space-y-5">
      {ventajas.map(([t, d, ico]) => (
        <li class="flex gap-4">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-accent/10 text-accent" aria-hidden="true"><Icono name={ico} class="h-6 w-6" /></span>
          <div>
            <p class="font-semibold text-ink">{t}</p>
            <p class="mt-1 text-sm text-muted">{d}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
  <div>
    <h2 class="text-3xl font-bold text-ink">Preguntas rápidas</h2>
    <div class="mt-6 divide-y divide-line border-y border-line">
      {faq.map(([q, a]) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink">
            {q}<span class="text-brand transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-2 text-sm text-muted">{a}</p>
        </details>
      ))}
    </div>
    <a href="/pages/preguntas-frecuentes" class="mt-4 inline-block text-sm font-semibold text-brand hover:underline">Todas las preguntas →</a>
  </div>
</section>
<div id="catalogo"></div>
