---
/**
 * Portada de Automatiza sin humo: propuesta de valor, plantillas reales (capturas
 * de las demos publicadas), cómo funciona y accesos a las categorías más pedidas.
 * Solo se pinta en la primera página del catálogo en `/` (sin orden ni paginación).
 */
const destacados = [
  { href: '/categories/webs', titulo: 'Webs para tu negocio', desde: 'desde 14 €' },
  { href: '/categories/automatizaciones', titulo: 'Automatizaciones', desde: 'desde 99 €' },
  { href: '/categories/documentos', titulo: 'Documentos, PDF e IA', desde: 'desde 29 €' },
  { href: '/categories/planes', titulo: 'Planes mensuales', desde: 'desde 9 €/mes' },
];
const pasos = [
  ['01', 'Eliges', 'Un servicio con precio cerrado y plazo de entrega. Sin presupuestos ni reuniones.'],
  ['02', 'Rellenas campos', 'Un formulario corto con tus textos, colores y datos. Nada técnico.'],
  ['03', 'Lo recibes funcionando', 'Publicado con tu marca, o en plantilla con guía si prefieres montarlo tú.'],
];
// Capturas reales de plantillas publicadas en el worker de demos.
const muestras = [
  { src: '/images/demos/carta-whatsapp.png', alt: 'Carta digital con pedido por WhatsApp' },
  { src: '/images/demos/boda-sage.png', alt: 'Web de boda con confirmación de asistencia' },
  { src: '/images/demos/inmobiliaria.png', alt: 'Web de inmobiliaria con fichas de pisos' },
];
---

<section class="fondo-tecnico mb-16 rounded-3xl border border-line px-6 py-10 sm:px-10 sm:py-14">
  <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <span class="etiqueta">Webs y automatizaciones a precio cerrado</span>
      <h1 class="mt-4 max-w-2xl text-4xl font-bold leading-[1.05] text-ink sm:text-[3.4rem]">
        Tu web, tus reservas y tus tareas repetitivas, <span class="text-brand">resueltas sin humo.</span>
      </h1>
      <p class="mt-5 max-w-xl text-lg text-muted">
        Más de 70 servicios para pymes y autónomos, montados sobre software de código abierto.
        Pagas una vez, sin permanencia, y el resultado es tuyo.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#catalogo" class="rounded-full bg-brand px-6 py-3 text-sm font-semibold text-on-brand hover:bg-brand-hover">Ver servicios</a>
        <a href="/pages/demos" class="rounded-full border border-brand bg-surface px-6 py-3 text-sm font-semibold text-brand hover:bg-brand hover:text-on-brand">Ver demos en vivo →</a>
      </div>
      <p class="mt-5 text-sm text-faint">Plantillas reales · Entrega en días · Sin cuotas obligatorias</p>
    </div>

    <a href="/pages/demos" class="relative mx-auto block h-[300px] w-full max-w-[520px] sm:h-[360px]" aria-label="Ver las demos en vivo">
      {muestras.map((m, i) => (
        <figure
          class="absolute overflow-hidden rounded-2xl border border-line bg-surface shadow-[0_18px_40px_-20px_rgba(23,45,45,0.45)]"
          style={[
            'left:0;top:28px;width:62%;transform:rotate(-3deg);z-index:1',
            'right:0;top:0;width:62%;transform:rotate(2.5deg);z-index:2',
            'left:19%;bottom:0;width:62%;z-index:3',
          ][i]}
        >
          <div class="flex gap-1.5 border-b border-line bg-paper px-3 py-2">
            <span class="h-2 w-2 rounded-full bg-accent/70"></span>
            <span class="h-2 w-2 rounded-full bg-line"></span>
            <span class="h-2 w-2 rounded-full bg-line"></span>
          </div>
          <img src={m.src} alt={m.alt} width="1280" height="860" loading="eager" class="aspect-[16/10] w-full object-cover object-top" />
        </figure>
      ))}
    </a>
  </div>

  <ol class="mt-14 grid gap-4 sm:grid-cols-3">
    {pasos.map(([n, t, d]) => (
      <li class="tarjeta p-5">
        <span class="font-serif text-sm font-bold text-accent">{n}</span>
        <h2 class="mt-1 text-lg font-semibold text-ink">{t}</h2>
        <p class="mt-1.5 text-sm text-muted">{d}</p>
      </li>
    ))}
  </ol>

  <ul class="mt-4 grid grid-cols-2 gap-4 lg:grid-cols-4">
    {destacados.map((c) => (
      <li>
        <a href={c.href} class="tarjeta block h-full p-5">
          <span class="block font-serif text-lg font-semibold leading-snug text-ink">{c.titulo}</span>
          <span class="mt-2 inline-block text-sm font-medium text-brand">{c.desde} →</span>
        </a>
      </li>
    ))}
  </ul>
</section>
<div id="catalogo"></div>
