---
export const prerender = false;
import Layout from '../layouts/Layout.astro';

// Reached from the cart when a buyer taps a payment method that isn't configured
// yet. It's owner-facing setup help — how to turn that rail on — so the store can
// graduate from Demo to real payments without leaving a dead button.
const method = (Astro.url.searchParams.get('method') ?? '').toLowerCase();
const origin = Astro.url.origin;

interface Guide {
  title: string;
  intro: string;
  steps: string[];
}
const GUIDES: Record<string, Guide> = {
  stripe: {
    title: 'Cómo configurar los pagos con tarjeta de Stripe',
    intro: 'Acepta pagos con Visa, Mastercard y Apple Pay a través de Stripe.',
    steps: [
      'Crea una cuenta de Stripe y obtén la clave secreta en dashboard.stripe.com/apikeys.',
      'Pégala en Administración → Ajustes → Claves de pago (clave secreta de Stripe). Se guarda cifrada en la base de datos.',
      `Añade en Stripe una dirección de webhook que apunte a ${origin}/api/webhook/stripe. Suscríbete a checkout.session.completed, checkout.session.async_payment_succeeded y charge.refunded; el último sincroniza con tus pedidos los reembolsos que hagas en el panel de Stripe.`,
      'Pega el secreto de firma en Claves de pago (secreto de firma del webhook de Stripe). El botón para pagar con tarjeta se activará automáticamente.',
    ],
  },
  lightning: {
    title: 'Configurar pagos con Lightning',
    intro: 'Acepta pagos instantáneos con Bitcoin Lightning desde cualquier cartera.',
    steps: [
      'Instala una instancia de LNbits o un nodo phoenixd.',
      'En Administración → Ajustes → Pagos, selecciona Lightning como método predeterminado y elige el nodo (LNbits o phoenixd).',
      'Introduce la URL del nodo en la configuración de pagos y la clave (clave de factura/lectura de LNbits o contraseña de phoenixd) en Claves de pago. El botón de Lightning se activará automáticamente.',
    ],
  },
  opennode: {
    title: 'Configurar pagos con Bitcoin (OpenNode)',
    intro: 'Acepta pagos alojados en cadena o con Lightning mediante OpenNode.',
    steps: [
      'Crea una cuenta de OpenNode y genera una clave de API.',
      'Pégala en Administración → Ajustes → Claves de pago (clave de API de OpenNode).',
      `Configura el webhook para que apunte a ${origin}/api/webhook/opennode y selecciona OpenNode como método predeterminado en Ajustes → Pagos.`,
    ],
  },
};
const guide = GUIDES[method] ?? null;
---

<Layout title="Configurar pagos" description="Cómo activar un método de pago.">
  <div class="mx-auto max-w-xl py-8">
    <a href="/cart" class="text-xs uppercase tracking-widest text-faint hover:text-brand">
      &larr; Volver al carrito
    </a>

    {
      guide ? (
        <>
          <h1 class="mt-4 font-serif text-3xl tracking-tight">{guide.title}</h1>
          <p class="mt-3 text-muted">{guide.intro}</p>
          <ol class="mt-6 space-y-3">
            {guide.steps.map((s, i) => (
              <li class="flex gap-3 text-sm">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand/10 text-xs font-medium text-brand">
                  {i + 1}
                </span>
                <span class="pt-0.5 text-muted">{s}</span>
              </li>
            ))}
          </ol>
        </>
      ) : (
        <>
          <h1 class="mt-4 font-serif text-3xl tracking-tight">Configurar pagos</h1>
          <p class="mt-3 text-muted">
            Este método de pago aún no está configurado. Añade un método real (tarjeta o Lightning)
            en Administración → Ajustes → Pagos, o sigue usando el Pago de prueba (sin cargo).
          </p>
        </>
      )
    }

    <div class="mt-8 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-800">
      Mientras tanto, el <strong class="font-semibold">Pago de prueba (sin cargo)</strong> ya está disponible:
      crea un pedido real marcado como prueba para que puedas recorrer el proceso completo sin que se cobre nada.
    </div>
  </div>
</Layout>
