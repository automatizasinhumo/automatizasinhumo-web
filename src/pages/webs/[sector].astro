---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { addCacheTags, productCacheTags } from '../../features/cache/tags';
import { publicOrigin } from '../../features/http/origin';
import { buildPageMetadata } from '../../features/seo/metadata';
import { getSector, SECTORS, servicesForSector } from '../../features/blog/sectors';
import { getConfig } from '../../config';
import { breadcrumbJsonLd } from '../../features/storefront/breadcrumbs';
import { fuentesMuestras, miniaturaMuestra, muestrasDeSector } from '../../features/servicios/muestrasSector';

const sector = getSector(Astro.params.sector);
if (!sector) {
  return new Response('Sector no encontrado', {
    status: 404,
    headers: { 'cache-control': 'no-store' },
  });
}

const services = await servicesForSector(env.DB, sector, getConfig().currency);
// El primer servicio del sector es su web principal: a él lleva «Empieza gratis».
const principal = services[0];
addCacheTags(
  Astro.response.headers,
  productCacheTags(services.map((service) => service.publicId)),
);
const origin = publicOrigin(Astro.url.origin, env.CANONICAL_ORIGIN);
const canonicalPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const metadata = buildPageMetadata({
  title: sector.title,
  description: sector.description,
  canonical: new URL(canonicalPath, origin).href,
});
const breadcrumb = breadcrumbJsonLd(
  [{ text: 'Inicio', href: '/' }, { text: sector.heading, href: null }],
  origin,
  metadata.canonical,
);
const muestras = muestrasDeSector(sector.label);
const estudio = muestras[0]?.enlace ?? '/servicios/web';
const jsonLd = JSON.stringify([metadata.jsonLd, breadcrumb].flat()).replace(/</g, '\\u003c');
---

<Layout title={metadata.title} description={metadata.description} canonical={metadata.canonical}>
  <script is:inline type="application/ld+json" set:html={jsonLd}></script>
  <section class="fondo-tecnico cabecera-pagina">
    <span class="etiqueta">Webs para negocios locales</span>
    <h1 class="mt-4 max-w-3xl font-serif text-4xl font-bold leading-tight text-ink sm:text-5xl">
      {sector.heading}
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-7 text-muted">{sector.introduction}</p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a href={estudio} class="boton boton-principal">Diseña tu web ahora →</a>
      {principal && (
        <a
          href={`/empezar/${principal.slug}`}
          class="boton boton-secundario"
        >
          Empieza gratis: {principal.name} →
        </a>
      )}
      <a
        href="/empezar/consulta"
        class="boton boton-secundario"
      >
        Cuéntanos qué necesitas
      </a>
    </div>
    {principal && (
      <p class="mt-3 text-sm text-muted">Sin tarjeta: primero ves la muestra y después decides. Desde {principal.formattedPrice}.</p>
    )}
  </section>

  {muestras.length > 0 && (
    <section class="py-10 sm:py-12" aria-labelledby="muestras">
      <style is:inline set:html={fuentesMuestras(muestras)}></style>
      <h2 id="muestras" class="font-serif text-2xl font-bold text-ink">Así puede quedar tu web</h2>
      <p class="mt-2 max-w-2xl text-muted">Tres diseños pensados para {sector.label.toLowerCase()}, ya con textos de ejemplo. Elige uno y cámbialo todo en el estudio: nombre, fotos, colores y servicios.</p>
      <ul class="mt-6 grid gap-6 sm:grid-cols-3" data-muestras>
        {muestras.map((m) => (
          <li class="overflow-hidden rounded-2xl border border-line bg-surface">
            <div class="border-b border-line" aria-hidden="true" inert set:html={`<div>${miniaturaMuestra(m)}</div>`} />
            <div class="flex items-center justify-between gap-3 p-4">
              <span class="font-semibold text-ink">{m.nombre}</span>
              <a href={m.enlace} class="boton boton-secundario" aria-label={`Elegir el diseño ${m.nombre}`}>Elegir este diseño</a>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="py-10 sm:py-12" aria-labelledby="servicios">
    <h2 id="servicios" class="font-serif text-2xl font-bold text-ink sm:text-3xl">
      Servicios y precios publicados
    </h2>
    <p class="mt-2 max-w-2xl text-muted">
      El importe se lee del producto activo del catálogo, como en la portada. Consulta la ficha para ver modalidades y precio vigente antes de contratar.
    </p>
    {services.length > 0 ? (
      <div class="mt-5 grid gap-5 md:grid-cols-2">
        {services.map((service) => (
          <article class="tarjeta p-5">
            <h3 class="font-serif text-xl font-semibold text-ink">{service.name}</h3>
            <p class="mt-2 text-sm text-muted">Desde {service.formattedPrice}</p>
            <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
              <a
                href={`/empezar/${service.slug}`}
                class="inline-flex text-sm font-semibold text-brand hover:underline"
              >
                Empieza gratis →
              </a>
              <a
                href={`/products/${service.slug}`}
                class="inline-flex text-sm font-semibold text-brand hover:underline"
              >
                Ver servicio y modalidades →
              </a>
            </div>
            <ul class="mt-4 space-y-2 border-t border-line pt-4">
              {service.demos.map((demo) => (
                <li>
                  <a
                    href={demo.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-brand hover:underline"
                  >
                    {demo.tipo === 'interactiva' ? 'Probar' : 'Ver'} demo: {demo.titulo} ↗
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    ) : (
      <div class="mt-5 rounded-xl border border-line bg-surface p-5">
        <p class="text-muted">Ahora mismo no hay servicios publicados para este sector.</p>
        <a
          href="/empezar/consulta"
          class="mt-4 inline-flex text-sm font-semibold text-brand hover:underline"
        >
          Cuéntanos qué necesitas
        </a>
      </div>
    )}
  </section>

  <section class="mb-12 rounded-2xl border border-line bg-surface p-6">
    <h2 class="font-serif text-2xl font-bold text-ink">Antes de publicar</h2>
    <ul class="mt-4 list-disc space-y-2 pl-5 text-muted">
      {sector.considerations.map((consideration) => <li>{consideration}</li>)}
    </ul>
    <p class="mt-5 text-sm text-muted">
      Para que la página represente bien tu negocio, prepara horarios, zona de atención, servicios y una forma de contacto que puedas mantener actualizada.
    </p>
  </section>

  <nav aria-labelledby="otros-sectores" class="mb-12">
    <h2 id="otros-sectores" class="font-serif text-xl font-bold text-ink">Otros sectores</h2>
    <ul class="mt-3 flex flex-wrap gap-3">
      {SECTORS.filter((otro) => otro.slug !== sector.slug).map((otro) => (
        <li>
          <a href={`/webs/${otro.slug}`} class="pildora">
            {otro.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</Layout>
