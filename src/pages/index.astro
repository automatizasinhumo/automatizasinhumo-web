---
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import ProductList from '../features/products/ProductList.astro';
import HomeHero from '../features/storefront/HomeHero.astro';
import TourInvitacion from '../features/tour/TourInvitacion.astro';
import { loadHomeServices } from '../features/storefront/homeServices';
import { hasCatalogParams } from '../features/storefront/campaignParams';
import { resolveHomePath } from '../features/settings/home';
import { getConfig } from '../config';
import { OBJETIVOS } from '../features/storefront/selector';

// Un tema puede traer su propia portada (Home.astro): entonces `/` pinta solo esa
// portada y el catálogo completo sigue en /products. Sin Home.astro, la de siempre.
const ThemeHome = Object.values(import.meta.glob<{ default: unknown }>('#theme/Home.astro', { eager: true }))[0]?.default as
  | ((props: Record<string, unknown>) => unknown)
  | undefined;

// A store can point `/` at a page or a single product instead of the catalog.
// Rewriting rather than duplicating those templates keeps one implementation of
// each, and it makes the canonical URL resolve to the real page — so the same
// content served at `/` and at `/pages/<slug>` is not two indexable copies.
// Anything unresolvable (never set, unpublished, deleted, deactivated) falls
// through to the catalog: a 404 homepage would be edge-cached for everyone.
const homePath = await resolveHomePath(env.DB, Astro.locals.settings?.homePage);
if (homePath) return Astro.rewrite(homePath);
// La portada solo en la primera vista del catálogo, no al ordenar ni paginar.
// Los parámetros de campañas (utm_*, gclid, fbclid...) no cuentan: el anuncio debe aterrizar en la portada.
const showHero = !hasCatalogParams(Astro.url.searchParams);
const config = getConfig();
let homeServices: Awaited<ReturnType<typeof loadHomeServices>>['services'] = [];
// Portada incompleta por un fallo de D1: que ninguna caché compartida la guarde.
const noStore = () => Astro.response.headers.set('cache-control', 'no-store');
if (showHero && !ThemeHome) {
  try {
    const result = await loadHomeServices(env.DB, {
      currency: config.currency,
      imageBaseUrl: config.images.baseUrl,
      delivery: Astro.locals.settings?.imageDelivery,
    });
    homeServices = result.services;
    if (result.failed) noStore();
  } catch (error) {
    console.error('Home services failed to load:', error);
    noStore();
  }
}
---

{showHero && ThemeHome ? (
  <Layout
    title="Webs y automatizaciones a precio cerrado"
    description="Webs, tiendas online, reservas, automatizaciones, CV e invitaciones a precio cerrado. Eliges, lo personalizas, ves la vista previa y lo tienes listo."
    sinAviso
  >
    <ThemeHome
      objetivos={OBJETIVOS.map((o) => ({ id: o.id, href: `/elige?objetivo=${o.id}#resultado` }))}
      testHref="/elige"
      catalogHref="/products"
    />
  </Layout>
) : (
  <Layout title={showHero ? 'Webs para negocios a precio cerrado: la ves gratis antes de pagar' : undefined}>
    {showHero && <HomeHero services={homeServices} />}
    <ProductList belowHero={showHero} />
    {showHero && <TourInvitacion />}
  </Layout>
)}
