---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import ContentPage from '#theme/ContentPage.astro';
import { getConfig } from '../../config';
import { getPublishedPageBySlug } from '../../features/pages/db';
import { pageImageDimensions } from '../../features/media/db';
import { renderMarkdown, markdownExcerpt, markdownFaq } from '../../features/pages/markdown';
import { normalizePageLayout, pageLayoutStyle } from '../../features/pages/layouts';
import ComoFunciona from '../../features/storefront/ComoFunciona.astro';
import DemosGaleria from '../../features/storefront/DemosGaleria.astro';

const { slug } = Astro.params;
const page = slug ? await getPublishedPageBySlug(env.DB, slug) : null;

// Drafts are indistinguishable from missing pages here — the query filters on
// published, so an unpublished slug is a 404 rather than a private preview.
if (!page) {
  // Middleware only stores 200s in the shared cache, so no-store is about caches
  // we do NOT control: 404 is heuristically cacheable, and a browser or proxy
  // holding one would keep serving it after the page goes live.
  return new Response('Not found', {
    status: 404,
    headers: { 'cache-control': 'no-store' },
  });
}

// One indexed read, on an edge-cached route, so body images can carry their
// intrinsic size and stop shifting the layout when they load.
const dimensions = await pageImageDimensions(env.DB, page.id);
const html = renderMarkdown(page.body_markdown, {
  baseUrl: getConfig().images.baseUrl,
  dimensions,
});
const description = markdownExcerpt(page.body_markdown);
const layout = normalizePageLayout(page.layout);
// Páginas con maquetación propia: el markdown de la BD queda como respaldo y fuente del extracto.
const Propia = slug === 'como-funciona' ? ComoFunciona : slug === 'demos' ? DemosGaleria : null;
// Una página escrita como preguntas (encabezados con «?») publica su FAQPage, solo si ese
// markdown es lo que se ve: las de maquetación propia no lo pintan («Cómo funciona» trae su FAQ).
const faq = Propia ? [] : markdownFaq(page.body_markdown);
const faqLd =
  faq.length >= 2
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((p) => ({ '@type': 'Question', name: p.question, acceptedAnswer: { '@type': 'Answer', text: p.answer } })),
      }).replace(/</g, '\\u003c')
    : null;
---

<Layout title={page.title} description={description}>
  {Propia ? (
    <div class="mx-auto max-w-6xl px-4 py-8 sm:py-10"><Propia /></div>
  ) : (
    <ContentPage
      model={{ title: page.title, html, layout, layoutStyle: pageLayoutStyle(layout) }}
    />
  )}
  {faqLd && <script is:inline type="application/ld+json" set:html={faqLd} />}
</Layout>
