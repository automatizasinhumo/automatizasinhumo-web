---
import Layout from '../../layouts/Layout.astro';
import '../../styles/estudio.css';
import Progreso from '../../themes/limpio/ui/Progreso.astro';
import { AUTOSERVICIO, SLUG_WEB } from '../../features/servicios/autoservicio';
import { euros } from '../../features/servicios/cv';
import {
  COLORES_WEB,
  CSS_WEB,
  cssFuentes,
  EJEMPLO_WEB,
  LETRAS_WEB,
  ACABADOS_WEB,
  FORMAS_FOTO_WEB,
  MOVIMIENTOS_WEB,
  MAX_ENLACES_WEB,
  MAX_OPINIONES_WEB,
  MAX_PREGUNTAS_WEB,
  MAX_SERVICIOS_WEB,
  PASOS_WEB,
  PLANTILLAS_WEB,
  SECCIONES_WEB,
  MAX_GALERIA_WEB,
  WEB_POR_DEFECTO,
} from '../../features/servicios/webs';
import { SECTORES_WEB } from '../../features/servicios/sectores';

// Estudio de webs: mismo esquema que el de CV (/servicios/cv). Todo ocurre en el navegador:
// elegir diseño, escribir los datos del negocio, color y letra, y verla al momento con marca
// de agua. Con el pedido pagado se publica en /w/<nombre> sin marca, sin pasos manuales.
Astro.response.headers.set('X-Robots-Tag', 'noindex');

const servicio = AUTOSERVICIO[SLUG_WEB]!;
const precio = servicio.precio ?? 0;
const config = JSON.stringify({
  producto: servicio.producto,
  precio,
  css: CSS_WEB,
  ejemplo: EJEMPLO_WEB,
  porDefecto: WEB_POR_DEFECTO,
  plantillas: PLANTILLAS_WEB.map((p) => p.id),
  letras: LETRAS_WEB.map((l) => l.id),
  maxServicios: MAX_SERVICIOS_WEB,
  maxEnlaces: MAX_ENLACES_WEB,
});
const campo = 'campo';
// Primero los diseños de autor (cada uno con su portada y tipografía), luego las básicas para configurar.
const GRUPOS_WEB = [
  {
    id: 'autor',
    titulo: 'Diseños de autor',
    texto: 'Cada uno con su portada, su tipografía y su estilo, pensado para un tipo de negocio.',
    plantillas: PLANTILLAS_WEB.filter((p) => p.familia === 'autor'),
  },
  {
    id: 'basica',
    titulo: 'Básicas, para configurar',
    texto: 'Limpias y neutras: tú pones el color, la letra y el orden.',
    plantillas: PLANTILLAS_WEB.filter((p) => p.familia === 'basica'),
  },
];
// Las @font-face no funcionan dentro del shadow root de la vista previa: van en el documento.
const FUENTES_CSS = cssFuentes('/fonts/web/');
---

<Layout
  title="Tu web de una página: elige diseño, escribe y publícala"
  description="Elige un diseño, escribe los datos de tu negocio y mira tu web al momento. Con tu color y tu letra, publicada en cuanto la compras."
  sinAviso
>
  <Fragment set:html={`<style>${FUENTES_CSS}</style>`} />
  <div id="estudio-web" class="estudio" data-config={config}>
    <header class="fondo-tecnico cabecera-pagina">
      <span class="etiqueta">Servicios · Web</span>
      <h1 class="mt-4 max-w-3xl font-serif text-4xl font-bold leading-tight text-ink sm:text-5xl">Tu web, paso a paso</h1>
      <p class="mt-5 max-w-2xl text-lg leading-7 text-muted">
        Elige un diseño, escribe lo que haces y cómo contactarte, y mírala al momento en móvil y en ordenador. Al comprarla queda
        publicada, y puedes cambiarla cuando quieras.
      </p>
    </header>

    <div class="progreso-fijo">
      <Progreso pasos={PASOS_WEB} etiqueta="Pasos para hacer tu web" />
      <div class="historial" role="group" aria-label="Acciones del estudio">
        <button type="button" class="guia-boton" data-deshacer disabled aria-keyshortcuts="Control+Z" title="Deshacer (Ctrl+Z)">↶ Deshacer</button>
        <button type="button" class="guia-boton" data-rehacer disabled aria-keyshortcuts="Control+Y" title="Rehacer (Ctrl+Y)">↷ Rehacer</button>
        <span class="sr-only" role="status" data-historial-aviso></span>
        <button type="button" class="guia-boton" data-guia-abrir>Guía de este paso</button>
      </div>
    </div>

    <form id="estudio-form" class="mt-8" novalidate autocomplete="on">
      <!-- 1 · Diseño -->
      <section data-paso="plantilla" aria-labelledby="paso-plantilla">
        <h2 id="paso-plantilla" class="paso-titulo">Elige el diseño de tu web</h2>
        <p class="paso-entradilla">Todos cuestan lo mismo, {euros(precio)}. Podrás cambiarlo después sin volver a escribir nada.</p>
        <div class="recomienda mt-6">
          <label class={campo}
            >¿A qué se dedica tu negocio? <span class="ayuda">(te enseñamos primero los diseños que mejor le van)</span><input
              data-sector-rapido
              maxlength="60"
              list="sectores-web"
              placeholder="Ej.: Peluquería"
              autocomplete="off"
            /></label
          >
          <div class="grupo-disenos recomendados" data-recomendados hidden>
            <h3 class="grupo-titulo" data-recomendados-titulo>Para tu negocio</h3>
            <div class="rejilla" data-recomendados-rejilla></div>
          </div>
        </div>
        <fieldset class="mt-6" data-guia="galeria">
          <legend class="sr-only">Diseño de la web</legend>
          {
            GRUPOS_WEB.map((g) => (
              <div class="grupo-disenos" data-familia={g.id}>
                <h3 class="grupo-titulo">{g.titulo}</h3>
                <p class="grupo-texto">{g.texto}</p>
                <div class="rejilla">
                  {g.plantillas.map((p) => (
                    <label class="tarjeta diseno">
                      <input type="radio" name="plantilla" value={p.id} class="sr-only" />
                      <span class="mini-web" data-mini={p.id} aria-hidden="true" />
                      <span class="diseno-pie">
                        <span class="min-w-0">
                          <strong class="block truncate text-ink">{p.nombre}</strong>
                          <span class="block text-xs text-faint">{p.descripcion}</span>
                        </span>
                        <span class="precio">{euros(precio)}</span>
                      </span>
                    </label>
                  ))}
                </div>
              </div>
            ))
          }
        </fieldset>
        <p class="aviso" role="alert" data-error="plantilla" hidden>Elige un diseño para seguir.</p>
        <div class="paso-acciones">
          <button type="button" class="boton boton-principal" data-siguiente data-guia="siguiente">Siguiente: tu negocio</button>
        </div>
      </section>

      <!-- 2 · Datos -->
      <section data-paso="datos" aria-labelledby="paso-datos" hidden>
        <h2 id="paso-datos" class="paso-titulo">Cuéntanos de tu negocio</h2>
        <p class="paso-entradilla">Lo que escribes se guarda solo en este navegador. A la derecha ves cómo queda: toca cualquier parte de la vista previa para ir a lo que la cambia.</p>
        <div class="con-vista">
          <div class="min-w-0">
            <div class="flex flex-wrap gap-2" data-guia="atajos">
              <button type="button" class="boton boton-secundario boton-compacto" data-ejemplo>Rellenar con un ejemplo</button>
              <button type="button" class="boton boton-secundario boton-compacto" data-vaciar>Empezar en blanco</button>
              <button type="button" class="boton boton-secundario boton-compacto" data-textos>Escribir los textos por mí</button>
            </div>
            <p class="ayuda mt-2 text-sm" data-estado-textos role="status"></p>

            <fieldset class="bloque" data-guia="negocio">
              <legend>Tu negocio</legend>
              <div class="filas">
                <label class={campo}>Nombre del negocio *<input name="negocio" autocomplete="organization" required maxlength="80" /></label>
                <label class={campo}>A qué te dedicas<input name="sector" maxlength="60" list="sectores-web" placeholder="Ej.: Fontanería" /></label>
                <datalist id="sectores-web">{SECTORES_WEB.map((s) => <option value={s.nombre} />)}</datalist>
              </div>
              <label class={campo}>Frase de presentación<input name="lema" maxlength="140" placeholder="Qué ofreces y dónde, en una frase." /></label>
              <div class="ideas-lema">
                <button type="button" class="min-h-11 text-sm font-semibold underline" data-ideas>Dame ideas para la frase</button>
                <div class="flex flex-col gap-2" data-ideas-lista role="group" aria-label="Ideas para la frase" hidden></div>
              </div>
              <label class={campo}>Quiénes sois<textarea name="sobre" rows="4" maxlength="900" placeholder="Unas líneas sobre ti o tu equipo."></textarea></label>
              <div class="foto">
                <input type="hidden" name="foto" />
                <img data-foto-vista alt="Foto de portada elegida" hidden />
                <label class={campo}>Foto de portada <span class="ayuda">(opcional: tu local, tu trabajo o tu logo)</span><input type="file" accept="image/*" data-foto-elegir /></label>
                <label class="camara">Hacer la foto ahora<input type="file" accept="image/*" capture="environment" data-foto-elegir class="sr-only" /></label>
                <button type="button" class="quitar" data-foto-quitar hidden>Quitar foto</button>
                <p class="ayuda" data-foto-aviso role="status" hidden></p>
              </div>
              <div class="galeria-fotos" data-galeria>
                <ul class="galeria-mini" data-galeria-lista></ul>
                <label class={campo} data-galeria-anadir>Fotos de tu trabajo <span class="ayuda">(opcional, hasta {MAX_GALERIA_WEB}: trabajos hechos, el local, el equipo)</span><input type="file" accept="image/*" multiple data-galeria-elegir /></label>
                <label class="camara">Hacer una foto ahora<input type="file" accept="image/*" capture="environment" data-galeria-elegir class="sr-only" /></label>
                <p class="ayuda" data-galeria-aviso role="status" hidden></p>
              </div>
            </fieldset>

            <fieldset class="bloque" data-lista="servicios" data-max={MAX_SERVICIOS_WEB}>
              <legend>Servicios <span class="ayuda">(hasta {MAX_SERVICIOS_WEB})</span></legend>
              <div data-items></div>
              <button type="button" class="anadir" data-anadir>+ Añadir servicio</button>
            </fieldset>

            <fieldset class="bloque" data-guia="contacto">
              <legend>Contacto <span class="ayuda">(al menos uno)</span></legend>
              <div class="filas">
                <label class={campo}>Teléfono<input name="telefono" type="tel" autocomplete="tel" maxlength="24" /></label>
                <label class={campo}>WhatsApp<input name="whatsapp" type="tel" maxlength="24" placeholder="600 000 000" /></label>
                <label class={campo}>Correo<input name="email" type="email" autocomplete="email" maxlength="254" /></label>
                <label class={campo}>Dirección<input name="direccion" autocomplete="street-address" maxlength="160" /></label>
              </div>
              <label class={campo}>Horario<textarea name="horario" rows="2" maxlength="300" placeholder="Lunes a viernes: 9:00 – 14:00"></textarea></label>
              <div class="filas">
                <label class={campo}>Zonas que atendéis <span class="ayuda">(opcional)</span><input name="zonas" maxlength="300" placeholder="Lugo, Outeiro de Rei, Rábade" /></label>
                <label class={campo}>Enlace para reservar cita <span class="ayuda">(opcional)</span><input name="reservas" inputmode="url" maxlength="300" placeholder="booksy.com/tunegocio" /></label>
              </div>
            </fieldset>

            <fieldset class="bloque" data-lista="enlaces" data-max={MAX_ENLACES_WEB}>
              <legend>Redes y enlaces <span class="ayuda">(hasta {MAX_ENLACES_WEB})</span></legend>
              <div data-items></div>
              <button type="button" class="anadir" data-anadir>+ Añadir enlace</button>
            </fieldset>

            <fieldset class="bloque" data-lista="opiniones" data-max={MAX_OPINIONES_WEB}>
              <legend>Opiniones de clientes <span class="ayuda">(opcional, hasta {MAX_OPINIONES_WEB})</span></legend>
              <p class="ayuda text-sm">Copia las que ya tengas en Google, Facebook o WhatsApp, con el nombre que te dejen poner.</p>
              <div data-items></div>
              <button type="button" class="anadir" data-anadir>+ Añadir opinión</button>
              <label class={campo}>Enlace a todas tus opiniones <span class="ayuda">(tu ficha de Google, por ejemplo)</span><input name="opinionesUrl" inputmode="url" maxlength="300" /></label>
            </fieldset>

            <fieldset class="bloque" data-lista="preguntas" data-max={MAX_PREGUNTAS_WEB}>
              <legend>Preguntas frecuentes <span class="ayuda">(opcional, hasta {MAX_PREGUNTAS_WEB})</span></legend>
              <p class="ayuda text-sm">Lo que más te preguntan por teléfono: si hace falta cita, cómo se paga, si vais a domicilio…</p>
              <div data-items></div>
              <button type="button" class="anadir" data-anadir>+ Añadir pregunta</button>
            </fieldset>
          </div>
          <div data-hueco-vista></div>
        </div>
        <p class="aviso" role="alert" data-error="datos" hidden>Escribe el nombre del negocio y al menos un teléfono, un WhatsApp o un correo.</p>
        <div class="paso-acciones">
          <button type="button" class="boton boton-secundario" data-atras>Atrás</button>
          <button type="button" class="boton boton-principal" data-siguiente>Siguiente: estilo</button>
        </div>
      </section>

      <!-- 3 · Personaliza -->
      <section data-paso="personaliza" aria-labelledby="paso-personaliza" hidden>
        <h2 id="paso-personaliza" class="paso-titulo">Dale tu toque</h2>
        <p class="paso-entradilla">Color, letra, acabado, forma de la foto y movimiento. La vista previa se actualiza sola.</p>
        <div class="con-vista">
          <div class="min-w-0">
            <fieldset class="bloque" data-guia="color">
              <legend>Color</legend>
              <div class="muestras">
                {
                  COLORES_WEB.map((c) => (
                    <label class="muestra" title={c.nombre}>
                      <input type="radio" name="color" value={c.valor} class="sr-only" />
                      <span style={`--muestra:${c.valor}`} aria-hidden="true" />
                      <span class="sr-only">{c.nombre}</span>
                    </label>
                  ))
                }
                <label class="muestra muestra-libre" title="Otro color">
                  <input type="color" name="colorLibre" value={WEB_POR_DEFECTO.color} aria-label="Otro color" />
                </label>
              </div>
            </fieldset>
            <fieldset class="bloque" data-guia="letra">
              <legend>Letra</legend>
              <div class="letras">
                {
                  LETRAS_WEB.map((l) => (
                    <label class="letra">
                      <input type="radio" name="letra" value={l.id} class="sr-only" />
                      <strong style={`font-family:${l.titulo}`}>{l.nombre}</strong>
                      <span>{l.descripcion}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
            {
              [
                { k: 'acabado', t: 'Acabado', l: ACABADOS_WEB },
                { k: 'formaFoto', t: 'Forma de la foto', l: FORMAS_FOTO_WEB },
                { k: 'movimiento', t: 'Movimiento', l: MOVIMIENTOS_WEB },
              ].map((g, i) => (
                <fieldset class="bloque" data-guia={i === 0 ? 'capa' : undefined}>
                  <legend>{g.t}</legend>
                  <div class="letras">
                    {g.l.map((x) => (
                      <label class="letra">
                        <input type="radio" name={g.k} value={x.id} class="sr-only" checked={x.id === 'auto'} />
                        <strong>{x.nombre}</strong>
                        <span>{x.descripcion}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              ))
            }
            <fieldset class="bloque" data-guia="orden">
              <legend>Orden de las secciones</legend>
              <p class="ayuda text-sm">La portada va siempre arriba. Las secciones vacías no salen.</p>
              <ol class="orden" data-orden>
                {
                  SECCIONES_WEB.map((x) => (
                    <li data-seccion={x.id}>
                      <span>{x.nombre}</span>
                      <button type="button" class="mover" data-subir aria-label={`Subir ${x.nombre}`}>↑</button>
                      <button type="button" class="mover" data-bajar aria-label={`Bajar ${x.nombre}`}>↓</button>
                    </li>
                  ))
                }
              </ol>
            </fieldset>
            <fieldset class="bloque">
              <legend>Diseño</legend>
              <div class="formas">
                {
                  PLANTILLAS_WEB.map((p) => (
                    <label class="forma">
                      <input type="radio" name="plantilla-rapida" value={p.id} class="sr-only" />
                      <span>{p.nombre}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
          </div>
          <div data-hueco-vista></div>
        </div>
        <div class="paso-acciones">
          <button type="button" class="boton boton-secundario" data-atras>Atrás</button>
          <button type="button" class="boton boton-principal" data-siguiente>Siguiente: publica</button>
        </div>
      </section>

      <!-- 4 · Publica -->
      <section data-paso="publica" aria-labelledby="paso-publica" hidden>
        <h2 id="paso-publica" class="paso-titulo">Publica tu web</h2>
        <div class="tarjeta resumen">
          <dl>
            <div><dt>Negocio</dt><dd data-res="negocio"></dd></div>
            <div><dt>Diseño</dt><dd data-res="plantilla"></dd></div>
          </dl>
          <div class="revision" data-revision-caja>
            <p><strong>Tu web está preparada al <span data-revision-puntos>0</span>/100</strong> <span class="ayuda">para clientes y buscadores</span></p>
            <ul data-revision></ul>
          </div>
          <ul class="incluye">
            <li>Publicada al momento, sin marca de agua</li>
            <li>Alojamiento incluido y certificado de seguridad (https)</li>
            <li>Botones de llamar, WhatsApp y correo</li>
            <li>Cámbiala cuando quieras desde aquí</li>
          </ul>
          <div data-solo-compra>
            <p class="total"><span>Total</span><strong>{euros(precio)}</strong></p>
          </div>
          <p class="pagado" data-solo-pagado hidden>Pedido <strong data-res="ref"></strong> pagado. Tu web se publica sin marca de agua.</p>
          <button type="button" class="boton boton-principal boton-destello w-full" data-comprar data-guia="comprar"><span>Comprar y publicar · {euros(precio)}</span></button>
          <button type="button" class="boton boton-secundario mt-2 min-h-11 w-full" data-compartir data-solo-compra>Enseñarla antes de comprar</button>
          <p class="mt-3 text-sm text-faint" role="status" data-estado-compra>Se publica en cuanto termines el pago.</p>
          <!-- Versiones anteriores: se guardan al volver a publicar (paginas_versiones, /api/web/restaurar). -->
          <details class="versiones" data-versiones hidden>
            <summary>Versiones anteriores (<span data-versiones-n>0</span>)</summary>
            <p class="ayuda">Cada vez que guardas cambios, la versión anterior se queda aquí. Puedes volver a cualquiera.</p>
            <ol data-versiones-lista></ol>
          </details>
        </div>
        <!-- Dominio propio: solo con la web ya publicada (estudioWeb.ts + /api/web/dominio). -->
        <div class="tarjeta dominio mt-4" data-dominio data-guia="dominio" hidden>
          <h3 class="text-lg font-semibold">Tu dominio</h3>
          <p class="mt-1 text-sm text-faint">Tu web ya está en internet. Para que salga en tu propio nombre (por ejemplo, peluquerialola.com), elige uno de los que te damos incluidos o conecta el que ya tengas.</p>
          <div class="mt-3 ofertas-dominio" data-dominio-ofertas hidden>
            <p class="text-sm font-semibold">Incluido con tu web, sin pasos técnicos:</p>
            <div class="mt-2 grid gap-2" data-dominio-ofertas-lista></div>
          </div>
          <fieldset class="mt-3 titular-dominio" data-dominio-titular hidden>
            <legend class="text-sm font-semibold">Titular de <span data-titular-dominio></span></legend>
            <p class="text-xs text-faint">El dominio queda a tu nombre. Estos datos los pide el registro y no se publican.</p>
            <div class="mt-2 grid gap-2 sm:grid-cols-2">
              <label class={campo}>Nombre y apellidos<input name="titular-nombre" autocomplete="name" maxlength="120" /></label>
              <label class={campo}>Empresa (opcional)<input name="titular-empresa" autocomplete="organization" maxlength="120" /></label>
              <label class={campo}>Correo<input name="titular-email" type="email" autocomplete="email" maxlength="200" /></label>
              <label class={campo}>Teléfono<input name="titular-telefono" type="tel" autocomplete="tel" maxlength="30" placeholder="612 345 678" /></label>
              <label class={`${campo} sm:col-span-2`}>Dirección<input name="titular-calle" autocomplete="street-address" maxlength="200" placeholder="Calle Mayor 3, 2º B" /></label>
              <label class={campo}>Ciudad<input name="titular-ciudad" autocomplete="address-level2" maxlength="100" /></label>
              <label class={campo}>Provincia<input name="titular-provincia" autocomplete="address-level1" maxlength="100" /></label>
              <label class={campo}>Código postal<input name="titular-cp" autocomplete="postal-code" inputmode="numeric" maxlength="12" /></label>
              <label class={campo}>País<select name="titular-pais" autocomplete="country">
                <option value="ES" selected>España</option><option value="PT">Portugal</option><option value="FR">Francia</option><option value="AD">Andorra</option><option value="IT">Italia</option><option value="DE">Alemania</option><option value="GB">Reino Unido</option><option value="IE">Irlanda</option><option value="MX">México</option><option value="AR">Argentina</option><option value="CO">Colombia</option><option value="CL">Chile</option><option value="PE">Perú</option><option value="US">Estados Unidos</option>
              </select></label>
            </div>
            <div class="mt-3 flex flex-wrap gap-2">
              <button type="button" class="boton boton-principal" data-contratar>Contratar y conectar</button>
              <button type="button" class="boton boton-secundario" data-titular-cancelar>Elegir otro</button>
            </div>
          </fieldset>
          <p class="mt-4 text-sm font-semibold" data-dominio-propio-titulo>¿Ya tienes dominio? Conéctalo:</p>
          <div class="mt-3 flex flex-wrap items-end gap-2" data-dominio-pedir>
            <label class={`${campo} min-w-0 flex-1`}>Dominio<input name="dominio" inputmode="url" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="253" placeholder="peluquerialola.es" /></label>
            <button type="button" class="boton boton-principal" data-conectar>Conectar</button>
          </div>
          <div class="mt-3 text-sm" data-dominio-ideas hidden>
            <p class="text-faint">Otros nombres libres ahora mismo (si los compras en tu registrador, vuelve y conéctalos):</p>
            <div class="mt-2 flex flex-wrap gap-2" data-dominio-ideas-lista></div>
          </div>
          <div class="mt-3" data-dominio-pasos hidden>
            <p class="text-sm">Para <strong data-dominio-nombre></strong>, falta un paso que solo puedes dar tú:</p>
            <ol class="mt-2 list-decimal space-y-2 pl-5 text-sm">
              <li>Entra en la web donde compraste el dominio y busca «Servidores DNS» (o «Nameservers»).</li>
              <li>Cambia los que haya por estos dos:
                <ul class="mt-1 space-y-1" data-dominio-ns></ul>
              </li>
              <li>Ya está. Lo comprobamos solos cada pocos minutos y te escribimos cuando tu web esté en tu dominio. Suele tardar menos de una hora, aunque algunos registradores tardan hasta un día.</li>
            </ol>
            <button type="button" class="mt-3 text-sm underline" data-dominio-cambiar>Me he equivocado de dominio</button>
          </div>
          <p class="mt-3 text-sm" role="status" data-estado-dominio></p>
        </div>
        <div class="paso-acciones">
          <button type="button" class="boton boton-secundario" data-atras>Atrás</button>
        </div>
      </section>
    </form>

    <!-- Vista previa: un único panel que el script mueve al paso activo. -->
    <aside class="vista" aria-label="Vista previa de la web" data-vista data-guia="vista" data-tamano="movil" hidden>
      <div class="web-tamanos formas" role="radiogroup" aria-label="Ver como">
        <label class="forma"><input type="radio" name="tamano-vista" value="movil" class="sr-only" checked /><span>Móvil</span></label>
        <label class="forma"><input type="radio" name="tamano-vista" value="escritorio" class="sr-only" /><span>Ordenador</span></label>
      </div>
      <p class="vista-estado" role="status" data-estado>Vista previa con marca de agua</p>
      <div class="vista-lienzo" data-lienzo>
        <div class="web-marco">
          <div class="web-barra" data-barra>tuweb</div>
          <div class="web-host" data-host></div>
        </div>
      </div>
    </aside>
  </div>

  <template id="t-servicios">
    <div class="item servicio-web">
      <div class="filas">
        <label class={campo}>Servicio<input data-k="nombre" maxlength="60" /></label>
        <label class={campo}>Precio<input data-k="precio" maxlength="20" placeholder="desde 20 €" /></label>
      </div>
      <label class={campo}>Descripción<input data-k="texto" maxlength="200" /></label>
      <button type="button" class="quitar" data-quitar>Quitar</button>
    </div>
  </template>
  <template id="t-opiniones">
    <div class="item">
      <label class={campo}>Opinión<textarea data-k="texto" rows="2" maxlength="400"></textarea></label>
      <label class={campo}>Quién la escribe<input data-k="autor" maxlength="60" placeholder="Marta G." /></label>
      <button type="button" class="quitar" data-quitar>Quitar</button>
    </div>
  </template>
  <template id="t-preguntas">
    <div class="item">
      <label class={campo}>Pregunta<input data-k="pregunta" maxlength="160" placeholder="¿Hace falta cita?" /></label>
      <label class={campo}>Respuesta<textarea data-k="respuesta" rows="2" maxlength="600"></textarea></label>
      <button type="button" class="quitar" data-quitar>Quitar</button>
    </div>
  </template>
  <template id="t-enlaces">
    <div class="item">
      <div class="filas">
        <label class={campo}>Nombre<input data-k="etiqueta" maxlength="30" placeholder="Instagram" /></label>
        <label class={campo}>Dirección<input data-k="url" maxlength="300" placeholder="instagram.com/tunegocio" /></label>
      </div>
      <button type="button" class="quitar" data-quitar>Quitar</button>
    </div>
  </template>
</Layout>

<script>
  import { iniciarEstudioWeb } from '../../features/servicios/estudioWeb';

  iniciarEstudioWeb();
</script>
