---
import Layout from '../../layouts/Layout.astro';
import { PAQUETES_CV, euros, miniaturaCv } from '../../features/servicios/cv';

// Portada de la sección nueva de servicios. Sin publicar todavía (noindex y sin enlaces):
// de momento solo el currículum; el resto de servicios entra aquí cuando esté listo.
Astro.response.headers.set('X-Robots-Tag', 'noindex');
const desde = euros(Math.min(PAQUETES_CV.disenada.precio, PAQUETES_CV.personalizable.precio));
---

<Layout title="Servicios: hazlo tú en minutos" description="Elige un servicio y hazlo paso a paso, con vista previa al momento." sinAviso>
  <div class="mx-auto max-w-6xl px-4 pb-16 pt-8">
    <header class="fondo-tecnico cabecera-pagina">
      <span class="etiqueta">Servicios</span>
      <h1 class="mt-4 max-w-3xl font-serif text-4xl font-bold leading-tight text-ink sm:text-5xl">Hazlo tú, paso a paso</h1>
      <p class="mt-5 max-w-2xl text-lg leading-7 text-muted">Eliges, rellenas y ves el resultado al momento. Pagas solo cuando te guste.</p>
    </header>

    <ul class="mt-10 grid gap-6 md:grid-cols-2">
      <li>
        <a href="/servicios/cv" class="tarjeta servicio">
          <img src={miniaturaCv('onyx')} alt="" width="480" height="679" loading="eager" decoding="async" />
          <span class="servicio-texto">
            <span class="etiqueta">Currículum</span>
            <strong class="mt-3 block font-serif text-2xl text-ink">Tu currículum con buen diseño</strong>
            <span class="mt-2 block text-muted">15 diseños listos o uno personalizable con tu color y formas. Lo ves mientras lo escribes.</span>
            <span class="mt-4 block font-semibold text-ink">Desde {desde}</span>
            <span class="boton boton-principal boton-compacto mt-5">Empezar</span>
          </span>
        </a>
      </li>
    </ul>
  </div>
</Layout>

<style>
  .servicio {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--ds-hueco-6);
    padding: var(--ds-hueco-4);
    height: 100%;
    text-decoration: none;
  }
  .servicio:hover {
    transform: translateY(-2px);
    box-shadow: var(--ds-sombra-2);
  }
  .servicio img {
    width: 100%;
    height: auto;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: #fff;
  }
  .servicio-texto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: center;
  }
</style>
