---
import Layout from '../../layouts/Layout.astro';
import { euros } from '../../features/servicios/cv';
import { FAMILIAS, PROXIMAS, disponible } from '../../features/servicios/catalogo';

// Catálogo nuevo: servicios agrupados por familia (catalogo.ts). El tema trae su propia
// página (Servicios.astro, mismo lenguaje que su portada); sin ella, una lista sencilla.
// Sin publicar todavía para buscadores: noindex hasta que todo el catálogo esté listo.
Astro.response.headers.set('X-Robots-Tag', 'noindex');

const ThemeServicios = Object.values(import.meta.glob<{ default: unknown }>('#theme/Servicios.astro', { eager: true }))[0]
  ?.default as ((props: Record<string, unknown>) => unknown) | undefined;

const familias = FAMILIAS.map((f) => ({
  ...f,
  servicios: f.servicios.map((s) => ({ ...s, desde: s.desde === undefined ? undefined : euros(s.desde) })),
}));
---

<Layout title="Servicios: elige y tenlo listo hoy" description="Currículum, tarjeta digital, dominio y webs: eliges, rellenas, lo ves al momento y lo tienes." sinAviso>
  {ThemeServicios ? (
    <ThemeServicios familias={familias} proximas={PROXIMAS} />
  ) : (
    <div class="mx-auto max-w-6xl px-4 pb-16 pt-8">
      <h1 class="font-serif text-4xl font-bold text-ink">Servicios</h1>
      {familias.map((f) => (
        <section class="mt-10" data-familia={f.id}>
          <h2 class="font-serif text-2xl font-bold text-ink">{f.nombre}</h2>
          <p class="mt-1 text-muted">{f.texto}</p>
          <ul class="mt-4 grid gap-4 md:grid-cols-2">
            {FAMILIAS.find((x) => x.id === f.id)!.servicios.map((s) => (
              <li class="tarjeta p-5">
                <strong class="block text-ink">{disponible(s) ? <a href={s.href}>{s.nombre}</a> : s.nombre}</strong>
                <span class="mt-1 block text-muted">{s.texto}</span>
                <span class="mt-2 block text-sm font-semibold">{disponible(s) ? (s.desde === undefined ? '' : `Desde ${euros(s.desde)}`) : 'Muy pronto'}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <section class="mt-10" data-proximas>
        <h2 class="font-serif text-2xl font-bold text-ink">Y después</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {PROXIMAS.map((p) => <li class="tarjeta px-4 py-2 text-muted">{p.nombre}</li>)}
        </ul>
      </section>
    </div>
  )}
</Layout>
