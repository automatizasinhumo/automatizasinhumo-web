---
import Layout from '../../layouts/Layout.astro';
import '../../styles/estudio.css';
import Progreso from '../../themes/limpio/ui/Progreso.astro';
import {
  COLORES_CV,
  DISENO_POR_DEFECTO,
  DISENOS_CV,
  ESPACIADOS,
  ESTILOS_LETRA,
  EXTRAS_CV,
  FILTROS_DISENO,
  MOTOR_CV,
  PAQUETES_CV,
  PASOS_CV,
  TAMANOS,
  euros,
  filtrosDe,
  miniaturaCv,
} from '../../features/servicios/cv';

// Estudio de CV: sección nueva de servicios, todavía sin publicar (noindex y sin enlaces).
// Todo ocurre en el navegador: elegir diseño, rellenar, personalizar y ver la vista previa
// con marca de agua. El motor (cv-estudio/) se carga solo al elegir un diseño.
Astro.response.headers.set('X-Robots-Tag', 'noindex');

const { disenada, personalizable } = PAQUETES_CV;
const formas = [
  ['ninguna', 'Sin formas'],
  ['circulos', 'Círculos'],
  ['rombos', 'Rombos'],
  ['ondas', 'Ondas'],
  ['esquinas', 'Esquinas'],
  ['puntos', 'Puntos'],
  ['franja', 'Franja lateral'],
] as const;
const config = JSON.stringify({
  motor: MOTOR_CV,
  porDefecto: DISENO_POR_DEFECTO,
  disenos: DISENOS_CV,
  paquetes: PAQUETES_CV,
  extras: EXTRAS_CV,
});
const campo = 'campo';
---

<Layout
  title="Tu currículum paso a paso: elige diseño, rellena y descarga"
  description="Elige un diseño de CV, rellena tus datos y míralo al momento. Diseños listos o personalizables con tu color, formas y sombreado."
  sinAviso
>
  <div id="estudio-cv" class="estudio" data-config={config}>
    <header class="fondo-tecnico cabecera-pagina">
      <span class="etiqueta">Servicios · Currículum</span>
      <h1 class="mt-4 max-w-3xl font-serif text-4xl font-bold leading-tight text-ink sm:text-5xl">Tu currículum, paso a paso</h1>
      <p class="mt-5 max-w-2xl text-lg leading-7 text-muted">
        Elige un diseño, escribe tus datos una sola vez y míralo al momento. Si quieres darle tu toque, la versión personalizable
        te deja cambiar el color y añadir formas.
      </p>
    </header>

    <div class="progreso-fijo">
      <Progreso pasos={PASOS_CV} etiqueta="Pasos para hacer tu currículum" />
    </div>

    <form id="estudio-form" class="mt-8" novalidate autocomplete="on">
      <!-- 1 · Diseño -->
      <section data-paso="plantilla" aria-labelledby="paso-plantilla">
        <h2 id="paso-plantilla" class="paso-titulo">Elige el diseño que más te guste</h2>
        <p class="paso-entradilla">Debajo de cada uno tienes el precio final. Podrás cambiarlo después sin volver a escribir nada.</p>

        <fieldset class="mt-6">
          <legend class="sr-only">Diseño del currículum</legend>

          <label class="tarjeta destacada">
            <input type="radio" name="diseno" value="personalizable" class="sr-only" />
            <img src={miniaturaCv('personalizable')} alt="Ejemplo de currículum personalizado con círculos terracota y sombreado" width="480" height="679" loading="lazy" decoding="async" />
            <span class="destacada-texto">
              <span class="etiqueta">A tu manera</span>
              <strong class="mt-3 block font-serif text-2xl text-ink">{personalizable.nombre}</strong>
              <span class="mt-2 block text-muted">{personalizable.resumen}</span>
              <ul class="incluye">
                {personalizable.incluye.map((x) => <li>{x}</li>)}
              </ul>
              <span class="precio precio-grande">{euros(personalizable.precio)}</span>
              <span class="elegir" aria-hidden="true">Elegir personalizable</span>
            </span>
          </label>

          <p class="rejilla-titulo">O elige uno de nuestros diseños listos · <strong>{euros(disenada.precio)}</strong></p>
          <div class="filtros" role="radiogroup" aria-label="Ver diseños" data-filtros-diseno>
            {FILTROS_DISENO.map((f, i) => (
              <label class="forma">
                <input type="radio" name="ver" value={f.id} class="sr-only" checked={i === 0} />
                <span>{f.nombre} <small>{DISENOS_CV.filter(f.cumple).length}</small></span>
              </label>
            ))}
          </div>
          <p class="filtro-nota" data-nota-filtro="una-columna" hidden>Los filtros automáticos de las empresas leen mejor los diseños de una columna.</p>
          <div class="rejilla">
            {DISENOS_CV.map((d) => (
              <label class="tarjeta diseno" data-filtros={filtrosDe(d)}>
                <input type="radio" name="diseno" value={d.id} class="sr-only" />
                <img src={miniaturaCv(d.id)} alt={`Diseño ${d.nombre}: ${d.estilo.toLowerCase()}`} width="480" height="679" loading="lazy" decoding="async" />
                <span class="diseno-pie">
                  <span class="min-w-0">
                    <strong class="block truncate text-ink">{d.nombre}</strong>
                    <span class="block truncate text-xs text-faint">{d.estilo}</span>
                  </span>
                  <span class="precio">{euros(disenada.precio)}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>
        <p class="aviso" role="alert" data-error="plantilla" hidden>Elige un diseño para seguir.</p>
        <div class="paso-acciones">
          <button type="button" class="boton boton-principal" data-siguiente>Siguiente: tus datos</button>
        </div>
      </section>

      <!-- 2 · Datos -->
      <section data-paso="datos" aria-labelledby="paso-datos" hidden>
        <h2 id="paso-datos" class="paso-titulo">Escribe tus datos</h2>
        <p class="paso-entradilla">Lo que escribes se guarda solo en este navegador. A la derecha ves cómo queda.</p>
        <div class="con-vista">
          <div class="min-w-0">
            <div class="flex flex-wrap gap-2">
              <label class="boton boton-principal boton-compacto importar">
                <input type="file" name="importar" class="sr-only" accept=".pdf,.docx,.zip,.json,application/pdf" data-importar />
                Usar mi CV actual
              </label>
              <button type="button" class="boton boton-secundario boton-compacto" data-ejemplo>Rellenar con un ejemplo</button>
              <button type="button" class="boton boton-secundario boton-compacto" data-vaciar>Empezar en blanco</button>
            </div>
            <p class="importar-nota" data-estado-importar role="status" aria-live="polite">
              ¿Ya tienes un CV? Súbelo en PDF o Word, o la exportación de LinkedIn (.zip), y rellenamos los campos por ti. Se lee en tu navegador.
            </p>

            <fieldset class="bloque">
              <legend>Sobre ti</legend>
              <div class="filas">
                <label class={campo}>Nombre y apellidos *<input name="nombre" autocomplete="name" required maxlength="120" /></label>
                <label class={campo}>Puesto o titular<input name="titular" autocomplete="organization-title" maxlength="160" placeholder="Ej.: Administrativa contable" /></label>
                <label class={campo}>Correo<input name="email" type="email" autocomplete="email" maxlength="160" /></label>
                <label class={campo}>Teléfono<input name="telefono" type="tel" autocomplete="tel" maxlength="60" /></label>
                <label class={campo}>Ciudad<input name="ubicacion" autocomplete="address-level2" maxlength="120" /></label>
              </div>
              <label class={campo}>Resumen<textarea name="resumen" rows="4" maxlength="1500" placeholder="Dos o tres frases: qué haces y qué has conseguido."></textarea></label>
            </fieldset>

            <fieldset class="bloque" data-lista="experiencia">
              <legend>Experiencia</legend>
              <div data-items></div>
              <button type="button" class="anadir" data-anadir>+ Añadir experiencia</button>
            </fieldset>

            <fieldset class="bloque" data-lista="formacion">
              <legend>Formación</legend>
              <div data-items></div>
              <button type="button" class="anadir" data-anadir>+ Añadir formación</button>
            </fieldset>

            <fieldset class="bloque" data-lista="habilidades">
              <legend>Habilidades</legend>
              <div data-items></div>
              <button type="button" class="anadir" data-anadir>+ Añadir habilidad</button>
            </fieldset>

            <fieldset class="bloque" data-lista="idiomas">
              <legend>Idiomas</legend>
              <div data-items></div>
              <button type="button" class="anadir" data-anadir>+ Añadir idioma</button>
            </fieldset>
          </div>
          <div data-hueco-vista></div>
        </div>
        <p class="aviso" role="alert" data-error="datos" hidden>Escribe al menos tu nombre para seguir.</p>
        <div class="paso-acciones">
          <button type="button" class="boton boton-secundario" data-atras>Atrás</button>
          <button type="button" class="boton boton-principal" data-siguiente>Siguiente: personaliza</button>
        </div>
      </section>

      <!-- 3 · Personaliza -->
      <section data-paso="personaliza" aria-labelledby="paso-personaliza" hidden>
        <h2 id="paso-personaliza" class="paso-titulo">Dale tu toque</h2>
        <p class="paso-entradilla">Elige la letra y el tamaño<span data-solo="personalizable">, y cambia la base, el color y las formas</span>. La vista previa se actualiza sola.</p>
        <div class="con-vista">
          <div class="min-w-0">
            <fieldset class="bloque">
              <legend>Letra</legend>
              <div class="letras">
                {ESTILOS_LETRA.map((e) => (
                  <label class="letra">
                    <input type="radio" name="letra" value={e.id} class="sr-only" />
                    <strong>{e.nombre}</strong>
                    <span>{e.descripcion}</span>
                  </label>
                ))}
              </div>
              <div class="medidas">
                <div role="radiogroup" aria-label="Tamaño de letra">
                  <span class="medida-titulo" aria-hidden="true">Tamaño</span>
                  <div class="formas">
                    {TAMANOS.map((t) => (
                      <label class="forma">
                        <input type="radio" name="tamano" value={t.id} class="sr-only" />
                        <span>{t.nombre}</span>
                      </label>
                    ))}
                  </div>
                </div>
                <div role="radiogroup" aria-label="Espaciado">
                  <span class="medida-titulo" aria-hidden="true">Espaciado</span>
                  <div class="formas">
                    {ESPACIADOS.map((t) => (
                      <label class="forma">
                        <input type="radio" name="espaciado" value={t.id} class="sr-only" />
                        <span>{t.nombre}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </div>
            </fieldset>

            <div class="tarjeta mejora" data-solo="disenada">
              <p class="font-semibold text-ink">Los colores y las formas van tal cual, como en la miniatura.</p>
              <p class="mt-1 text-muted">
                Con la versión personalizable eliges el color y añades círculos, rombos, ondas o sombreado
                por <strong class="text-ink" data-diferencia></strong> más.
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                <button type="button" class="boton boton-secundario boton-compacto" data-pasar-personalizable>Probar la personalizable</button>
              </div>
            </div>

            <div data-solo="personalizable">
              <fieldset class="bloque">
                <legend>Diseño de partida</legend>
                <label class={campo}>Base
                  <select name="base">
                    {DISENOS_CV.map((d) => <option value={d.id}>{d.nombre} · {d.estilo}</option>)}
                  </select>
                </label>
              </fieldset>

              <fieldset class="bloque">
                <legend>Color</legend>
                <div class="muestras">
                  {COLORES_CV.map((c) => (
                    <label class="muestra" title={c.nombre}>
                      <input type="radio" name="color" value={c.valor} class="sr-only" />
                      <span style={`--muestra:${c.valor}`} aria-hidden="true"></span>
                      <span class="sr-only">{c.nombre}</span>
                    </label>
                  ))}
                  <label class="muestra muestra-libre" title="Otro color">
                    <input type="color" name="colorLibre" value="#176b5a" aria-label="Otro color" />
                  </label>
                </div>
              </fieldset>

              <fieldset class="bloque">
                <legend>Formas</legend>
                <div class="formas">
                  {formas.map(([v, t]) => (
                    <label class="forma">
                      <input type="radio" name="forma" value={v} class="sr-only" />
                      <span>{t}</span>
                    </label>
                  ))}
                </div>
                <label class={campo}>Intensidad
                  <input type="range" name="intensidad" min="0.2" max="1" step="0.1" value="0.7" />
                </label>
                <label class="casilla"><input type="checkbox" name="sombreado" /> Sombreado de fondo en la cabecera</label>
              </fieldset>
            </div>
          </div>
          <div data-hueco-vista></div>
        </div>
        <div class="paso-acciones">
          <button type="button" class="boton boton-secundario" data-atras>Atrás</button>
          <button type="button" class="boton boton-principal" data-siguiente>Siguiente: revisa</button>
        </div>
      </section>

      <!-- 4 · Revisa -->
      <section data-paso="revisa" aria-labelledby="paso-revisa" hidden>
        <h2 id="paso-revisa" class="paso-titulo">Revisa cómo queda</h2>
        <p class="paso-entradilla">Así sale tu currículum, página a página. La marca de agua desaparece en el PDF que descargas.</p>
        <ul class="repaso" data-repaso></ul>
        <div class="revisa-vista" data-hueco-vista></div>
        <div class="paso-acciones">
          <button type="button" class="boton boton-secundario" data-atras>Atrás</button>
          <button type="button" class="boton boton-principal" data-siguiente>Todo bien: ir a descargar</button>
        </div>
      </section>

      <!-- 5 · Descarga -->
      <section data-paso="descarga" aria-labelledby="paso-descarga" hidden>
        <h2 id="paso-descarga" class="paso-titulo">Descarga tu currículum</h2>
        <div class="tarjeta resumen">
          <dl>
            <div><dt>Diseño</dt><dd data-res="diseno"></dd></div>
            <div><dt>Modalidad</dt><dd data-res="modalidad"></dd></div>
          </dl>
          <ul class="incluye" data-res="incluye"></ul>
          <div data-solo-compra>
            {
              EXTRAS_CV.map((x) => (
                <label class="extra" id={x.id}>
                  <input type="checkbox" value={x.id} data-extra={x.producto} />
                  <span>
                    <strong>
                      Añadir {x.nombre.toLowerCase()} · {euros(x.precio)}
                    </strong>
                    <small>{x.resumen}</small>
                  </span>
                </label>
              ))
            }
            <p class="total"><span>Total</span><strong data-res="precio"></strong></p>
          </div>
          <p class="pagado" data-solo-pagado hidden>Pedido <strong data-res="ref"></strong> pagado. Tu PDF sale sin marca de agua.</p>
          <button type="button" class="boton boton-principal boton-destello w-full" data-comprar><span>Comprar y descargar el PDF</span></button>
          <p class="mt-3 text-sm text-faint" role="status" data-estado-compra>PDF sin marca de agua, listo para enviar.</p>
        </div>

        <!-- Tarjeta digital pagada: se publica aquí mismo con los datos del CV. -->
        <div class="tarjeta publicar" data-tarjeta-form hidden>
          <h3 class="font-serif text-xl font-bold text-ink">Tu tarjeta digital</h3>
          <p class="mt-1 text-sm text-muted">Hemos rellenado los datos de tu CV. Cámbialos si quieres y publícala: queda en línea al momento.</p>
          <div class="filas mt-4">
            <label class="campo">Nombre<input data-t="nombre" maxlength="80" autocomplete="name" /></label>
            <label class="campo">Cargo<input data-t="cargo" maxlength="100" /></label>
            <label class="campo">Correo<input data-t="email" type="email" maxlength="254" autocomplete="email" /></label>
            <label class="campo">Teléfono<input data-t="telefono" type="tel" maxlength="24" autocomplete="tel" /></label>
            <label class="campo">Web<input data-t="web" maxlength="300" placeholder="tuweb.com" /></label>
            <label class="campo">Ciudad<input data-t="ubicacion" maxlength="80" /></label>
            <label class="campo">LinkedIn<input data-t="linkedin" maxlength="300" placeholder="linkedin.com/in/tu-nombre" /></label>
            <label class="campo">Color<input data-t="color" type="color" /></label>
          </div>
          <label class="campo">Presentación breve<textarea data-t="resumen" rows="2" maxlength="280"></textarea></label>
          <button type="button" class="boton boton-principal mt-4" data-publicar>Publicar mi tarjeta</button>
          <p class="mt-3 text-sm" role="status" data-estado-tarjeta></p>
        </div>
        <div class="paso-acciones">
          <button type="button" class="boton boton-secundario" data-atras>Atrás</button>
        </div>
      </section>
    </form>

    <!-- Vista previa: un único panel que el script mueve al paso activo. -->
    <aside class="vista" aria-label="Vista previa del currículum" data-vista hidden>
      <p class="vista-estado" role="status" data-estado>Preparando la vista previa…</p>
      <div class="vista-lienzo" data-lienzo></div>
    </aside>

    <p class="mt-12 text-xs text-faint">
      Diseños basados en <a class="underline" href="https://github.com/amruthpillai/reactive-resume" rel="noopener">Reactive Resume</a> (licencia MIT).{' '}
      <a class="underline" href="/cv/estudio/motor/LICENCIAS.txt">Licencias</a>.
    </p>
  </div>

  <template id="t-experiencia">
    <div class="item">
      <div class="filas">
        <label class={campo}>Puesto<input data-k="puesto" maxlength="160" /></label>
        <label class={campo}>Empresa<input data-k="empresa" maxlength="160" /></label>
        <label class={campo}>Ciudad<input data-k="lugar" maxlength="120" /></label>
        <label class={campo}>Fechas<input data-k="periodo" maxlength="60" placeholder="2021 – actualidad" /></label>
      </div>
      <label class={campo}>Logros y tareas <span class="ayuda">(uno por línea)</span><textarea data-k="descripcion" rows="3" maxlength="2000"></textarea></label>
      <button type="button" class="quitar" data-quitar>Quitar</button>
    </div>
  </template>
  <template id="t-formacion">
    <div class="item">
      <div class="filas">
        <label class={campo}>Título<input data-k="titulo" maxlength="200" /></label>
        <label class={campo}>Centro<input data-k="centro" maxlength="160" /></label>
        <label class={campo}>Ciudad<input data-k="lugar" maxlength="120" /></label>
        <label class={campo}>Fechas<input data-k="periodo" maxlength="60" placeholder="2012 – 2016" /></label>
      </div>
      <button type="button" class="quitar" data-quitar>Quitar</button>
    </div>
  </template>
  <template id="t-habilidades">
    <div class="item">
      <div class="filas">
        <label class={campo}>Habilidad<input data-k="nombre" maxlength="80" /></label>
        <label class={campo}>Nivel
          <select data-k="nivel">
            <option value="1">Básico</option><option value="2">Elemental</option><option value="3" selected>Intermedio</option>
            <option value="4">Avanzado</option><option value="5">Experto</option>
          </select>
        </label>
      </div>
      <label class={campo}>Herramientas o detalle <span class="ayuda">(separadas por comas)</span><input data-k="detalle" maxlength="200" /></label>
      <button type="button" class="quitar" data-quitar>Quitar</button>
    </div>
  </template>
  <template id="t-idiomas">
    <div class="item">
      <div class="filas">
        <label class={campo}>Idioma<input data-k="idioma" maxlength="60" /></label>
        <label class={campo}>Nivel<input data-k="nivel" maxlength="40" placeholder="B2, nativo…" /></label>
        <label class={campo}>Dominio
          <select data-k="puntos">
            <option value="1">1 de 5</option><option value="2">2 de 5</option><option value="3" selected>3 de 5</option>
            <option value="4">4 de 5</option><option value="5">5 de 5</option>
          </select>
        </label>
      </div>
      <button type="button" class="quitar" data-quitar>Quitar</button>
    </div>
  </template>
</Layout>

<script>
  import { iniciarEstudioCv } from '../../features/servicios/estudioCv';

  iniciarEstudioCv();
</script>
