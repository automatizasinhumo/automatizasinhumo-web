---
import Layout from '../../layouts/Layout.astro';
import '../../styles/estudio.css';
import Progreso from '../../themes/limpio/ui/Progreso.astro';
import {
  ASESORIA_CV,
  CAMINOS_CV,
  COLORES_CV,
  DISENO_DESDE_CERO,
  DISENO_POR_DEFECTO,
  DISENOS_CV,
  ESPACIADOS,
  ESTILOS_LETRA,
  EXTRAS_CV,
  FILTROS_DISENO,
  FONDOS,
  GUIA_CV,
  LIMITES_CV,
  FORMAS,
  MOTOR_CV,
  PAQUETES_CV,
  PASOS_CV,
  POSICIONES,
  SOMBREADOS,
  TAMANOS,
  euros,
  filtrosDe,
  leeAts,
  miniaturaCv,
} from '../../features/servicios/cv';
import { LIMITES_TARJETA, MODELOS_TARJETA } from '../../features/servicios/modelosTarjeta';
import { ZOOM_MAX } from '../../features/servicios/fotoCv';
import TarjetaDigital from '../../features/servicios/TarjetaDigital.astro';
import type { DatosTarjeta } from '../../features/servicios/publicados';

// Estudio de CV: sección nueva de servicios, todavía sin publicar (noindex y sin enlaces).
// Todo ocurre en el navegador: elegir diseño, rellenar, personalizar y ver la vista previa
// con marca de agua. El motor (cv-estudio/) se carga solo al elegir un diseño.
Astro.response.headers.set('X-Robots-Tag', 'noindex');

const { personalizable, disenada } = PAQUETES_CV;
const config = JSON.stringify({
  motor: MOTOR_CV,
  porDefecto: DISENO_POR_DEFECTO,
  desdeCero: DISENO_DESDE_CERO,
  disenos: DISENOS_CV,
  guia: GUIA_CV,
  paquetes: PAQUETES_CV,
  extras: EXTRAS_CV,
});
const campo = 'campo';
// Tarjeta de ejemplo para el configurador: así se ve cada modelo antes de poner tus datos.
const ejemploTarjeta: DatosTarjeta = {
  nombre: 'Lucía Martín',
  cargo: 'Responsable de atención al cliente',
  email: 'lucia@correo.es',
  telefono: '+34 600 123 456',
  web: 'https://lucia-martin.es',
  ubicacion: 'Valencia',
  resumen: 'Ocho años coordinando equipos de atención al cliente.',
  enlaces: [{ etiqueta: 'LinkedIn', url: 'https://linkedin.com/in/lucia-martin' }],
  color: '#176b5a',
  modelo: 'clasica',
  qr: true,
};
---

<Layout
  title="Tu currículum paso a paso: elige diseño, rellena y descarga"
  description="Elige un diseño de CV, rellena tus datos y míralo al momento. Diseños listos o personalizables con tu color, formas y sombreado."
  sinAviso
>
  <div id="estudio-cv" class="estudio" data-config={config}>
    <header class="fondo-tecnico cabecera-pagina">
      <span class="etiqueta">Servicios · Currículum</span>
      <h1 class="mt-4 max-w-3xl font-serif text-4xl font-bold leading-tight text-ink sm:text-5xl">Tu currículum, paso a paso</h1>
      <p class="mt-5 max-w-2xl text-lg leading-7 text-muted">
        Elige un diseño viendo un ejemplo, escribe tus datos una sola vez y míralo al momento. Si quieres darle tu toque,
        puedes cambiar los colores, las formas, el sombreado y el fondo.
      </p>
    </header>

    <div class="progreso-fijo">
      <Progreso pasos={PASOS_CV} etiqueta="Pasos para hacer tu currículum" />
      <button type="button" class="guia-boton" data-guia-abrir>Guía de este paso</button>
    </div>

    <form id="estudio-form" class="mt-8" novalidate autocomplete="on">
      <!-- 1 · Diseño y estilo: se elige viendo un ejemplo; los datos van después -->
      <section data-paso="diseno" aria-labelledby="paso-diseno">
        <h2 id="paso-diseno" class="paso-titulo">¿Cómo quieres tu CV?</h2>
        <p class="paso-entradilla">Elige cómo hacerlo; puedes cambiar de idea cuando quieras sin perder nada. Lo ves al momento con un ejemplo.</p>
        <fieldset class="caminos" data-guia="caminos">
          <legend class="sr-only">Cómo quieres hacer tu CV</legend>
          {CAMINOS_CV.map((c) => (
            <label class="camino">
              <input type="radio" name="camino" value={c.id} class="sr-only" />
              <span class="camino-etiqueta">{c.etiqueta}</span>
              <strong class="camino-titulo">{c.titulo}</strong>
              <span class="camino-precio">{c.desde ? 'Desde ' : ''}{euros(c.precio)}</span>
              <span class="camino-resumen">{c.resumen}</span>
            </label>
          ))}
        </fieldset>

        <div class="tarjeta asesoria" data-solo-camino="asesoria" hidden>
          <h3>Te preparamos el CV</h3>
          <p>Una persona revisa tu trayectoria y el puesto que buscas, y te entrega el CV listo (y, si quieres, la carta). Cuéntanos tu caso en el formulario: te respondemos por email con el precio cerrado antes de empezar. Desde <strong>{euros(ASESORIA_CV.desde)}</strong>.</p>
          <a class="boton boton-principal" href={ASESORIA_CV.enlace}>Contarnos tu caso</a>
          <p class="ayuda-bloque">¿Prefieres hacerlo tú? Elige «Usa una plantilla» o «Diseña tu CV» arriba.</p>
        </div>

        <div class="con-vista" data-oculto-en="asesoria">
          <div class="min-w-0">
            <fieldset class="bloque" data-solo-camino="personaliza" data-guia="inicio" hidden>
              <legend>¿Desde dónde empiezas?</legend>
              <div class="formas" role="radiogroup" aria-label="Desde dónde empiezas">
                <label class="forma">
                  <input type="radio" name="inicio" value="plantilla" class="sr-only" />
                  <span>Desde una plantilla</span>
                </label>
                <label class="forma">
                  <input type="radio" name="inicio" value="cero" class="sr-only" />
                  <span>Desde cero</span>
                </label>
              </div>
              <p class="ayuda-bloque" data-solo-inicio="cero" hidden>Empiezas con un diseño limpio de una columna (el que mejor leen los filtros de las empresas) y lo vistes con tus colores y formas abajo.</p>
            </fieldset>

            <fieldset class="bloque" data-guia="galeria" data-galeria>
              <legend>Diseño</legend>
              <div class="filtros" role="radiogroup" aria-label="Ver diseños" data-filtros-diseno data-guia="filtros">
                {FILTROS_DISENO.map((f, i) => (
                  <label class="forma">
                    <input type="radio" name="ver" value={f.id} class="sr-only" checked={i === 0} />
                    <span>{f.nombre} <small>{DISENOS_CV.filter(f.cumple).length}</small></span>
                  </label>
                ))}
              </div>
              <p class="filtro-nota" data-nota-filtro="ats" hidden>Probados con dos lectores de PDF y un lector de CV: el nombre sale arriba, los apartados no se mezclan y se recuperan tus datos. El PDF que descargas es texto seleccionable, sin marca de agua.</p>
              <div class="rejilla rejilla-caja" tabindex="0" role="group" aria-label="Diseños de currículum">
                {DISENOS_CV.map((d) => (
                  <label class="tarjeta diseno" data-filtros={filtrosDe(d)}>
                    <input type="radio" name="diseno" value={d.id} class="sr-only" />
                    <img src={miniaturaCv(d.id)} alt={`Diseño ${d.nombre}: ${d.estilo.toLowerCase()}`} width="480" height="679" loading="lazy" decoding="async" />
                    <span class="diseno-pie">
                      <span class="min-w-0">
                        <strong class="block truncate text-ink">{d.nombre}</strong>
                        <span class="block truncate text-xs text-faint">{d.estilo}</span>
                      </span>
                      {leeAts(d) && <span class="sello-ats" title="Lo lee bien un filtro automático (ATS)">ATS</span>}
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset class="bloque" data-guia="letra">
              <legend>Letra</legend>
              {/* Las mismas fuentes que el PDF (las emite el motor), para ver cada letra antes de elegirla. */}
              <link rel="stylesheet" href="/cv/estudio/motor/fuentes.css" />
              <div class="letras">
                {ESTILOS_LETRA.map((e) => (
                  <label class="letra" style={`--letra-titulos:"CV ${e.titulos}";--letra-texto:"CV ${e.texto}"`}>
                    <input type="radio" name="letra" value={e.id} class="sr-only" />
                    <strong>{e.nombre}</strong>
                    <span>{e.descripcion}</span>
                  </label>
                ))}
              </div>
              <div class="medidas">
                <div role="radiogroup" aria-label="Tamaño de letra">
                  <span class="medida-titulo" aria-hidden="true">Tamaño</span>
                  <div class="formas">
                    {TAMANOS.map((t) => (
                      <label class="forma">
                        <input type="radio" name="tamano" value={t.id} class="sr-only" />
                        <span>{t.nombre}</span>
                      </label>
                    ))}
                  </div>
                </div>
                <div role="radiogroup" aria-label="Espaciado">
                  <span class="medida-titulo" aria-hidden="true">Espaciado</span>
                  <div class="formas">
                    {ESPACIADOS.map((t) => (
                      <label class="forma">
                        <input type="radio" name="espaciado" value={t.id} class="sr-only" />
                        <span>{t.nombre}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </div>
            </fieldset>

            <p class="tarjeta mejora mejora-aviso" data-solo-camino="plantilla">
              <span>¿Quieres tus colores, formas y fondo? <strong>+{euros(personalizable.precio - disenada.precio)}</strong></span>
              <button type="button" class="boton boton-compacto" data-a-camino="personaliza">Diseñar el mío</button>
            </p>

            <fieldset class="bloque tarjeta mejora" data-guia="personalizar" data-solo-camino="personaliza" hidden>
              <legend>A tu manera</legend>
              <p class="ayuda-bloque">Tu color, formas, sombreado y fondo. Lo ves a la derecha mientras lo cambias.</p>
              <div>
                <div class="subbloque">
                  <span class="medida-titulo">Color principal</span>
                  <div class="muestras">
                    {COLORES_CV.map((c) => (
                      <label class="muestra" title={c.nombre}>
                        <input type="radio" name="color" value={c.valor} class="sr-only" />
                        <span style={`--muestra:${c.valor}`} aria-hidden="true"></span>
                        <span class="sr-only">{c.nombre}</span>
                      </label>
                    ))}
                    <label class="muestra muestra-libre" title="Otro color">
                      <input type="color" name="colorLibre" value="#176b5a" aria-label="Otro color" />
                    </label>
                  </div>
                </div>
                <div class="subbloque">
                  <span class="medida-titulo">Color de acento</span>
                  <div class="muestras">
                    {COLORES_CV.map((c) => (
                      <label class="muestra" title={c.nombre}>
                        <input type="radio" name="color2" value={c.valor} class="sr-only" />
                        <span style={`--muestra:${c.valor}`} aria-hidden="true"></span>
                        <span class="sr-only">{c.nombre}</span>
                      </label>
                    ))}
                    <label class="muestra muestra-libre" title="Otro color">
                      <input type="color" name="colorLibre2" value="#e0a526" aria-label="Otro color" />
                    </label>
                  </div>
                </div>
                <div class="subbloque" role="radiogroup" aria-label="Forma decorativa">
                  <span class="medida-titulo" aria-hidden="true">Forma</span>
                  <div class="formas">
                    {Object.entries(FORMAS).map(([v, t]) => (
                      <label class="forma">
                        <input type="radio" name="forma" value={v} class="sr-only" />
                        <span>{t}</span>
                      </label>
                    ))}
                  </div>
                </div>
                <div class="subbloque" role="radiogroup" aria-label="Dónde van las formas">
                  <span class="medida-titulo" aria-hidden="true">Dónde</span>
                  <div class="formas">
                    {Object.entries(POSICIONES).map(([v, t]) => (
                      <label class="forma">
                        <input type="radio" name="posicion" value={v} class="sr-only" />
                        <span>{t}</span>
                      </label>
                    ))}
                  </div>
                </div>
                <div class="subbloque">
                  <label class="campo">Intensidad de formas y sombreado
                    <input type="range" name="intensidad" min="0.1" max="1" step="0.05" value="0.7" />
                  </label>
                </div>
                <div class="subbloque" role="radiogroup" aria-label="Sombreado">
                  <span class="medida-titulo" aria-hidden="true">Sombreado</span>
                  <div class="formas">
                    {Object.entries(SOMBREADOS).map(([v, t]) => (
                      <label class="forma">
                        <input type="radio" name="sombreado" value={v} class="sr-only" />
                        <span>{t}</span>
                      </label>
                    ))}
                  </div>
                </div>
                <div class="subbloque" role="radiogroup" aria-label="Fondo de la página">
                  <span class="medida-titulo" aria-hidden="true">Fondo</span>
                  <div class="formas">
                    {Object.entries(FONDOS).map(([v, t]) => (
                      <label class="forma">
                        <input type="radio" name="fondo" value={v} class="sr-only" />
                        <span>{t}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </div>
            </fieldset>
          </div>
          <div data-hueco-vista></div>
        </div>
        <div class="paso-acciones" data-oculto-en="asesoria">
          <button type="button" class="boton boton-principal" data-siguiente data-guia="siguiente">Siguiente: tus datos</button>
        </div>
      </section>

      <!-- 2 · Datos -->
      <section data-paso="datos" aria-labelledby="paso-datos" hidden>
        <h2 id="paso-datos" class="paso-titulo">Escribe tus datos</h2>
        <p class="paso-entradilla">Lo que escribes se guarda solo en este navegador. A la derecha ves cómo queda.</p>
        <div class="con-vista">
          <div class="min-w-0">
            <div class="flex flex-wrap gap-2" data-guia="importar">
              <label class="boton boton-principal boton-compacto importar">
                <input type="file" name="importar" class="sr-only" accept=".pdf,.docx,.zip,.json,application/pdf" data-importar />
                Usar mi CV actual
              </label>
              <button type="button" class="boton boton-secundario boton-compacto" data-ejemplo>Rellenar con un ejemplo</button>
              <button type="button" class="boton boton-secundario boton-compacto" data-vaciar>Empezar en blanco</button>
            </div>
            <p class="importar-nota" data-estado-importar role="status" aria-live="polite">
              ¿Ya tienes un CV? Súbelo en PDF o Word, o la exportación de LinkedIn (.zip), y rellenamos los campos por ti. Se lee en tu navegador.
            </p>
            <details class="importar-ayuda" data-importar-ayuda>
              <summary>¿Qué archivos sirven?</summary>
              <ul>
                <li><strong>PDF</strong> hecho con Word, Canva, Google Docs, InfoJobs o Europass. Una foto o un escaneo no tiene texto que leer: en ese caso, mejor el Word.</li>
                <li><strong>Word (.docx)</strong>. Si es un .doc antiguo, ábrelo y guárdalo como .docx.</li>
                <li><strong>LinkedIn</strong>: en tu perfil, «Más» → «Guardar en PDF», y sube ese PDF. O pide tus datos en «Configuración y privacidad» → «Privacidad de datos» → «Obtener una copia de tus datos» y sube el .zip que te mandan.</li>
                <li><strong>JSON Resume (.json)</strong>, si vienes de Reactive Resume u otro editor que lo exporte.</li>
              </ul>
              <p>Hasta 10 MB. Después te decimos qué no hemos encontrado para que lo añadas.</p>
            </details>

            <fieldset class="bloque" data-guia="sobre-ti">
              <legend>Sobre ti</legend>
              <div class="filas">
                <label class={campo}>Nombre y apellidos *<input name="nombre" autocomplete="name" required maxlength="120" /></label>
                <label class={campo}>Puesto o titular<input name="titular" autocomplete="organization-title" maxlength="160" placeholder="Ej.: Administrativa contable" /></label>
                <label class={campo}>Correo<input name="email" type="email" autocomplete="email" maxlength="160" /></label>
                <label class={campo}>Teléfono<input name="telefono" type="tel" autocomplete="tel" maxlength="60" /></label>
                <label class={campo}>Ciudad<input name="ubicacion" autocomplete="address-level2" maxlength="120" /></label>
                <label class={campo}>LinkedIn <span class="ayuda">(opcional)</span><input name="linkedin" maxlength="200" inputmode="url" placeholder="linkedin.com/in/tu-nombre" /></label>
                <label class={campo}>Web o portfolio <span class="ayuda">(opcional)</span><input name="web" type="text" inputmode="url" autocomplete="url" maxlength="300" placeholder="tuweb.es" /></label>
                <label class={campo}>Carnet de conducir <span class="ayuda">(opcional)</span><input name="carnet" maxlength="80" placeholder="B, vehículo propio" /></label>
              </div>
              <div class="foto-cv" data-guia="foto">
                <input type="hidden" name="foto" />
                <img data-foto-vista alt="Tu foto" width="72" height="72" hidden />
                <div class="grid gap-1">
                  <div class="flex flex-wrap gap-2">
                    <label class="boton boton-secundario boton-compacto importar">
                      <input type="file" name="fotoElegir" class="sr-only" accept="image/jpeg,image/png,image/webp,image/*" />
                      Añadir foto
                    </label>
                    <button type="button" class="boton boton-secundario boton-compacto" data-foto-quitar hidden>Quitar foto</button>
                  </div>
                  <small class="ayuda" data-foto-estado aria-live="polite">Opcional. JPG o PNG; la reducimos sola.</small>
                </div>
                <div class="foto-ajuste" data-foto-ajuste hidden>
                  <p class="ayuda">Arrastra la foto o usa los controles para encuadrarla.</p>
                  <label>Acercar<input type="range" min="1" max={ZOOM_MAX} step="0.05" data-ajuste="zoom" /></label>
                  <label>Izquierda · derecha<input type="range" min="0" max="100" step="1" data-ajuste="x" /></label>
                  <label>Arriba · abajo<input type="range" min="0" max="100" step="1" data-ajuste="y" /></label>
                  <button type="button" class="boton boton-secundario boton-compacto" data-foto-centrar>Centrar</button>
                </div>
              </div>
              <label class={campo}>Resumen <span class="ayuda">(2 o 3 frases)</span><textarea name="resumen" rows="4" maxlength={LIMITES_CV.resumen} data-cuenta placeholder="Dos o tres frases: qué haces y qué has conseguido."></textarea><small class="cuenta" aria-live="off"></small></label>
            </fieldset>

            <fieldset class="bloque" data-guia="listas" data-lista="experiencia" data-max={LIMITES_CV.items.experiencia}>
              <legend>Experiencia</legend>
              <div data-items></div>
              <button type="button" class="anadir" data-anadir>+ Añadir experiencia</button>
              <p class="limite" data-limite hidden>Es el máximo: con más, el CV se alarga y se lee peor.</p>
            </fieldset>

            <fieldset class="bloque" data-lista="formacion" data-max={LIMITES_CV.items.formacion}>
              <legend>Formación</legend>
              <div data-items></div>
              <button type="button" class="anadir" data-anadir>+ Añadir formación</button>
              <p class="limite" data-limite hidden>Es el máximo: con más, el CV se alarga y se lee peor.</p>
            </fieldset>

            <fieldset class="bloque" data-lista="habilidades" data-max={LIMITES_CV.items.habilidades}>
              <legend>Habilidades</legend>
              <div data-items></div>
              <button type="button" class="anadir" data-anadir>+ Añadir habilidad</button>
              <p class="limite" data-limite hidden>Es el máximo: con más, el CV se alarga y se lee peor.</p>
            </fieldset>

            <fieldset class="bloque" data-lista="idiomas" data-max={LIMITES_CV.items.idiomas}>
              <legend>Idiomas</legend>
              <div data-items></div>
              <button type="button" class="anadir" data-anadir>+ Añadir idioma</button>
              <p class="limite" data-limite hidden>Es el máximo: con más, el CV se alarga y se lee peor.</p>
            </fieldset>

            <details class="mas-apartados" data-mas-apartados data-guia="mas-apartados">
              <summary>Más apartados <span class="ayuda">(opcional: cursos, proyectos, voluntariado, premios…)</span></summary>
              <p class="ayuda">Añade solo los que te sumen para el puesto. Los vacíos no salen en el CV.</p>
              <fieldset class="bloque" data-lista="cursos" data-max={LIMITES_CV.items.cursos}>
                <legend>Cursos y certificaciones</legend>
                <div data-items></div>
                <button type="button" class="anadir" data-anadir>+ Añadir curso o certificado</button>
                <p class="limite" data-limite hidden>Es el máximo: con más, el CV se alarga y se lee peor.</p>
              </fieldset>
              <fieldset class="bloque" data-lista="proyectos" data-max={LIMITES_CV.items.proyectos}>
                <legend>Proyectos</legend>
                <div data-items></div>
                <button type="button" class="anadir" data-anadir>+ Añadir proyecto</button>
                <p class="limite" data-limite hidden>Es el máximo: con más, el CV se alarga y se lee peor.</p>
              </fieldset>
              <fieldset class="bloque" data-lista="voluntariado" data-max={LIMITES_CV.items.voluntariado}>
                <legend>Voluntariado</legend>
                <div data-items></div>
                <button type="button" class="anadir" data-anadir>+ Añadir voluntariado</button>
                <p class="limite" data-limite hidden>Es el máximo: con más, el CV se alarga y se lee peor.</p>
              </fieldset>
              <fieldset class="bloque" data-lista="premios" data-max={LIMITES_CV.items.premios}>
                <legend>Premios y reconocimientos</legend>
                <div data-items></div>
                <button type="button" class="anadir" data-anadir>+ Añadir premio</button>
                <p class="limite" data-limite hidden>Es el máximo: con más, el CV se alarga y se lee peor.</p>
              </fieldset>
              <fieldset class="bloque" data-lista="publicaciones" data-max={LIMITES_CV.items.publicaciones}>
                <legend>Publicaciones</legend>
                <div data-items></div>
                <button type="button" class="anadir" data-anadir>+ Añadir publicación</button>
                <p class="limite" data-limite hidden>Es el máximo: con más, el CV se alarga y se lee peor.</p>
              </fieldset>
              <fieldset class="bloque" data-lista="referencias" data-max={LIMITES_CV.items.referencias}>
                <legend>Referencias</legend>
                <div data-items></div>
                <button type="button" class="anadir" data-anadir>+ Añadir referencia</button>
                <p class="limite" data-limite hidden>Es el máximo: con más, el CV se alarga y se lee peor.</p>
              </fieldset>
              <fieldset class="bloque" data-lista="intereses" data-max={LIMITES_CV.items.intereses}>
                <legend>Aficiones e intereses</legend>
                <div data-items></div>
                <button type="button" class="anadir" data-anadir>+ Añadir afición</button>
                <p class="limite" data-limite hidden>Es el máximo: con más, el CV se alarga y se lee peor.</p>
              </fieldset>
            </details>
          </div>
          <div data-hueco-vista></div>
        </div>
        <p class="aviso" role="alert" data-error="datos" hidden>Escribe al menos tu nombre para seguir.</p>
        <div class="paso-acciones">
          <button type="button" class="boton boton-secundario" data-atras>Atrás</button>
          <button type="button" class="boton boton-principal" data-siguiente>Siguiente: revisa</button>
        </div>
      </section>

      <!-- 3 · Revisa -->
      <section data-paso="revisa" aria-labelledby="paso-revisa" hidden>
        <h2 id="paso-revisa" class="paso-titulo">Revisa cómo queda</h2>
        <p class="paso-entradilla">Así sale tu currículum, página a página. La marca de agua desaparece en el PDF que descargas.</p>
        <ul class="repaso" data-repaso data-guia="repaso"></ul>
        <div class="revisa-vista" data-hueco-vista></div>
        <div class="paso-acciones">
          <button type="button" class="boton boton-secundario" data-atras>Atrás</button>
          <button type="button" class="boton boton-principal" data-siguiente>Todo bien: siguiente</button>
        </div>
      </section>

      <!-- 4 · Añade: extras que van en el mismo pedido; nada de esto aparece en la descarga. -->
      <section data-paso="anade" aria-labelledby="paso-anade" hidden>
        <h2 id="paso-anade" class="paso-titulo">Cosas que puedes añadir</h2>
        <p class="paso-entradilla" data-entradilla-anade>Opcional. Tu CV ya está guardado: lo que marques aquí se suma al mismo pedido y no pierdes nada.</p>

        <details class="tarjeta portales" data-guia="portales">
          <summary>
            <strong>Pásalo a LinkedIn o InfoJobs</strong> <span class="gratis">Gratis</span>
            <small>Tus datos en trozos listos para pegar en cada casilla del portal, con aviso si alguno no cabe.</small>
          </summary>
          <div class="portales-lista" data-portales></div>
        </details>

        <div class="tarjeta extras-lista" data-guia="extras">
            {
              EXTRAS_CV.map((x) => (
                <label class="extra" id={x.id}>
                  <input type="checkbox" value={x.id} data-extra={x.producto} />
                  <span>
                    <strong>
                      Añadir {x.nombre.toLowerCase()} · {euros(x.precio)}
                    </strong>
                    <small>{x.resumen}</small>
                  </span>
                </label>
              ))
            }
            {
              EXTRAS_CV.map((x) => (
                <p class="extra-aparte" data-extra-aparte={x.id} hidden>
                  Tu pedido ya está pagado. {x.nombre} se compra aparte:{' '}
                  <a href={`/product/${x.slug}`}>{x.nombre.toLowerCase()} · {euros(x.precio)}</a>.
                </p>
              ))
            }
        </div>

        <!-- Tarjeta digital: se configura aquí (modelo, color, datos) en cuanto se elige el extra; se publica al pagarla. -->
        <div class="tarjeta publicar" data-tarjeta-form data-guia="tarjeta" hidden>
          <h3 class="font-serif text-xl font-bold text-ink">Diseña tu tarjeta digital</h3>
          <p class="mt-1 text-sm text-muted">
            Una página tuya con tu contacto y un QR para compartirla. Elige el modelo, ajusta los datos (los hemos sacado de tu CV) y
            mírala al momento.
          </p>

          <fieldset class="bloque mt-4" data-tj-modelos>
            <legend>Modelo</legend>
            <div class="rejilla-tj">
              {
                MODELOS_TARJETA.map((m) => (
                  <label class="tj-opcion">
                    <input type="radio" name="tj-modelo" value={m.id} checked={m.id === 'clasica'} />
                    <span class="tj-mini" aria-hidden="true">
                      <TarjetaDigital datos={{ ...ejemploTarjeta, modelo: m.id }} muestra />
                    </span>
                    <strong>{m.nombre}</strong>
                    <small>{m.resumen}</small>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="tj-editor mt-4">
            <div>
              <div class="filas">
                <label class="campo">Nombre<input data-t="nombre" maxlength={LIMITES_TARJETA.nombre} autocomplete="name" /></label>
                <label class="campo">Cargo<input data-t="cargo" maxlength={LIMITES_TARJETA.cargo} /></label>
                <label class="campo">Correo<input data-t="email" type="email" maxlength="254" autocomplete="email" /></label>
                <label class="campo">Teléfono<input data-t="telefono" type="tel" maxlength="24" autocomplete="tel" /></label>
                <label class="campo">Web<input data-t="web" maxlength="300" placeholder="tuweb.com" /></label>
                <label class="campo">Ciudad<input data-t="ubicacion" maxlength={LIMITES_TARJETA.ubicacion} /></label>
                <label class="campo">LinkedIn<input data-t="linkedin" maxlength="300" placeholder="linkedin.com/in/tu-nombre" /></label>
                <label class="campo">Color<input data-t="color" type="color" /></label>
              </div>
              <label class="campo">
                Presentación breve <span class="ayuda">(hasta {LIMITES_TARJETA.resumen} caracteres)</span>
                <textarea data-t="resumen" rows="3" maxlength={LIMITES_TARJETA.resumen}></textarea>
                <small class="cuenta" data-tj-cuenta aria-live="off"></small>
              </label>
              <label class="extra mt-3"><input type="checkbox" data-t="qr" checked /><span><strong>Mostrar el código QR</strong><small>Quien lo escanee abre tu tarjeta y guarda tu contacto.</small></span></label>
            </div>
            <div class="tj-vista" data-tarjeta-vista aria-label="Vista previa de tu tarjeta">
              <TarjetaDigital datos={ejemploTarjeta} muestra />
            </div>
          </div>

          <p class="mt-4 text-sm text-muted" data-tarjeta-nota>
            La tarjeta se publica en cuanto completes el pago (se compra junto al CV). Hasta entonces puedes probar modelos y colores sin límite.
          </p>
          <button type="button" class="boton boton-principal mt-4" data-publicar disabled>Publicar mi tarjeta</button>
          <p class="mt-3 text-sm" role="status" data-estado-tarjeta></p>
        </div>
        <div class="paso-acciones">
          <button type="button" class="boton boton-secundario" data-atras>Atrás</button>
          <button type="button" class="boton boton-principal" data-siguiente>Siguiente: descarga</button>
        </div>
      </section>

      <!-- 5 · Descarga -->
      <section data-paso="descarga" aria-labelledby="paso-descarga" hidden>
        <h2 id="paso-descarga" class="paso-titulo">Descarga tu currículum</h2>
        <div class="tarjeta resumen">
          <dl>
            <div><dt>Diseño</dt><dd data-res="diseno"></dd></div>
            <div><dt>Modalidad</dt><dd data-res="modalidad"></dd></div>
          </dl>
          <ul class="incluye" data-res="incluye"></ul>
          <div data-solo-compra>
            <ul class="incluye extras-elegidos" data-res="extras" hidden></ul>
            <p class="total"><span>Total</span><strong data-res="precio"></strong></p>
          </div>
          <p class="pagado" data-solo-pagado hidden>Pedido <strong data-res="ref"></strong> pagado. Tu PDF sale sin marca de agua.</p>
          <button type="button" class="boton boton-principal boton-destello w-full" data-comprar data-guia="comprar"><span>Comprar y descargar el PDF</span></button>
          <p class="mt-3 text-sm text-faint" role="status" data-estado-compra>PDF sin marca de agua, listo para enviar.</p>
        </div>

        <p class="tarjeta aviso-tarjeta" data-tarjeta-pendiente hidden>
          Tu tarjeta digital está pagada. <button type="button" class="enlace" data-ir="anade">Publícala desde «Añade»</button>.
        </p>
        <div class="paso-acciones">
          <button type="button" class="boton boton-secundario" data-atras>Atrás</button>
        </div>
      </section>
    </form>

    <!-- Vista previa: un único panel que el script mueve al paso activo. -->
    <aside class="vista" aria-label="Vista previa del currículum" data-vista data-guia="vista" hidden>
      <p class="vista-estado" role="status" data-estado>Preparando la vista previa…</p>
      <div class="vista-lienzo" data-lienzo></div>
    </aside>

  </div>

  <template id="t-experiencia">
    <div class="item">
      <div class="filas">
        <label class={campo}>Puesto<input data-k="puesto" maxlength="160" /></label>
        <label class={campo}>Empresa<input data-k="empresa" maxlength="160" /></label>
        <label class={campo}>Ciudad<input data-k="lugar" maxlength="120" /></label>
        <label class={campo}>Fechas<input data-k="periodo" maxlength="60" placeholder="2021 – actualidad" /></label>
      </div>
      <label class={campo}>Logros y tareas <span class="ayuda">(uno por línea, hasta {LIMITES_CV.lineasDescripcion})</span><textarea data-k="descripcion" rows="3" maxlength={LIMITES_CV.descripcion} data-lineas={LIMITES_CV.lineasDescripcion} data-cuenta></textarea><small class="cuenta" aria-live="off"></small></label>
      <button type="button" class="quitar" data-quitar>Quitar</button>
    </div>
  </template>
  <template id="t-formacion">
    <div class="item">
      <div class="filas">
        <label class={campo}>Título<input data-k="titulo" maxlength="200" /></label>
        <label class={campo}>Centro<input data-k="centro" maxlength="160" /></label>
        <label class={campo}>Ciudad<input data-k="lugar" maxlength="120" /></label>
        <label class={campo}>Fechas<input data-k="periodo" maxlength="60" placeholder="2012 – 2016" /></label>
      </div>
      <button type="button" class="quitar" data-quitar>Quitar</button>
    </div>
  </template>
  <template id="t-habilidades">
    <div class="item">
      <div class="filas">
        <label class={campo}>Habilidad<input data-k="nombre" maxlength="80" /></label>
        <label class={campo}>Nivel
          <select data-k="nivel">
            <option value="1">Básico</option><option value="2">Elemental</option><option value="3" selected>Intermedio</option>
            <option value="4">Avanzado</option><option value="5">Experto</option>
          </select>
        </label>
      </div>
      <label class={campo}>Herramientas o detalle <span class="ayuda">(separadas por comas)</span><input data-k="detalle" maxlength="200" /></label>
      <button type="button" class="quitar" data-quitar>Quitar</button>
    </div>
  </template>
  <template id="t-idiomas">
    <div class="item">
      <div class="filas">
        <label class={campo}>Idioma<input data-k="idioma" maxlength="60" /></label>
        <label class={campo}>Nivel<input data-k="nivel" maxlength="40" placeholder="B2, nativo…" /></label>
        <label class={campo}>Dominio
          <select data-k="puntos">
            <option value="1">1 de 5</option><option value="2">2 de 5</option><option value="3" selected>3 de 5</option>
            <option value="4">4 de 5</option><option value="5">5 de 5</option>
          </select>
        </label>
      </div>
      <button type="button" class="quitar" data-quitar>Quitar</button>
    </div>
  </template>
  <template id="t-cursos">
    <div class="item">
      <div class="filas">
        <label class={campo}>Nombre<input data-k="titulo" maxlength="160" placeholder="Prevención de riesgos laborales (60 h)" /></label>
        <label class={campo}>Centro o entidad<input data-k="entidad" maxlength="120" placeholder="SEPE" /></label>
        <label class={campo}>Año<input data-k="fecha" maxlength="40" placeholder="2024" /></label>
      </div>
      <button type="button" class="quitar" data-quitar>Quitar</button>
    </div>
  </template>
  <template id="t-proyectos">
    <div class="item">
      <div class="filas">
        <label class={campo}>Proyecto<input data-k="nombre" maxlength="160" /></label>
        <label class={campo}>Fechas<input data-k="periodo" maxlength="60" placeholder="2024" /></label>
        <label class={campo}>Enlace (opcional)<input data-k="enlace" maxlength="300" placeholder="github.com/…" inputmode="url" /></label>
      </div>
      <label class={campo}>Qué hiciste y qué conseguiste <span class="ayuda">(uno por línea)</span><textarea data-k="descripcion" rows="2" maxlength="700" data-lineas="4" data-cuenta></textarea><small class="cuenta" aria-live="off"></small></label>
      <button type="button" class="quitar" data-quitar>Quitar</button>
    </div>
  </template>
  <template id="t-voluntariado">
    <div class="item">
      <div class="filas">
        <label class={campo}>Organización<input data-k="organizacion" maxlength="160" placeholder="Cruz Roja" /></label>
        <label class={campo}>Ciudad<input data-k="lugar" maxlength="120" /></label>
        <label class={campo}>Fechas<input data-k="periodo" maxlength="60" placeholder="2022 – actualidad" /></label>
      </div>
      <label class={campo}>Qué hacías <span class="ayuda">(uno por línea)</span><textarea data-k="descripcion" rows="2" maxlength="700" data-lineas="4" data-cuenta></textarea><small class="cuenta" aria-live="off"></small></label>
      <button type="button" class="quitar" data-quitar>Quitar</button>
    </div>
  </template>
  <template id="t-premios">
    <div class="item">
      <div class="filas">
        <label class={campo}>Nombre<input data-k="titulo" maxlength="160" /></label>
        <label class={campo}>Quién lo concede<input data-k="entidad" maxlength="120" /></label>
        <label class={campo}>Año<input data-k="fecha" maxlength="40" placeholder="2024" /></label>
      </div>
      <button type="button" class="quitar" data-quitar>Quitar</button>
    </div>
  </template>
  <template id="t-publicaciones">
    <div class="item">
      <div class="filas">
        <label class={campo}>Nombre<input data-k="titulo" maxlength="160" /></label>
        <label class={campo}>Editorial o medio<input data-k="entidad" maxlength="120" /></label>
        <label class={campo}>Año<input data-k="fecha" maxlength="40" placeholder="2024" /></label>
      </div>
      <button type="button" class="quitar" data-quitar>Quitar</button>
    </div>
  </template>
  <template id="t-referencias">
    <div class="item">
      <div class="filas">
        <label class={campo}>Nombre<input data-k="nombre" maxlength="120" placeholder="Ana López" /></label>
        <label class={campo}>Cargo y empresa<input data-k="cargo" maxlength="160" placeholder="Directora, Tienda Levante" /></label>
        <label class={campo}>Teléfono o correo<input data-k="contacto" maxlength="80" /></label>
      </div>
      <button type="button" class="quitar" data-quitar>Quitar</button>
    </div>
  </template>
  <template id="t-intereses">
    <div class="item">
      <div class="filas">
        <label class={campo}>Afición<input data-k="nombre" maxlength="60" placeholder="Fotografía" /></label>
      </div>
      <button type="button" class="quitar" data-quitar>Quitar</button>
    </div>
  </template>
</Layout>

<script>
  import { iniciarEstudioCv } from '../../features/servicios/estudioCv';

  iniciarEstudioCv();
</script>
