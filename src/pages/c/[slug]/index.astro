---
// Tarjeta digital publicada por el cliente desde el estudio del CV (autoservicio).
// Página propia y ligera, sin la cabecera de la tienda: es la tarjeta del cliente.
// Sin JavaScript: QR en SVG desde el servidor y «Guardar contacto» como .vcf.
import { env } from 'cloudflare:workers';
import { renderSVG } from 'uqr';
import { tarjetaPorSlug } from '../../../features/servicios/publicados';

export const prerender = false;

const t = await tarjetaPorSlug(env.DB, Astro.params.slug ?? '');
if (!t) return new Response('Tarjeta no encontrada', { status: 404, headers: { 'content-type': 'text/plain; charset=utf-8' } });
const d = t.datos;
const url = new URL(`/c/${t.slug}`, Astro.url).href;
const qr = renderSVG(url, { border: 1 });
// Texto sobre el color de acento: blanco salvo que el acento sea claro.
const [r, g, b] = [1, 3, 5].map((i) => parseInt(d.color.slice(i, i + 2), 16) / 255);
const lum = 0.2126 * r! + 0.7152 * g! + 0.0722 * b!;
const sobreAcento = lum > 0.55 ? '#111827' : '#ffffff';
const iniciales = d.nombre
  .split(/\s+/)
  .slice(0, 2)
  .map((s) => s[0]?.toUpperCase() ?? '')
  .join('');
const descripcion = [d.cargo, d.ubicacion].filter(Boolean).join(' · ') || `Tarjeta de contacto de ${d.nombre}`;
const tel = d.telefono.replace(/[^\d+]/g, '');
Astro.response.headers.set('cache-control', 'public, max-age=60');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{d.nombre}{d.cargo ? ` · ${d.cargo}` : ''}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={d.nombre} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={url} />
    <meta name="theme-color" content={d.color} />
    <link rel="icon" href="/favicon.svg" />
    <style define:vars={{ acento: d.color, sobre: sobreAcento }}>
      *,*::before,*::after{box-sizing:border-box}
      body{margin:0;min-height:100vh;font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;background:#f3f4f6;color:#111827;display:flex;justify-content:center;padding:24px 16px}
      main{width:100%;max-width:420px;background:#fff;border-radius:20px;box-shadow:0 10px 30px rgb(0 0 0 / .08);overflow:hidden}
      .cab{background:var(--acento);color:var(--sobre);padding:32px 24px 24px;text-align:center}
      .ini{width:72px;height:72px;border-radius:50%;margin:0 auto 12px;display:grid;place-items:center;font-size:28px;font-weight:700;background:rgb(255 255 255 / .2);border:2px solid currentColor}
      h1{margin:0;font-size:1.5rem;line-height:1.2}
      .cargo{margin:6px 0 0;opacity:.9}
      .cuerpo{padding:20px 24px 24px;display:grid;gap:12px}
      .resumen{margin:0;color:#374151;line-height:1.5}
      .btn{display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:12px;border:1px solid #e5e7eb;color:#111827;text-decoration:none;font-weight:500;overflow-wrap:anywhere}
      .btn:hover,.btn:focus-visible{border-color:var(--acento);outline:none}
      .btn span{color:#6b7280;font-weight:400;font-size:.9em}
      .guardar{justify-content:center;background:var(--acento);color:var(--sobre);border-color:var(--acento);font-weight:600}
      .qr{display:grid;justify-items:center;gap:6px;margin-top:8px;color:#6b7280;font-size:.85rem}
      .qr svg{width:168px;height:168px}
      footer{text-align:center;font-size:.78rem;color:#9ca3af;padding:0 24px 20px}
      footer a{color:inherit}
    </style>
  </head>
  <body>
    <main>
      <header class="cab">
        <div class="ini" aria-hidden="true">{iniciales}</div>
        <h1>{d.nombre}</h1>
        {d.cargo && <p class="cargo">{d.cargo}</p>}
        {d.ubicacion && <p class="cargo">{d.ubicacion}</p>}
      </header>
      <div class="cuerpo">
        {d.resumen && <p class="resumen">{d.resumen}</p>}
        <a class="btn guardar" href={`/c/${t.slug}/contacto.vcf`} download={`${t.slug}.vcf`}>Guardar contacto</a>
        {d.telefono && <a class="btn" href={`tel:${tel}`}>Llamar <span>{d.telefono}</span></a>}
        {d.email && <a class="btn" href={`mailto:${d.email}`}>Escribir <span>{d.email}</span></a>}
        {d.web && <a class="btn" href={d.web} rel="noopener">Web <span>{new URL(d.web).hostname.replace(/^www\./, '')}</span></a>}
        {d.enlaces.map((e) => <a class="btn" href={e.url} rel="noopener">{e.etiqueta}</a>)}
        <div class="qr">
          <Fragment set:html={qr} />
          <span>Enseña este QR para compartir la tarjeta</span>
        </div>
      </div>
      <footer>Tarjeta creada con <a href="/servicios/cv">Automatiza sin humo</a></footer>
    </main>
  </body>
</html>
