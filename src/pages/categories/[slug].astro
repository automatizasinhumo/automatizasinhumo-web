---
import { env } from 'cloudflare:workers';
import { INTRO_CATEGORIA } from '../../features/storefront/introCategorias';
import Layout from '../../layouts/Layout.astro';
import {
  getCategoryBySlug,
  ancestors,
  listCategories,
  childrenOf,
  productsInCategory,
  countProductsInCategory,
} from '../../features/categories/db';
import ProductCard from '#theme/ProductCard.astro';
import { buildProductCard } from '../../features/storefront/productCard';
import { maxVariantPrices } from '../../features/products/db';
import { getConfig } from '../../config';
import { orderByClause, parseStoreSortQuery } from '../../features/products/sort';
import {
  MAX_PUBLIC_PAGE,
  paginate,
  queryHref,
} from '../../pagination';
import Pagination from '../../components/Pagination.astro';
import CatalogSort from '../../features/storefront/controls/CatalogSort.astro';
import { buildSortModel } from '../../features/storefront/catalog';
import { catalogPath } from '../../features/settings/home';
import { breadcrumbJsonLd } from '../../features/storefront/breadcrumbs';
import { publicOrigin } from '../../features/http/origin';
import StoreBreadcrumbs from '../../features/storefront/controls/StoreBreadcrumbs.astro';
import { addCacheTags, productCacheTags } from '../../features/cache/tags';

const { slug } = Astro.params;
const category = slug ? await getCategoryBySlug(env.DB, slug) : null;

if (!category) {
  return new Response('No encontrado', { status: 404 });
}

const { sort, dir } = parseStoreSortQuery(
  Astro.url.searchParams.get('sort'),
  Astro.url.searchParams.get('dir'),
);
const order = orderByClause(sort, dir);

const PAGE_SIZE = 24;
const [trail, categories, total] = await Promise.all([
  ancestors(env.DB, category.id),
  listCategories(env.DB),
  countProductsInCategory(env.DB, category.id),
]);
const subcats = childrenOf(categories, category.id);
const { page, offset, totalPages } = paginate(
  Astro.url.searchParams,
  total,
  PAGE_SIZE,
  MAX_PUBLIC_PAGE,
);
const products = await productsInCategory(env.DB, category.id, PAGE_SIZE, offset, order);
addCacheTags(Astro.response.headers, productCacheTags(products.map((product) => product.public_id)));
// Presentation models are built here, where the store's image settings are
// known; only the first card is the LCP image.
const maxPrices = await maxVariantPrices(env.DB, products.map((product) => product.id));
const cards = products.map((product, i) =>
  buildProductCard(product, {
    maxPriceCents: maxPrices.get(product.id),
    baseUrl: getConfig().images.baseUrl,
    currency: getConfig().currency,
    delivery: Astro.locals.settings?.imageDelivery,
    sizes: '(min-width: 1024px) 352px, calc(50vw - 36px)',
    priority: i === 0,
  }),
);
const base = `/categories/${category.slug}`;
const hrefFor = (p: number) =>
  queryHref(base, {
    sort: sort === 'newest' ? undefined : sort,
    dir: dir === 'desc' ? undefined : dir,
    page: p > 1 ? p : undefined,
  });
// The catalog is at / until the home page is pointed elsewhere.
const shopHref = catalogPath(Astro.locals.settings?.homePage);
const crumbs = [{ text: 'Servicios', href: shopHref }, ...trail.map((c) => ({ text: c.name, href: `/categories/${c.slug}` }))];
const breadcrumbLd = JSON.stringify(breadcrumbJsonLd(crumbs, publicOrigin(Astro.url.origin, env.CANONICAL_ORIGIN), Astro.url.pathname)).replace(/</g, '\\u003c');
---

<Layout title={category.name} description={Object.hasOwn(INTRO_CATEGORIA, category.slug) ? INTRO_CATEGORIA[category.slug] : undefined}>
  <script is:inline type="application/ld+json" set:html={breadcrumbLd}></script>
  <StoreBreadcrumbs trail={crumbs} class="mb-4 text-xs uppercase tracking-widest" />

  <h1 class="mb-3 font-serif text-4xl tracking-tight sm:text-5xl">{category.name}</h1>
  <p class="mb-8 max-w-2xl text-lg text-muted">{INTRO_CATEGORIA[category.slug] ?? ''}</p>

  {
    subcats.length > 0 && (
      <div class="mb-12 flex flex-wrap gap-x-6 gap-y-2 text-xs uppercase tracking-widest text-muted">
        {subcats.map((c) => (
          <a
            href={`/categories/${c.slug}`}
            class="border-b border-transparent pb-0.5 hover:border-brand hover:text-brand"
          >
            {c.name}
          </a>
        ))}
      </div>
    )
  }

  <CatalogSort model={buildSortModel(base, sort, dir)} />

  {products.length === 0 && <p class="text-muted">Aún no hay servicios en esta categoría.</p>}

  <ul class="grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-3">
    {
      cards.map((card, i) => (
        <ProductCard card={card} index={i} />
      ))
    }
  </ul>

  <Pagination page={page} totalPages={totalPages} hrefFor={hrefFor} />
</Layout>
