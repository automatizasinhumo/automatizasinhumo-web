---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { formatPrice, formatDate, getConfig } from '../../config';
import { accountsEnabled, getCustomerEmail } from '../../features/auth/customer';
import { countOrdersByEmail, listOrdersByEmail } from '../../features/orders/db';
import { orderReference } from '../../features/orders/number';
import { guestOrderUrl } from '../../features/orders/guestAccess.ts';
import { paginate, queryHref } from '../../pagination';
import Pagination from '../../components/Pagination.astro';
import { catalogPath } from '../../features/settings/home';
import { NOMBRE_TIPO, paginasDeCliente } from '../../features/servicios/panelCliente';
import { mensajesDeCliente, respuestasMensaje } from '../../features/servicios/mensajesWeb';
import { duracionLegible, NOMBRE_ESTADO, resumenMensajes, respuestasGuardadas, type EstadoMensaje } from '../../features/servicios/seguimientoMensajes';
import { citasDeCliente, diaYHora, selloCita } from '../../features/servicios/citasWeb';

if (!(await accountsEnabled())) return Astro.redirect('/', 303);
const email = await getCustomerEmail(Astro.cookies);
if (!email) return Astro.redirect('/account/login', 303);

const PAGE_SIZE = 20;
const { page, offset, totalPages } = paginate(
  Astro.url.searchParams,
  await countOrdersByEmail(env.DB, email),
  PAGE_SIZE,
);
const orders = await listOrdersByEmail(env.DB, email, PAGE_SIZE, offset);
// Tokenized guest links for the customer's OWN orders — the authenticated
// account view is an allowlisted token position, same as their emails. Orders
// with no resolvable link render as plain text rather than a dead bare-id URL.
const orderLinks = new Map(
  await Promise.all(
    orders.map(async (o) => [o.id, await guestOrderUrl(env.DB, o.public_id, '')] as const),
  ),
);
const hrefFor = (p: number) => queryHref('/account', { page: p > 1 ? p : undefined });
const orderCfg = getConfig().orderNumber;
const timeZone = Astro.locals.settings?.timeZone ?? getConfig().timeZone;
// Sus páginas publicadas (web, tarjeta): un fallo aquí no deja sin la lista de pedidos.
const paginas = await paginasDeCliente(env.DB, email).catch((e) => {
  console.error('Panel: no se pudieron leer las páginas', e);
  return [];
});
// Lo que le han escrito desde el formulario de sus webs (mensajesWeb.ts).
let errorMensajes = false;
const mensajes = paginas.some((p) => p.tipo === 'web')
  ? await mensajesDeCliente(env.DB, email).catch((e) => {
      console.error('Panel: no se pudieron leer los mensajes', e);
      errorMensajes = true;
      return [];
    })
  : [];
// Cifras de 30 días encima de los mensajes: si fallan, los mensajes salen igual.
const resumen = mensajes.length
  ? await resumenMensajes(env.DB, email).catch((e) => {
      console.error('Panel: no se pudo calcular el resumen de mensajes', e);
      return null;
    })
  : null;
const OTROS_ESTADOS: Record<EstadoMensaje, [EstadoMensaje, string][]> = {
  nuevo: [['contestado', 'Ya le he contestado'], ['ganado', 'Cliente ganado'], ['perdido', 'No salió']],
  contestado: [['ganado', 'Cliente ganado'], ['perdido', 'No salió']],
  ganado: [['contestado', 'Deshacer']],
  perdido: [['contestado', 'Deshacer']],
};
// Próximas citas pedidas desde sus webs (citasWeb.ts), con el mismo enlace firmado para anular.
let errorCitas = false;
const citas = paginas.some((p) => p.tipo === 'web')
  ? await citasDeCliente(env.DB, email).catch((e) => {
      console.error('Panel: no se pudieron leer las citas', e);
      errorCitas = true;
      return [];
    })
  : [];
const anularCita = new Map(
  env.AUTH_SECRET
    ? await Promise.all(
        citas.map(async (c) => [c.id, `/w/${c.slug}/reservas/anular?t=${encodeURIComponent(await selloCita(c, env.AUTH_SECRET!))}`] as const),
      )
    : [],
);
// Para el saludo de las respuestas: solo el nombre real del negocio, sin el genérico.
const negocioWeb = new Map(paginas.filter((p) => p.tipo === 'web' && p.nombre).map((p) => [p.slug, p.nombre!]));
const nombreWeb = new Map(paginas.filter((p) => p.tipo === 'web').map((p) => [p.slug, p.nombre ?? NOMBRE_TIPO.web]));
const ESTADO: Record<string, string> = { paid: 'Pagado', pending: 'Pendiente', refunded: 'Reembolsado' };
const miles = new Intl.NumberFormat('es-ES');
// The catalog is at / until the home page is pointed elsewhere.
const shopHref = catalogPath(Astro.locals.settings?.homePage);
---

<Layout title="Tu cuenta">
  <div class="mx-auto max-w-2xl">
    <div class="mb-2 flex items-center justify-between">
      <h1 class="font-serif text-3xl tracking-tight sm:text-4xl">Tu cuenta</h1>
      <a href="/account/logout" class="inline-flex min-h-11 items-center text-sm font-medium text-accent">Cerrar sesión</a>
    </div>
    <p class="mb-8 text-sm text-muted">Has entrado como {email}</p>

    {
      paginas.length > 0 && (
        <section class="mb-10" aria-labelledby="tus-paginas">
          <h2 id="tus-paginas" class="mb-3 font-serif text-2xl tracking-tight">Tus páginas</h2>
          <ul class="grid gap-3">
            {paginas.map((p) => {
              const publica = p.dominio ? `https://${p.dominio}/` : p.ruta;
              return (
                <li class="rounded-lg border border-line bg-surface p-4 text-sm" data-pagina={p.tipo}>
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <span><strong class="text-base text-ink">{p.nombre ?? NOMBRE_TIPO[p.tipo]}</strong>{p.nombre && <span class="ml-2 text-xs text-faint">{NOMBRE_TIPO[p.tipo]}</span>}</span>
                    <span class="text-xs text-faint">Actualizada el {formatDate(p.actualizada, undefined, timeZone)}</span>
                  </div>
                  <a href={publica} class="mt-1 block break-all text-accent" target="_blank" rel="noopener">
                    {p.dominio ?? new URL(p.ruta, Astro.url).host + p.ruta}
                  </a>
                  <p class="mt-2 text-muted" data-visitas>
                    <span class="tabular-nums font-medium text-ink">{miles.format(p.visitas7)}</span> visitas en 7 días ·{' '}
                    <span class="tabular-nums">{miles.format(p.visitas30)}</span> en 30 días
                  </p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    {p.editar && (
                      <a href={p.editar} class="inline-flex min-h-11 items-center rounded-md bg-accent px-4 font-medium text-white">
                        Editar
                      </a>
                    )}
                    <a href={publica} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center rounded-md border border-line px-4 font-medium text-ink">
                      Ver publicada
                    </a>
                    {p.carta && (
                      <a href={`${p.ruta}/carta/cartel`} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center rounded-md border border-line px-4 font-medium text-ink">
                        Cartel QR de la carta
                      </a>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    {
      paginas.some((p) => p.tipo === 'web') && (
        <section class="mb-10" aria-labelledby="tus-mensajes">
          <h2 id="tus-mensajes" class="mb-3 font-serif text-2xl tracking-tight">Mensajes de tu web</h2>
          {resumen && resumen.mensajes > 0 && (
            <p class="mb-3 text-sm text-muted" data-resumen-mensajes>
              <span class="tabular-nums font-medium text-ink">{miles.format(resumen.mensajes)}</span> en 30 días
              {resumen.sinContestar > 0 && <> · <span class="tabular-nums font-medium text-ink">{miles.format(resumen.sinContestar)}</span> sin contestar</>}
              {resumen.minutosRespuesta !== null && <> · contestas en <span class="font-medium text-ink">{duracionLegible(resumen.minutosRespuesta)}</span> de media</>}
              {resumen.ganados > 0 && <> · <span class="tabular-nums font-medium text-ink">{miles.format(resumen.ganados)}</span> {resumen.ganados === 1 ? 'cliente ganado' : 'clientes ganados'}</>}
            </p>
          )}
          {errorMensajes ? (
            <p class="rounded-lg border border-line bg-surface px-4 py-6 text-center text-sm text-muted" role="alert" data-error-mensajes>
              No se han podido cargar tus mensajes ahora mismo. Recarga la página en un rato; también te llegan por correo.
            </p>
          ) : mensajes.length === 0 ? (
            <p class="rounded-lg border border-line bg-surface px-4 py-6 text-center text-sm text-muted" data-sin-mensajes>
              Aún no te han escrito. Cuando alguien use el formulario de tu web, el mensaje saldrá aquí y te llegará por correo.
            </p>
          ) : (
            <ul class="grid gap-3">
              {mensajes.map((m) => {
                const correo = /@/.test(m.contacto);
                const estado = (m.estado in NOMBRE_ESTADO ? m.estado : 'nuevo') as EstadoMensaje;
                const negocio = negocioWeb.get(m.slug) ?? '';
                const canal = (t: string) => respuestasMensaje(m, negocio, t).find((r) => r.tipo !== 'llamar');
                return (
                  <li id={`m-${m.id}`} class="rounded-lg border border-line bg-surface p-4 text-sm" data-mensaje={m.id} data-estado={estado}>
                    <div class="flex flex-wrap items-baseline justify-between gap-2">
                      <span>
                        <strong class="text-base text-ink">{m.nombre || 'Sin nombre'}</strong>
                        <span class:list={['ml-2 rounded px-2 py-0.5 text-xs font-medium', estado === 'nuevo' ? 'bg-accent text-white' : 'border border-line text-muted']} data-estado-etiqueta>
                          {NOMBRE_ESTADO[estado]}
                        </span>
                      </span>
                      <span class="text-xs text-faint">{formatDate(m.creado, undefined, timeZone)}{nombreWeb.size > 1 && ` · ${nombreWeb.get(m.slug) ?? ''}`}</span>
                    </div>
                    <a href={correo ? `mailto:${encodeURIComponent(m.contacto).replace(/%40/g, '@')}` : `tel:${m.contacto.replace(/[^\d+]/g, '')}`} class="mt-1 inline-flex min-h-11 items-center break-all font-medium text-accent" data-respuesta="contacto">
                      {m.contacto}
                    </a>
                    <p class="mt-1 whitespace-pre-line text-ink">{m.texto}</p>
                    <div class="mt-3 flex flex-wrap gap-2" data-responder>
                      {respuestasMensaje(m, negocio).map((r) => (
                        <a href={r.href} {...(r.tipo === 'whatsapp' ? { target: '_blank', rel: 'noopener' } : {})} class="inline-flex min-h-11 items-center rounded-md border border-line px-4 font-medium text-ink" data-respuesta={r.tipo}>
                          {r.etiqueta}
                        </a>
                      ))}
                    </div>
                    {canal('') && (
                      <details class="mt-3" data-guardadas>
                        <summary class="inline-flex min-h-11 cursor-pointer items-center font-medium text-accent">Respuestas guardadas</summary>
                        <ul class="mt-2 grid gap-2">
                          {respuestasGuardadas(m, negocio, m.sector).map((t) => {
                            const r = canal(t)!;
                            return (
                              <li class="flex flex-wrap items-center justify-between gap-2 rounded-md border border-line p-3">
                                <span class="text-ink">{t}</span>
                                <a href={r.href} {...(r.tipo === 'whatsapp' ? { target: '_blank', rel: 'noopener' } : {})} class="inline-flex min-h-11 items-center font-medium text-accent" data-respuesta={r.tipo}>
                                  {r.tipo === 'whatsapp' ? 'Enviar por WhatsApp' : 'Enviar por correo'}
                                </a>
                              </li>
                            );
                          })}
                        </ul>
                      </details>
                    )}
                    <form method="post" action="/account/mensajes" class="mt-3 flex flex-wrap gap-2" data-estados>
                      <input type="hidden" name="id" value={m.id} />
                      {OTROS_ESTADOS[estado].map(([e, etiqueta]) => (
                        <button name="estado" value={e} class="inline-flex min-h-11 items-center rounded-md px-3 text-sm font-medium text-muted underline-offset-2 hover:underline">
                          {etiqueta}
                        </button>
                      ))}
                    </form>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      )
    }

    {
      (citas.length > 0 || errorCitas) && (
        <section class="mb-10" aria-labelledby="tus-citas">
          <h2 id="tus-citas" class="mb-3 font-serif text-2xl tracking-tight">Próximas citas</h2>
          {errorCitas ? (
            <p class="rounded-lg border border-line bg-surface px-4 py-6 text-center text-sm text-muted" role="alert" data-error-citas>
              No se han podido cargar tus citas ahora mismo. Recarga la página en un rato; también te llegan por correo.
            </p>
          ) : (
            <ul class="grid gap-3">
              {citas.map((c) => (
                <li class="rounded-lg border border-line bg-surface p-4 text-sm" data-cita>
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <strong class="text-base text-ink">{diaYHora(c.inicio)}</strong>
                    {nombreWeb.size > 1 && <span class="text-xs text-faint">{c.negocio}</span>}
                  </div>
                  <p class="mt-1 text-ink">{c.nombre}</p>
                  <p class="mt-1 flex flex-wrap gap-x-4">
                    <a href={`mailto:${encodeURIComponent(c.email).replace(/%40/g, '@')}`} class="inline-flex min-h-11 items-center break-all font-medium text-accent">{c.email}</a>
                    {c.telefono && <a href={`tel:${c.telefono.replace(/[^\d+]/g, '')}`} class="inline-flex min-h-11 items-center font-medium text-accent">{c.telefono}</a>}
                  </p>
                  {c.nota && <p class="mt-1 whitespace-pre-line text-muted">{c.nota}</p>}
                  {anularCita.get(c.id) && (
                    <a href={anularCita.get(c.id)} class="mt-2 inline-flex min-h-11 items-center rounded-md border border-line px-4 font-medium text-ink" rel="noreferrer">
                      Anular la cita
                    </a>
                  )}
                </li>
              ))}
            </ul>
          )}
        </section>
      )
    }

    <h2 class="mb-3 font-serif text-2xl tracking-tight">Tus pedidos</h2>

    {
      orders.length === 0 ? (
        <p class="rounded-lg border border-line bg-surface px-4 py-6 text-center text-sm text-muted">
          Aún no tienes pedidos. <a href={shopHref} class="font-medium text-accent">Ver servicios →</a>
        </p>
      ) : (
        <ul class="divide-y divide-line overflow-hidden rounded-lg border border-line bg-surface">
          {orders.map((o) => (
            <li class="flex items-center justify-between gap-4 px-4 py-4 text-sm">
              <div>
                {orderLinks.get(o.id) ? (
                  <a href={orderLinks.get(o.id)} class="font-medium text-ink hover:text-accent">
                    Pedido n.º {orderReference(o.public_id, o.id, orderCfg)}
                  </a>
                ) : (
                  <span class="font-medium text-ink">
                    Pedido n.º {orderReference(o.public_id, o.id, orderCfg)}
                  </span>
                )}
                <div class="text-xs text-faint">{formatDate(o.created_at, undefined, timeZone)}</div>
              </div>
              <div class="text-right">
                <div class="tabular-nums">{formatPrice(o.amount_total_cents, o.currency)}</div>
                <div class="text-xs capitalize text-faint">
                  {o.refunded_cents > 0 && o.refunded_cents < o.amount_total_cents
                    ? 'Reembolso parcial'
                    : (ESTADO[o.status] ?? o.status)}
                </div>
              </div>
            </li>
          ))}
        </ul>
      )
    }
    <Pagination page={page} totalPages={totalPages} hrefFor={hrefFor} />
  </div>
</Layout>

<script>
  // Al pulsar responder (correo, WhatsApp, llamar), el mensaje pasa a «contestado» solo.
  document.addEventListener('click', (ev) => {
    const a = (ev.target as Element | null)?.closest<HTMLAnchorElement>('[data-mensaje] [data-respuesta]');
    const li = a?.closest<HTMLElement>('[data-mensaje]');
    if (!a || !li || li.dataset.estado !== 'nuevo' || li.dataset.guardando) return;
    const f = new FormData();
    f.set('id', li.dataset.mensaje!);
    f.set('estado', 'contestado');
    f.set('beacon', '1');
    li.dataset.guardando = '1';
    // keepalive: la petición sobrevive aunque el enlace abra otra app. El estado cambia solo si
    // el servidor lo confirma; si falla, el próximo clic lo vuelve a intentar.
    fetch('/account/mensajes', { method: 'POST', body: f, keepalive: true, credentials: 'same-origin' })
      .then((r) => {
        if (!r.ok) return;
        li.dataset.estado = 'contestado';
        const et = li.querySelector<HTMLElement>('[data-estado-etiqueta]');
        if (et) {
          et.textContent = 'Contestado';
          et.classList.remove('bg-accent', 'text-white');
          et.classList.add('border', 'border-line', 'text-muted');
        }
        li.querySelector<HTMLButtonElement>('[data-estados] button[value="contestado"]')?.remove();
      })
      .catch(() => {})
      .finally(() => delete li.dataset.guardando);
  });
</script>
