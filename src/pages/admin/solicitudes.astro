---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  ESTADOS,
  ESTADO_LABEL,
  cambiarEstado,
  contarPorEstado,
  esEstado,
  listarSolicitudes,
} from '../../features/solicitudes';
import {
  TIPOS_CORREO,
  TIPO_CORREO_LABEL,
  correoDeEstado,
  esTipoCorreo,
  prepararCorreo,
} from '../../features/solicitudes/correos';
import { getEmailProvider } from '../../features/email';
import { datosDe as datosDeSolicitud, enviarNotificacion } from '../../features/solicitudes/envio';
import { getStoreSettings } from '../../features/settings/db';
import { firmadorDecision } from '../../features/solicitudes/decision';

export const prerender = false;

// Seguimiento de solicitudes: nueva → preparando → vista previa enviada →
// (cambios / en espera) → aprobada → pagada → entregada (o descartada).
// Correos al cliente: envío asistido. Guardar un estado que avisa abre la vista
// previa del correo; David la revisa y pulsa «Enviar». La fila de
// `notificaciones` (solicitud, tipo, versión) es única, así que un doble clic o
// repetir el estado no duplica el envío; reenviar exige marcarlo a propósito.
const ID_RE = /^S-[A-Z0-9]{6,12}$/;
const firmar = firmadorDecision(Astro.url.origin, env.AUTH_SECRET);
// Un correo «revision» firma su propia versión; los demás, la última revisión enviada.
const datosDe = (id: string, enlace: string, pendientes: string, version?: number) =>
  datosDeSolicitud(env.DB, id, enlace, pendientes, firmar, version);

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const id = String(f.get('public_id') ?? '');
  const filtroPost = String(f.get('filtro') ?? '');
  const qs = new URLSearchParams(filtroPost && esEstado(filtroPost) ? { estado: filtroPost } : {});
  const tipo = f.get('tipo');
  if (f.get('accion') === 'enviar' && esTipoCorreo(tipo)) {
    const version = Math.min(Math.max(Number(f.get('version')) || 1, 1), 20);
    const enlace = String(f.get('enlace') ?? '').trim().slice(0, 500);
    const pendientes = String(f.get('pendientes') ?? '').trim().slice(0, 2000);
    const reenviar = f.get('reenviar') === 'si';
    let msg = 'Correo no enviado: datos no válidos.';
    const d = ID_RE.test(id) ? await datosDe(id, enlace, pendientes, tipo === 'revision' ? version : undefined) : null;
    const c = d ? prepararCorreo(tipo, d) : null;
    if (c && !c.ok) msg = c.error;
    if (d && c?.ok) {
      const r = await enviarNotificacion(env.DB, await getEmailProvider(await getStoreSettings(env.DB)), {
        id,
        tipo,
        version,
        email: d.email,
        asunto: c.asunto,
        texto: c.texto,
        reenviar,
      });
      if (r.estado === 'ocupado') {
        msg = `Ese correo (${TIPO_CORREO_LABEL[tipo]}, versión ${version}) ya se envió. Marca «Reenviar» o sube la versión.`;
      } else {
        msg = r.estado === 'error' ? `Correo NO enviado: ${r.error}` : `Correo «${TIPO_CORREO_LABEL[tipo]}» enviado a ${d.email}.`;
      }
    }
    qs.set('aviso', msg);
    return Astro.redirect(`/admin/solicitudes?${qs}#${id}`, 303);
  }
  const estado = f.get('estado');
  const nota = String(f.get('nota') ?? '').trim().slice(0, 2000) || null;
  const ok = esEstado(estado) && ID_RE.test(id) && (await cambiarEstado(env.DB, id, estado, nota));
  qs.set(ok ? 'ok' : 'err', id);
  const sugerido = ok && esEstado(estado) ? correoDeEstado(estado) : null;
  if (sugerido) {
    qs.set('correo', id);
    qs.set('tipo', sugerido);
  }
  return Astro.redirect(`/admin/solicitudes?${qs}#${id}`, 303);
}

const sp = Astro.url.searchParams;
const filtroRaw = sp.get('estado');
const filtro = esEstado(filtroRaw) ? filtroRaw : undefined;
let filas: Awaited<ReturnType<typeof listarSolicitudes>> = [];
let conteo: Record<string, number> = {};
let sinTabla = false;
try {
  [filas, conteo] = await Promise.all([listarSolicitudes(env.DB, filtro), contarPorEstado(env.DB)]);
} catch {
  sinTabla = true; // migración 0040 sin aplicar
}
const total = Object.values(conteo).reduce((a, b) => a + b, 0);
const okId = sp.get('ok');
const errId = sp.get('err');
const aviso = sp.get('aviso');

// Vista previa del correo (GET: «Actualizar vista previa» no escribe nada).
const correoId = ID_RE.test(sp.get('correo') ?? '') ? sp.get('correo')! : null;
const tipoRaw = sp.get('tipo');
const correoTipo = esTipoCorreo(tipoRaw) ? tipoRaw : 'revision';
const correoVersion = Math.min(Math.max(Number(sp.get('version')) || 1, 1), 20);
const correoEnlace = (sp.get('enlace') ?? '').slice(0, 500);
const correoPendientes = (sp.get('pendientes') ?? '').slice(0, 2000);
let vista: ReturnType<typeof prepararCorreo> | null = null;
if (correoId && !sinTabla) {
  const d = await datosDe(correoId, correoEnlace, correoPendientes, correoTipo === 'revision' ? correoVersion : undefined);
  vista = d ? prepararCorreo(correoTipo, d) : null;
}

type Notif = { solicitud_public_id: string; tipo: string; version: number; estado_envio: string; intentos: number; enviado_at: string | null; error: string | null };
const historial = new Map<string, Notif[]>();
try {
  const ids = filas.map((x) => x.public_id);
  if (ids.length) {
    const { results } = await env.DB.prepare(
      `SELECT solicitud_public_id, tipo, version, estado_envio, intentos, enviado_at, error FROM notificaciones WHERE solicitud_public_id IN (${ids.map(() => '?').join(',')}) ORDER BY id DESC`,
    )
      .bind(...ids)
      .all<Notif>();
    for (const n of results ?? []) historial.set(n.solicitud_public_id, [...(historial.get(n.solicitud_public_id) ?? []), n]);
  }
} catch {
  // migración 0042 sin aplicar: sin historial
}

const campos = (json: string): [string, string][] => {
  try {
    return Object.entries(JSON.parse(json) as Record<string, string>);
  } catch {
    return [];
  }
};
const fecha = (s: string) => s.replace('T', ' ').slice(0, 16);
const COLOR: Record<string, string> = {
  nueva: 'bg-amber-100 text-amber-900',
  en_preparacion: 'bg-sky-100 text-sky-900',
  vista_previa_enviada: 'bg-indigo-100 text-indigo-900',
  cambios_pedidos: 'bg-violet-100 text-violet-900',
  en_espera_cliente: 'bg-orange-100 text-orange-900',
  aprobada: 'bg-emerald-100 text-emerald-900',
  pagada: 'bg-emerald-600 text-white',
  entregada: 'bg-gray-800 text-white',
  descartada: 'bg-gray-200 text-gray-600',
};
---

<AdminLayout title="Solicitudes" active="solicitudes">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-semibold">Solicitudes</h1>
      <p class="mt-1 text-sm text-gray-600">
        Pruebas gratis y pedidos pagados. Al guardar un estado que avisa al cliente se abre la vista previa del correo: revísala y envíala.
        El silencio del cliente nunca aprueba ni entrega nada.
      </p>
    </div>

    {sinTabla && (
      <p class="rounded-md border border-amber-300 bg-amber-50 p-3 text-sm">Falta aplicar la migración 0040_solicitudes.</p>
    )}
    {okId && <p class="rounded-md border border-emerald-300 bg-emerald-50 p-3 text-sm">Guardado {okId}.</p>}
    {errId && <p class="rounded-md border border-red-300 bg-red-50 p-3 text-sm">No se pudo guardar {errId}.</p>}
    {aviso && <p class="rounded-md border border-sky-300 bg-sky-50 p-3 text-sm" role="status">{aviso}</p>}

    <nav class="flex flex-wrap gap-2 text-sm" aria-label="Filtrar por estado">
      <a href="/admin/solicitudes" class:list={['rounded-full border px-3 py-1', !filtro ? 'border-black bg-black text-white' : 'border-line']}>
        Todas ({total})
      </a>
      {ESTADOS.map((e) => (
        <a href={`/admin/solicitudes?estado=${e}`} class:list={['rounded-full border px-3 py-1', filtro === e ? 'border-black bg-black text-white' : 'border-line']}>
          {ESTADO_LABEL[e]} ({conteo[e] ?? 0})
        </a>
      ))}
    </nav>

    {filas.length === 0 && !sinTabla && <p class="text-sm text-gray-500">No hay solicitudes{filtro ? ' en este estado' : ''} todavía.</p>}

    <ul class="space-y-4">
      {filas.map((s) => (
        <li id={s.public_id} class="rounded-md border border-line bg-white/60 p-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <span class="font-mono text-sm font-semibold">{s.public_id}</span>
              <span class={`ml-2 rounded-full px-2 py-0.5 text-xs ${COLOR[s.estado] ?? ''}`}>{ESTADO_LABEL[s.estado] ?? s.estado}</span>
              <span class="ml-2 text-xs text-gray-500">{fecha(s.created_at)} · act. {fecha(s.updated_at)}</span>
            </div>
            {s.slug !== 'consulta' && (
              <a href={`/products/${s.slug}`} target="_blank" rel="noopener" class="text-sm underline">{s.producto ?? s.slug}</a>
            )}
          </div>
          <div class="mt-3 grid gap-4 md:grid-cols-2">
            <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
              <dt class="text-xs uppercase tracking-widest text-gray-500">Nombre</dt><dd>{s.nombre}</dd>
              <dt class="text-xs uppercase tracking-widest text-gray-500">Email</dt>
              <dd><a class="underline" href={`mailto:${s.email}?subject=${encodeURIComponent(`Tu solicitud ${s.public_id}`)}`}>{s.email}</a></dd>
              {s.telefono && (<><dt class="text-xs uppercase tracking-widest text-gray-500">Tel.</dt><dd>{s.telefono}</dd></>)}
              {s.modalidad && (<><dt class="text-xs uppercase tracking-widest text-gray-500">Modalidad</dt><dd>{s.modalidad}</dd></>)}
              {(s.utm_source || s.referrer) && (
                <><dt class="text-xs uppercase tracking-widest text-gray-500">Origen</dt>
                <dd class="break-all text-gray-600">{[s.utm_source, s.utm_medium, s.utm_campaign].filter(Boolean).join(' / ') || s.referrer}</dd></>
              )}
            </dl>
            <dl class="space-y-2 text-sm">
              {campos(s.campos).map(([k, v]) => (
                <div><dt class="text-xs text-gray-500">{k}</dt><dd class="whitespace-pre-wrap">{v}</dd></div>
              ))}
              {s.mensaje && <div><dt class="text-xs text-gray-500">Mensaje</dt><dd class="whitespace-pre-wrap">{s.mensaje}</dd></div>}
            </dl>
          </div>
          <form method="POST" class="mt-4 flex flex-wrap items-end gap-3 border-t border-line pt-3">
            <input type="hidden" name="public_id" value={s.public_id} />
            <input type="hidden" name="filtro" value={filtro ?? ''} />
            <label class="text-xs uppercase tracking-widest text-gray-500">Estado
              <select name="estado" class="mt-1 block rounded-md border border-line bg-white px-2 py-1.5 text-sm normal-case tracking-normal text-black">
                {ESTADOS.map((e) => <option value={e} selected={e === s.estado}>{ESTADO_LABEL[e]}</option>)}
              </select>
            </label>
            <label class="min-w-[16rem] flex-1 text-xs uppercase tracking-widest text-gray-500">Nota interna
              <input name="nota" value={s.nota ?? ''} maxlength="2000" class="mt-1 block w-full rounded-md border border-line bg-white px-2 py-1.5 text-sm normal-case tracking-normal text-black" placeholder="Enlace a la vista previa, pago enviado…" />
            </label>
            <button class="rounded-md bg-black px-4 py-2 text-sm font-medium text-white">Guardar</button>
            <a href={`/admin/solicitudes?correo=${s.public_id}&tipo=${correoDeEstado(s.estado) ?? 'revision'}${filtro ? `&estado=${filtro}` : ''}#${s.public_id}`} class="text-sm underline">Preparar correo…</a>
          </form>
          {correoId === s.public_id && (
            <section class="mt-4 rounded-md border border-indigo-200 bg-indigo-50/50 p-3" aria-label="Correo al cliente">
              <form method="GET" action={`/admin/solicitudes#${s.public_id}`} class="flex flex-wrap items-end gap-3">
                <input type="hidden" name="correo" value={s.public_id} />
                {filtro && <input type="hidden" name="estado" value={filtro} />}
                <label class="text-xs uppercase tracking-widest text-gray-500">Correo
                  <select name="tipo" class="mt-1 block rounded-md border border-line bg-white px-2 py-1.5 text-sm normal-case tracking-normal text-black">
                    {TIPOS_CORREO.map((t) => <option value={t} selected={t === correoTipo}>{TIPO_CORREO_LABEL[t]}</option>)}
                  </select>
                </label>
                <label class="text-xs uppercase tracking-widest text-gray-500">Versión
                  <input name="version" type="number" min="1" max="20" value={correoVersion} class="mt-1 block w-20 rounded-md border border-line bg-white px-2 py-1.5 text-sm text-black" />
                </label>
                <label class="min-w-[14rem] flex-1 text-xs uppercase tracking-widest text-gray-500">Enlace (versión o entrega)
                  <input name="enlace" type="url" value={correoEnlace} placeholder="https://…" class="mt-1 block w-full rounded-md border border-line bg-white px-2 py-1.5 text-sm normal-case tracking-normal text-black" />
                </label>
                <label class="w-full text-xs uppercase tracking-widest text-gray-500">Datos que faltan (solo «Falta información»)
                  <textarea name="pendientes" rows="2" class="mt-1 block w-full rounded-md border border-line bg-white px-2 py-1.5 text-sm normal-case tracking-normal text-black">{correoPendientes}</textarea>
                </label>
                <button class="rounded-md border border-black px-3 py-1.5 text-sm">Actualizar vista previa</button>
              </form>
              {vista && !vista.ok && <p class="mt-3 text-sm text-red-700">{vista.error}</p>}
              {vista && vista.ok && (
                <form method="POST" class="mt-3 space-y-2">
                  <p class="text-sm"><span class="text-gray-500">Para:</span> {s.email} · <span class="text-gray-500">Asunto:</span> <strong>{vista.asunto}</strong></p>
                  <pre class="whitespace-pre-wrap rounded-md border border-line bg-white p-3 font-sans text-sm">{vista.texto}</pre>
                  <input type="hidden" name="accion" value="enviar" />
                  <input type="hidden" name="public_id" value={s.public_id} />
                  <input type="hidden" name="filtro" value={filtro ?? ''} />
                  <input type="hidden" name="tipo" value={correoTipo} />
                  <input type="hidden" name="version" value={correoVersion} />
                  <input type="hidden" name="enlace" value={correoEnlace} />
                  <input type="hidden" name="pendientes" value={correoPendientes} />
                  <div class="flex flex-wrap items-center gap-4">
                    <button class="rounded-md bg-indigo-700 px-4 py-2 text-sm font-medium text-white">Enviar correo</button>
                    <label class="text-sm"><input type="checkbox" name="reenviar" value="si" /> Reenviar aunque ya se haya enviado</label>
                  </div>
                </form>
              )}
            </section>
          )}
          {(historial.get(s.public_id)?.length ?? 0) > 0 && (
            <ul class="mt-3 space-y-1 text-xs text-gray-600" aria-label="Correos enviados">
              {historial.get(s.public_id)!.map((n) => (
                <li>
                  ✉ {esTipoCorreo(n.tipo) ? TIPO_CORREO_LABEL[n.tipo] : n.tipo} v{n.version} · {n.estado_envio}
                  {n.enviado_at ? ` · ${fecha(n.enviado_at)}` : ''}{n.intentos > 1 ? ` · ${n.intentos} intentos` : ''}{n.error ? ` · ${n.error}` : ''}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </div>
</AdminLayout>
