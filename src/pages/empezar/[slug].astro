---
import { CONTACT_EMAIL } from '../../contacto';
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { getProductBySlug, maxVariantPrices } from '../../features/products/db';
import { camposDeDescripcion, nombreCampo, LIMITES } from '../../features/solicitudes';
import { formatPrice } from '../../config';
import { resolverPedido } from '../../features/solicitudes/pedido';
import { firmaFormulario } from '../../features/solicitudes/borrador';
import { mensajeDesdeBusqueda } from '../../features/search/sinResultados';

export const prerender = false;

// «Empieza gratis»: el cliente deja sus datos SIN pagar. David prepara una vista
// previa y solo si le gusta se le envía el enlace de pago.
const { slug = 'consulta' } = Astro.params;
const consulta = slug === 'consulta';
const encontrado = consulta ? null : await getProductBySlug(env.DB, slug);
// Desactivado: 404 salvo que llegue con ?pedido= (ya pagado; se verifica abajo con resolverPedido).
const producto = encontrado && (encontrado.active || Astro.url.searchParams.has('pedido')) ? encontrado : null;
if (!consulta && !producto) {
  return new Response('Not found', { status: 404, headers: { 'cache-control': 'no-store' } });
}

const campos = producto ? camposDeDescripcion(producto.description) : [];
const conModalidad = Boolean(producto?.variant_label);
// Precio exacto de cada modalidad: el cliente ve lo que pagará en la opción que marca.
const precioMontado = producto && conModalidad
  ? (await maxVariantPrices(env.DB, [producto.id])).get(producto.id) ?? null
  : null;
const precioDe = (valor: string) =>
  producto ? formatPrice(valor === 'Te lo montamos' && precioMontado ? precioMontado : producto.price_cents, producto.currency) : '';
const q = Astro.url.searchParams;
const modalidadInicial = q.get('modalidad') === 'pro' ? 'Te lo montamos' : 'Plantilla + guía';
// Campos que el servidor ha rellenado desde la URL: solo esos mandan sobre el borrador.
// Un parámetro que no inicializa nada (?nombre=Ana) no debe vaciar lo guardado.
// Desde una búsqueda sin resultados (?busqueda=) el mensaje llega ya empezado.
const mensajeInicial = consulta ? mensajeDesdeBusqueda(q.get('busqueda')) : '';
const camposDesdeUrl = [q.get('modalidad') === 'pro' ? 'modalidad' : '', mensajeInicial ? 'mensaje' : '']
  .filter(Boolean)
  .join(' ');
// (con pedido verificado manda la modalidad pagada; ver modalidadFija)
const ERRORES: Record<string, string> = {
  nombre: 'Escribe tu nombre (mínimo 2 letras).',
  email: 'Revisa el email: ahí te mandamos la vista previa.',
  telefono: 'Revisa el teléfono o déjalo vacío.',
  consentimiento: 'Marca la casilla de permiso para que podamos preparar tu vista previa.',
  mensaje: 'Cuéntanos en dos líneas qué necesitas.',
  guardar: `No hemos podido guardar tu solicitud. Inténtalo de nuevo en un minuto o escríbenos a ${CONTACT_EMAIL}.`,
  servicio: 'Ese servicio ya no está disponible. Cuéntanos qué necesitas y te ayudamos.',
};
// Compra directa: llega desde la página del pedido con ?pedido=<token de acceso>.
// Se comprueba en D1 (pagado, sin reembolso total, con este servicio); la URL sola no basta.
const pedidoToken = (q.get('pedido') ?? '').slice(0, 80);
const verificado = producto && pedidoToken ? await resolverPedido(env.DB, pedidoToken, producto.slug) : null;
const pedido = verificado?.ref ?? null;
const pedidoInvalido = Boolean(pedidoToken) && !verificado;
if (pedidoToken) {
  // El token da acceso al pedido: que no se cachee ni viaje en el Referer.
  Astro.response.headers.set('cache-control', 'private, no-store');
  Astro.response.headers.set('referrer-policy', 'no-referrer');
}
const modalidadFija = verificado?.modalidad ?? null;
const error = q.get('error');
const errorTexto = error ? (ERRORES[error] ?? 'Revisa los datos del formulario.') : null;
// Con ?error= el formulario por pasos abre en el paso que tiene el campo a corregir.
const errorEnUltimo = error === 'consentimiento' || error === 'mensaje';
const titulo = pedido && producto
  ? `Tus datos para: ${producto.name}`
  : producto ? `Empieza gratis: ${producto.name}` : 'Cuéntanos qué necesitas';
const referrer = (Astro.request.headers.get('referer') ?? '').slice(0, 300);
const input =
  'mt-1 block w-full rounded-lg border border-line bg-surface px-3 py-2.5 text-base text-ink placeholder:text-faint focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/30';
const label = 'block text-sm font-medium text-ink';
---

<Layout
  title={titulo}
  description="Empieza gratis, sin tarjeta: rellena tus datos, recibe una vista previa y paga solo si te gusta. Te atiende una persona."
>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:py-12">
    <a href={producto ? `/products/${producto.slug}` : '/'} class="text-sm font-medium text-faint hover:text-brand">
      &larr; {producto ? 'Volver a la ficha' : 'Volver al inicio'}
    </a>

    <div class="mt-6 grid gap-10 lg:grid-cols-[1fr_320px]">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-brand">{pedido ? `Pedido ${pedido} · pagado · 2-3 minutos` : 'Gratis · sin tarjeta · 2-3 minutos'}</p>
        <h1 class="mt-2 font-serif text-3xl font-bold leading-tight text-ink sm:text-4xl">{titulo}</h1>
        <p class="mt-3 max-w-prose text-muted">
          {
            pedido
              ? 'Ya está pagado. Rellena lo que tengas a mano (lo que falte te lo preguntamos) y nos ponemos con ello. Antes de entregarlo te enseñamos el resultado.'
              : producto
              ? 'Rellena lo que tengas a mano (lo que falte lo vemos luego). Te enviamos una vista previa con tus datos y solo pagas si te gusta.'
              : 'Cuéntame qué necesitas. Te propondré una solución y su precio cerrado, sin compromiso. Si encaja, podremos preparar una muestra gratuita.'
          }
        </p>

        {
          pedidoInvalido && (
            <p role="alert" class="mt-6 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">
              No encontramos un pedido pagado de este servicio con ese enlace.
              <span class="mt-3 flex flex-wrap gap-2">
                <a href={`mailto:${CONTACT_EMAIL}?subject=Revisar%20mi%20pedido`} class="rounded-full bg-amber-900 px-4 py-2 font-semibold text-white hover:bg-amber-800">Revisar mi pedido</a>
                <a href="#solicitud-form" class="rounded-full border border-amber-900 px-4 py-2 font-semibold hover:bg-amber-100">Solicitar muestra gratuita</a>
              </span>
              <span class="mt-2 block text-xs">Si ya pagaste, no empieces de nuevo: abre el enlace del correo de tu pedido o escríbenos y lo revisamos.</span>
            </p>
          )
        }
        {
          errorTexto && (
            <p role="alert" class="mt-6 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">
              {errorTexto}
            </p>
          )
        }

        <form method="post" action="/api/solicitudes" id="solicitud-form" class="mt-8 space-y-6" data-solicitud data-firma={firmaFormulario(campos)} data-desde-url={camposDesdeUrl || undefined} data-error-ultimo={errorEnUltimo ? '' : undefined}>
          {/* Sin JS se ve todo de una vez; con JS, un paso cada vez con esta barra. */}
          <div class="hidden" data-progreso aria-live="polite">
            <div class="flex items-baseline justify-between text-xs font-semibold">
              <span class="text-brand" data-progreso-texto></span>
              <span class="text-faint" data-progreso-titulo></span>
            </div>
            <div class="mt-2 h-2 overflow-hidden rounded-full bg-line" role="progressbar" aria-valuemin="1" data-progreso-barra>
              <div class="h-full rounded-full bg-brand transition-all duration-300" style="width:0%" data-progreso-relleno></div>
            </div>
          </div>
          <p class="hidden items-center justify-between gap-3 rounded-lg border border-line bg-surface px-4 py-3 text-sm text-muted" role="status" data-borrador-aviso>
            <span>Hemos recuperado lo que escribiste. Solo está guardado en este navegador.</span>
            <button type="button" class="shrink-0 font-semibold text-brand underline-offset-2 hover:underline" data-borrador-borrar>Empezar de cero</button>
          </p>
          <input type="hidden" name="slug" value={slug} />
          {/* Un token por formulario mostrado: el doble envío devuelve la misma solicitud. */}
          <input type="hidden" name="envio" value={crypto.randomUUID()} />
          {verificado && <input type="hidden" name="pedido" value={pedidoToken} />}
          <input type="hidden" name="utm_source" value={q.get('utm_source') ?? ''} />
          <input type="hidden" name="utm_medium" value={q.get('utm_medium') ?? ''} />
          <input type="hidden" name="utm_campaign" value={q.get('utm_campaign') ?? ''} />
          <input type="hidden" name="referrer" value={referrer} />
          <div class="hidden" aria-hidden="true">
            <label>No rellenes este campo <input type="text" name="web" tabindex="-1" autocomplete="off" /></label>
          </div>

          <fieldset class="space-y-4 rounded-2xl border border-line p-5" data-paso="Tus datos">
            <legend class="px-1 text-sm font-semibold text-ink">1. Tus datos de contacto</legend>
            <div class="grid gap-4 sm:grid-cols-2">
              <label class={label}>Nombre *
                <input class={input} type="text" name="nombre" required minlength="2" maxlength={LIMITES.nombre} autocomplete="name" />
              </label>
              <label class={label}>Email *
                <input class={input} type="email" name="email" required maxlength={LIMITES.email} autocomplete="email" inputmode="email" />
                <span class="mt-1 block text-xs text-faint">{pedido ? 'Ahí te escribimos con el resultado para que lo revises.' : 'Ahí te enviamos la vista previa.'}</span>
              </label>
            </div>
            <label class={label}>Teléfono <span class="font-normal text-faint">(opcional, por si prefieres WhatsApp o llamada)</span>
              <input class={input} type="tel" name="telefono" maxlength={LIMITES.telefono} autocomplete="tel" inputmode="tel" />
            </label>
          </fieldset>

          {
            conModalidad && (
              <fieldset class="rounded-2xl border border-line p-5" data-paso="Modalidad">
                <legend class="px-1 text-sm font-semibold text-ink">{modalidadFija ? '2. Modalidad contratada' : '2. ¿Cómo lo quieres?'}</legend>
                {modalidadFija && verificado ? (
                  <div class="mt-2 rounded-xl border border-brand bg-brand/5 p-4">
                    <input type="hidden" name="modalidad" value={modalidadFija} />
                    <p class="flex flex-wrap items-baseline justify-between gap-x-2 font-semibold text-ink">{modalidadFija} <span class="tabular-nums">{formatPrice(verificado.pagadoCents, verificado.currency)} · pagado</span></p>
                    <p class="text-sm text-muted">{modalidadFija === 'Te lo montamos' ? 'Te lo entregamos publicado y funcionando. Tú no tocas nada.' : 'Te damos la plantilla con tus datos y una guía paso a paso para publicarla tú.'}</p>
                  </div>
                ) : (
                <div class="mt-2 grid gap-3 sm:grid-cols-2">
                  {[
                    ['Plantilla + guía', 'Te damos la plantilla con tus datos y una guía paso a paso para publicarla tú.'],
                    ['Te lo montamos', 'Te lo entregamos publicado y funcionando. Tú no tocas nada.'],
                  ].map(([valor, texto]) => (
                    <label class="flex cursor-pointer gap-3 rounded-xl border border-line p-4 has-[:checked]:border-brand has-[:checked]:bg-brand/5">
                      <input type="radio" name="modalidad" value={valor} checked={valor === modalidadInicial} class="mt-1 accent-[var(--color-brand)]" />
                      <span>
                        <span class="flex flex-wrap items-baseline justify-between gap-x-2 font-semibold text-ink">{valor} <span class="tabular-nums">{precioDe(valor)}</span></span>
                        <span class="block text-sm text-muted">{texto}</span>
                      </span>
                    </label>
                  ))}
                </div>
                )}
                <p class="mt-3 text-xs text-faint">{modalidadFija ? '¿Querías la otra modalidad? Escríbenos y lo ajustamos.' : 'Puedes cambiarlo después de ver la vista previa.'}</p>
              </fieldset>
            )
          }

          {
            campos.length > 0 && (
              <fieldset class="space-y-4 rounded-2xl border border-line p-5" data-paso="Tu información">
                <legend class="px-1 text-sm font-semibold text-ink">{conModalidad ? '3' : '2'}. {pedido ? 'Lo que necesitamos para preparártelo' : 'Lo que necesitamos para tu muestra'}</legend>
                <p class="text-sm text-muted">Todo opcional: rellena lo que tengas. Lo demás te lo preguntamos.</p>
                <p class="rounded-xl border border-line bg-surface p-4 text-sm text-muted" data-aviso-archivos>
                  ¿Tienes fotografías, logotipos o documentos? En este formulario solo necesitamos la información inicial.
                  Después te indicaremos por correo cómo enviarnos los archivos que necesitemos. No hace falta tenerlo todo preparado ahora.
                  <strong class="text-ink">Nunca te pediremos que escribas contraseñas en este formulario.</strong>
                </p>
                {campos.map((c, i) => (
                  <label class={label}>
                    {c}
                    <textarea class={input} name={nombreCampo(i)} rows="2" maxlength={LIMITES.campo} />
                  </label>
                ))}
              </fieldset>
            )
          }

          <div class="space-y-6" data-paso={consulta ? 'Tu caso' : 'Enviar'}>
          <label class={label}>
            {consulta ? '¿Qué necesitas? *' : '¿Algo más que debamos saber?'}
            <textarea
              class={input}
              name="mensaje"
              rows={consulta ? 5 : 3}
              maxlength={LIMITES.mensaje}
              required={consulta}
              placeholder={consulta ? 'Por ejemplo: quiero organizar un cumpleaños y que los invitados confirmen si vienen, pero no sé qué necesito.' : 'Colores, ejemplos que te gusten, fechas…'}
            >{mensajeInicial}</textarea>
          </label>

          <label class="flex gap-3 text-sm text-muted">
            <input type="checkbox" name="consentimiento" value="si" required class="mt-1 h-4 w-4 accent-[var(--color-brand)]" />
            <span>
              Acepto que David Porto Díaz use estos datos solo para {pedido ? 'preparar mi pedido' : 'preparar mi vista previa'} y responderme.
              Más info en la <a href="/pages/privacidad" class="underline hover:text-brand">política de privacidad</a>. *
            </span>
          </label>

          <button
            type="submit"
            class="flex w-full items-center justify-center rounded-full bg-brand px-6 py-4 text-base font-semibold text-on-brand shadow-sm transition hover:bg-brand-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand disabled:opacity-60 sm:w-auto"
          >
            {pedido ? 'Enviar mis datos' : 'Enviar y recibir mi vista previa gratis'}
          </button>
          <p class="text-xs text-faint">{pedido ? 'No se cobra nada más al enviar.' : 'No pedimos tarjeta. No se cobra nada al enviar.'}</p>
          </div>

          <div class="hidden gap-3" data-pasos-nav>
            <button type="button" class="rounded-full border border-line px-5 py-3 text-sm font-semibold text-ink hover:border-brand" data-atras>&larr; Atrás</button>
            <button type="button" class="ml-auto rounded-full bg-brand px-6 py-3 text-sm font-semibold text-on-brand hover:bg-brand-hover" data-siguiente>Siguiente &rarr;</button>
          </div>
        </form>
      </div>

      <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start" aria-label="Resumen de tu solicitud">
        {
          producto && (
            <div class="rounded-2xl border border-line bg-surface p-5">
              <p class="text-xs uppercase tracking-widest text-faint">Servicio</p>
              <p class="mt-1 font-semibold text-ink">{producto.name}</p>
              <p class="mt-1 text-sm text-muted">
                {precioMontado ? (
                  <Fragment>Precio cerrado: <strong class="text-ink">{precioDe('Plantilla + guía')}</strong> la publicas tú · <strong class="text-ink">{precioDe('Te lo montamos')}</strong> te lo montamos.{pedido ? ' Pagado.' : ' Solo pagas si apruebas la vista previa.'}</Fragment>
                ) : (
                  <Fragment>Precio cerrado <strong class="text-ink">{formatPrice(producto.price_cents, producto.currency)}</strong>{pedido ? ' · Pagado.' : '. Solo si apruebas la vista previa.'}</Fragment>
                )}
              </p>
            </div>
          )
        }
        <div class="rounded-2xl bg-brand/5 p-5">
          <p class="font-semibold text-ink">Qué pasa después</p>
          <ol class="mt-3 space-y-3 text-sm text-muted">
            {pedido ? (
              <Fragment>
                <li><strong class="text-ink">1. Ya has pagado.</strong> No se cobra nada más.</li>
                <li><strong class="text-ink">2. Revisamos tus datos</strong> y te escribimos si falta algo.</li>
                <li><strong class="text-ink">3. Te enseñamos el resultado</strong> en 24-72 h laborables.</li>
                <li><strong class="text-ink">4. Lo entregamos tras tu aprobación,</strong> con una ronda de ajustes incluida.</li>
              </Fragment>
            ) : (
              <Fragment>
                <li><strong class="text-ink">1. Te escribimos</strong> para confirmar que lo hemos recibido.</li>
                <li><strong class="text-ink">2. Vista previa en 24-72 h</strong> laborables, con tus datos.</li>
                <li><strong class="text-ink">3. Si te gusta, pagas</strong> y lo recibes según la modalidad elegida.</li>
                <li><strong class="text-ink">4. Si no, no pagas nada.</strong> Sin letra pequeña.</li>
              </Fragment>
            )}
          </ol>
        </div>
        <div class="rounded-2xl border border-line p-5 text-sm text-muted">
          <p class="font-semibold text-ink">Un humano detrás</p>
          <p class="mt-1">Te atiende David Porto Díaz. Cualquier duda: <a href={`mailto:${CONTACT_EMAIL}`} class="underline hover:text-brand">{CONTACT_EMAIL}</a>.</p>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  import { PREFIJO, crearBorrador, guardable, leerBorrador } from '../../features/solicitudes/borrador';

  // Borrador local: lo escrito sobrevive a cerrar la pestaña o a un ?error= del servidor.
  document.querySelectorAll<HTMLFormElement>('form[data-solicitud]').forEach((f) => {
    const slug = f.querySelector<HTMLInputElement>('input[name=slug]')?.value;
    if (!slug) return;
    const clave = PREFIJO + slug;
    const campos = () =>
      [...f.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[name],textarea[name]')].filter((el) => guardable(el.name, el.type));
    let almacen: Storage | null = null;
    try {
      almacen = window.localStorage;
    } catch {
      return; // navegación privada estricta: sin borrador
    }
    const b = leerBorrador(almacen.getItem(clave), Date.now(), f.dataset.firma ?? '');
    if (b) {
      let usado = false;
      // Lo que el servidor rellenó desde la URL (?modalidad=pro) manda sobre lo guardado.
      const desdeUrl = new Set((f.dataset.desdeUrl ?? '').split(' ').filter(Boolean));
      for (const el of campos()) {
        const v = b.campos[el.name];
        if (v === undefined) continue;
        if (desdeUrl.has(el.name)) {
          // Misma búsqueda: el borrador continúa el texto que trae la URL y se recupera entero.
          // Otra búsqueda (u otra modalidad) manda la URL.
          const texto = el.type !== 'radio' && el.type !== 'checkbox';
          if (texto && el.value && v !== el.value && v.startsWith(el.value)) {
            el.value = v;
            usado = true;
          }
          continue;
        }
        if (el.type === 'radio' || el.type === 'checkbox') {
          if ((el as HTMLInputElement).value === v) {
            (el as HTMLInputElement).checked = true;
            usado = true;
          }
        } else if (!el.value) {
          el.value = v;
          usado = true;
        }
      }
      const aviso = f.querySelector<HTMLElement>('[data-borrador-aviso]');
      if (usado && aviso) {
        aviso.classList.replace('hidden', 'flex');
        aviso.querySelector('[data-borrador-borrar]')?.addEventListener('click', () => {
          almacen!.removeItem(clave);
          for (const el of campos()) if (el.type !== 'radio' && el.type !== 'checkbox') el.value = '';
          aviso.remove();
          // El formulario por pasos vuelve al primero (y lo enfoca); sin pasos, primer campo visible.
          if (!f.dispatchEvent(new CustomEvent('borrador:reinicio', { cancelable: true }))) return;
          f.querySelector<HTMLElement>('[data-paso] input:not([type=hidden]),[data-paso] textarea')?.focus();
        });
      }
    }
    let t: ReturnType<typeof setTimeout> | undefined;
    const guardar = () => {
      const datos: Record<string, string> = {};
      for (const el of campos()) {
        if ((el.type === 'radio' || el.type === 'checkbox') && !(el as HTMLInputElement).checked) continue;
        datos[el.name] = el.value;
      }
      const raw = crearBorrador(datos, Date.now(), f.dataset.firma ?? '');
      try {
        if (raw) almacen!.setItem(clave, raw);
        else almacen!.removeItem(clave);
      } catch {
        /* cuota llena: sin borrador */
      }
    };
    f.addEventListener('input', () => {
      clearTimeout(t);
      t = setTimeout(guardar, 400);
    });
    f.addEventListener('change', guardar);
  });

  // Evita envíos dobles (doble clic o red lenta).
  document.querySelectorAll<HTMLFormElement>('form[data-solicitud]').forEach((f) =>
    f.addEventListener('submit', () => {
      const b = f.querySelector<HTMLButtonElement>('button[type=submit]');
      if (b) {
        b.disabled = true;
        b.textContent = 'Enviando…';
      }
    }),
  );

  // Formulario por pasos (mejora progresiva): un bloque cada vez, barra de
  // progreso y validación del paso antes de avanzar. Sin JS, se ve todo junto.
  document.querySelectorAll<HTMLFormElement>('form[data-solicitud]').forEach((f) => {
    const pasos = [...f.querySelectorAll<HTMLElement>('[data-paso]')];
    const nav = f.querySelector<HTMLElement>('[data-pasos-nav]');
    const prog = f.querySelector<HTMLElement>('[data-progreso]');
    if (pasos.length < 2 || !nav || !prog) return;
    const atras = nav.querySelector<HTMLButtonElement>('[data-atras]')!;
    const sig = nav.querySelector<HTMLButtonElement>('[data-siguiente]')!;
    const barra = prog.querySelector<HTMLElement>('[data-progreso-barra]')!;
    const relleno = prog.querySelector<HTMLElement>('[data-progreso-relleno]')!;
    const texto = prog.querySelector<HTMLElement>('[data-progreso-texto]')!;
    const titulo = prog.querySelector<HTMLElement>('[data-progreso-titulo]')!;
    let actual = f.hasAttribute('data-error-ultimo') ? pasos.length - 1 : 0;

    const mostrar = (i: number, foco = false) => {
      actual = i;
      pasos.forEach((p, j) => (p.hidden = j !== i));
      const ultimo = i === pasos.length - 1;
      atras.style.visibility = i === 0 ? 'hidden' : 'visible';
      sig.hidden = ultimo;
      texto.textContent = `Paso ${i + 1} de ${pasos.length}`;
      titulo.textContent = pasos[i].dataset.paso ?? '';
      relleno.style.width = `${((i + 1) / pasos.length) * 100}%`;
      barra.setAttribute('aria-valuemax', String(pasos.length));
      barra.setAttribute('aria-valuenow', String(i + 1));
      if (foco) {
        prog.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        pasos[i].querySelector<HTMLElement>('input:not([type=hidden]),textarea')?.focus({ preventScroll: true });
      }
    };
    const valido = () => {
      for (const el of pasos[actual].querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input,textarea')) {
        if (!el.checkValidity()) {
          el.reportValidity();
          return false;
        }
      }
      return true;
    };
    const avanzar = () => {
      if (valido() && actual < pasos.length - 1) mostrar(actual + 1, true);
    };

    prog.classList.remove('hidden');
    nav.classList.replace('hidden', 'flex');
    sig.addEventListener('click', avanzar);
    f.addEventListener('borrador:reinicio', (e) => {
      e.preventDefault();
      mostrar(0, true);
    });
    atras.addEventListener('click', () => actual > 0 && mostrar(actual - 1, true));
    // Intro en un campo de texto avanza de paso en vez de intentar enviar.
    f.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (e.key === 'Enter' && t.tagName === 'INPUT' && actual < pasos.length - 1) {
        e.preventDefault();
        avanzar();
      }
    });
    mostrar(actual);
  });
</script>
