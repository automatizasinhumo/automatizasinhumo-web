---
import { CONTACT_EMAIL } from '../../contacto';
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { formatPrice, getConfig } from '../../config';
import { getOrderByPublicId, listOrderItems } from '../../features/orders/db';
import { orderNumber } from '../../features/orders/number';
import { isLegacyPublicId, publicIdToken } from '../../features/ids/publicId.ts';
import { isAccessToken } from '../../features/ids/token.ts';
import { resolveAccessToken } from '../../features/orders/guestAccess.ts';
import { clearCart } from '../../features/cart/cart';
import { catalogPath } from '../../features/settings/home';
import { PASOS_PEDIDO, pasoPedido, solicitudesDePedido, textoPedido } from '../../features/solicitudes';

// Guest access: new orders are addressed ONLY by their otk_ access token
// (resolved through the registry); legacy orders keep their pre-cutover
// public-id links. A bare ord_ public ID never grants access — same not-found
// as an unknown token.
const { token } = Astro.params;
let order = null;
if (token && isAccessToken(token)) {
  const access = await resolveAccessToken(env.DB, token);
  order = access ? await getOrderByPublicId(env.DB, access.order_public_id) : null;
} else if (token && isLegacyPublicId(token)) {
  order = await getOrderByPublicId(env.DB, token);
} else if (token) {
  return new Response('No encontrado', { status: 404 });
}

// This page carries a capability URL: never cache it, never leak it in referrers.
Astro.response.headers.set('cache-control', 'private, no-store');
Astro.response.headers.set('referrer-policy', 'no-referrer');

// The webhook creates the order asynchronously, so the customer can land here
// before it exists. If found, it's confirmed — clear the cart and show it.
// clearCart (not a raw delete) so the script-readable count cookie goes with it
// and the header badge can't survive the purchase.
if (order) clearCart(Astro.cookies);
const items = order ? await listOrderItems(env.DB, order.id) : [];
// Compra directa: tras pagar, el cliente nos manda sus datos por el formulario
// del servicio (/empezar/<slug>?pedido=<ref>), que queda unido a su pedido.
const servicios = order
  ? ((await env.DB.prepare(
      `SELECT p.slug, MIN(p.name) AS name FROM order_items oi JOIN products p ON p.id = oi.product_id WHERE oi.order_id = ? GROUP BY p.slug ORDER BY MIN(oi.id)`,
    ).bind(order.id).all<{ slug: string; name: string }>()).results ?? [])
  : [];
// Estado de cada servicio: sin solicitud = pendiente de datos; con ella, su progreso.
const enviadas = order?.public_id ? await solicitudesDePedido(env.DB, order.public_id).catch(() => new Map()) : new Map();
const estados = servicios.map((s) => {
  const sol = enviadas.get(s.slug) ?? null;
  return { ...s, sol, paso: pasoPedido(sol?.estado ?? null) };
});
const fecha = (iso: string) => new Date(iso.replace(' ', 'T') + (iso.endsWith('Z') ? '' : 'Z')).toLocaleDateString('es-ES', { day: 'numeric', month: 'long' });

// Customer reference: the ord_ token portion for new orders; legacy orders keep
// showing their previously communicated calculated number.
const orderRef = order
  ? (publicIdToken(order.public_id ?? '', 'order') ?? String(orderNumber(order.id, getConfig().orderNumber)))
  : null;

// Human label for the rail the order was paid on (NULL = legacy, hidden).
const PAYMENT_LABELS: Record<string, string> = {
  stripe: 'Tarjeta',
  lightning: 'Lightning',
  opennode: 'Bitcoin',
  demo: 'Demo (sin cobro)',
};
const paymentLabel = order?.payment_method ? PAYMENT_LABELS[order.payment_method] ?? null : null;
// The catalog is at / until the home page is pointed elsewhere.
const shopHref = catalogPath(Astro.locals.settings?.homePage);
---

<Layout title={order ? 'Pedido confirmado' : 'Confirmando tu pedido'}>
  {
    order ? (
      <Fragment>
        <h1 class="mb-2 font-serif text-3xl tracking-tight sm:text-4xl">¡Gracias! Tu pedido está confirmado.</h1>
        <p class="mb-6 text-sm text-muted">
          Pedido n.º {orderRef}
          {order.email && <Fragment> · te hemos enviado el recibo a {order.email}</Fragment>}
        </p>

        <div class="overflow-hidden rounded-lg border border-line bg-surface">
          <table class="w-full text-left text-sm">
            <thead class="bg-surface text-muted">
              <tr>
                <th class="px-4 py-2 font-medium">Servicio</th>
                <th class="px-4 py-2 font-medium">Cant.</th>
                <th class="px-4 py-2 font-medium">Total</th>
              </tr>
            </thead>
            <tbody>
              {items.map((it) => (
                <tr class="border-t border-line">
                  <td class="px-4 py-2">{it.name}</td>
                  <td class="px-4 py-2">{it.quantity}</td>
                  <td class="px-4 py-2">
                    {formatPrice(it.price_cents * it.quantity, order.currency)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-4 text-lg font-semibold">
          Total: {formatPrice(order.amount_total_cents, order.currency)}
        </p>
        {items.some((item) => item.file_key) && isAccessToken(token) && (
          <section class="mt-8 rounded-lg border border-line bg-surface p-5">
            <h2 class="font-serif text-2xl">Descargas</h2>
            <ul class="mt-3 space-y-3">
              {items.filter((item) => item.file_key && item.public_id).map((item) => (
                <li class="flex flex-wrap items-center justify-between gap-3">
                  <span>
                    <strong>{item.file_name ?? item.name}</strong>
                    {item.file_mime && <small class="ml-2 text-muted">{item.file_mime}</small>}
                    {item.file_size_bytes != null && (
                      <small class="ml-2 text-muted">{Math.ceil(item.file_size_bytes / 1024)} KB</small>
                    )}
                  </span>
                  {order.refunded_cents >= order.amount_total_cents ? (
                    <span class="text-sm text-muted">No disponible tras el reembolso</span>
                  ) : (
                    <a
                      href={`/order/${token}/download/${item.public_id}`}
                      class="boton boton-principal boton-compacto"
                    >Descargar</a>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}
        {paymentLabel && (
          <p class="mt-1 text-sm text-muted">Pagado con {paymentLabel}</p>
        )}
        {/* Amounts only — the internal note is for the merchant, not the buyer. */}
        {order.refunded_cents > 0 && (
          <p class="mt-2 text-sm text-muted">
            {order.refunded_cents >= order.amount_total_cents
              ? `Reembolsado: ${formatPrice(order.refunded_cents, order.currency)}.`
              : `Reembolsado: ${formatPrice(order.refunded_cents, order.currency)} · pagado: ${formatPrice(
                  order.amount_total_cents - order.refunded_cents,
                  order.currency,
                )}.`}
          </p>
        )}
        {estados.length > 0 && order.refunded_cents < order.amount_total_cents && (
          <section class="mt-8 space-y-4" data-estado-pedido>
            {estados.map((s) => (
              <div class={`rounded-2xl p-5 ${s.paso === 0 ? 'border-2 border-brand bg-brand/5' : 'border border-line bg-surface'}`} data-paso={s.paso}>
                <p class="text-xs font-semibold uppercase tracking-widest text-brand">
                  {estados.length > 1 && <Fragment>{s.name} · </Fragment>}
                  {s.paso >= 0 ? `Paso ${s.paso + 1} de 5 · ${PASOS_PEDIDO[s.paso]!.titulo}` : 'Cerrado'}
                </p>
                <ol class="mt-3 flex flex-wrap gap-1.5" aria-label="Progreso del pedido">
                  {PASOS_PEDIDO.map((p, i) => (
                    <li class={`rounded-full px-2.5 py-1 text-xs ${i === s.paso ? 'bg-brand font-semibold text-on-brand' : i < s.paso ? 'bg-brand/15 text-ink' : 'bg-line/60 text-faint'}`} aria-current={i === s.paso ? 'step' : undefined}>{p.titulo}</li>
                  ))}
                </ol>
                <p class="mt-3 font-medium text-ink">{textoPedido(s.sol?.estado ?? null)}</p>
                {s.paso === 0 ? (
                  <Fragment>
                    <p class="mt-1 text-sm text-muted">2-3 minutos: textos, contacto y, si quieres, fotos o logo. Lo que no tengas a mano te lo preguntamos.</p>
                    <a
                      href={`/empezar/${s.slug}?pedido=${encodeURIComponent(token ?? '')}`}
                      class="boton boton-principal mt-4"
                    >Enviar mis datos →</a>
                  </Fragment>
                ) : (
                  s.sol && (
                    <p class="mt-2 text-sm text-muted">
                      Último cambio: {fecha(s.sol.actualizada)} ·{' '}
                      <a href={`/empezar/estado?id=${s.sol.publicId}`} class="underline hover:text-brand">Seguimiento {s.sol.publicId}</a>
                    </p>
                  )
                )}
              </div>
            ))}
            <p class="text-xs text-faint">
              ¿Dudas o algo que añadir? Responde al correo del pedido o escribe a{' '}
              <a href={`mailto:${CONTACT_EMAIL}`} class="underline hover:text-brand">{CONTACT_EMAIL}</a>.
            </p>
          </section>
        )}
        <a href={shopHref} class="mt-6 inline-block text-accent hover:underline">
          &larr; Seguir mirando
        </a>
      </Fragment>
    ) : (
      <Fragment>
        {/* Order not recorded yet — poll until the webhook lands (no JS). */}
        <meta http-equiv="refresh" content="3" />
        <h1 class="mb-2 font-serif text-3xl tracking-tight sm:text-4xl">Confirmando tu pedido…</h1>
        <p class="text-muted">
          Tu pago se ha completado y estamos registrando el pedido. Esta página se actualiza sola; suele tardar unos segundos.
        </p>
      </Fragment>
    )
  }
</Layout>
